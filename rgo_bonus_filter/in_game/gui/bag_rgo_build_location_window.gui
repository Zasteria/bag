# Only the window, not the panel's widget types.
#
# Shipping a copy of vanilla's build_location_lateralview.gui carried vanilla's
# `types buildLocationTypes` with it, and Construction Manager and Glorp UI both
# restyle those same types from files of their own. Whichever loaded last won,
# which is how this mod was stripping the mass-build button of its icon. Redefining
# the window alone leaves every type to them.
lateralview = {
	name = "build_location_lateralview"

	# SOUND - Build Location (Left Panel)
	blockoverride "snd_panel_identifier" { soundeffect = "UI_panelAux_buildLocation_show" }

	blockoverride "lateralview_topbuttons_extra" {
		widget = {
			parentanchor = vcenter
			size = { 40 40 }
			position = { 30 0 }
			button_automation_shortcut = {
				parentanchor = vcenter
				size = { 25 25 }
				action_tooltip = {
					title = "OPEN_AUTOMATION_PANEL_FILTER"
					on_action = "[OpenLateralViewWithFilter('automation', 'automation_filter_production')]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }
			}
		}
	}

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "window_header_alt_color_texture"{
				using = color_production_texture
			}
			blockoverride "header_text_object" {
				hbox = {
					hbox = {
						spacing = 5
						icon = {
							size = { 30 30 }
							texture = "[GetBuildingIcon(BuildInLocationLateralView.GetBuildingType)]"
						}
						header_title = {
							layoutpolicy_horizontal = fixed
							layoutpolicy_vertical = fixed
							autoresize = yes
							maximumsize = { 420 -1 }
							text = "BUILD_LOCATION_TITLE"
						}
					}
				}
			}
		}
	}

	blockoverride "panel_content" {
		# RGO Bonus Filter: records which building type this panel is placing, so
		# the location filter can reach it. A location filter gets the location and
		# the country, never the chosen type, and BuildInLocationLateralView only
		# resolves inside this panel. Zero sized; it only writes a variable.
		widget = {
			size = { 0 0 }
			datacontext = "[GetPlayer]"
			datacontext = "[BuildInLocationLateralView.GetBuildingType]"
			visible = "[Country.IsValid]"

			state = {
				name = bag_rgo_capture_build_type
				trigger_when = "[Not(GetScriptedGui('bag_rgo_build_type_is_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('bag_rgo_type', BuildingType.MakeScope).End))]"
				on_start = "[GetScriptedGui('bag_rgo_store_build_type').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('bag_rgo_type', BuildingType.MakeScope).End)]"
			}
		}

		build_location_lateralview_panel_content = {}
	}
}

select_menu_left = {
	datacontext = "[GetQuickVisibleMarkets(Player.Self)]"
	blockoverride "menu_setup" {
		name = "build_location_select_market"
	}

	blockoverride "close_on_action" { on_action = "[BuildLocationSelectMarket.OnClose]" }
	blockoverride "select_content" {
		select_menu_header = {
			blockoverride "select_menu_header_extra" {
				button_checkbox_visibility = {
					size = { 32 32 }
					action_tooltip = {
						title = "TOGGLE_INRANGE_MARKETS"
						on_action = "[BuildLocationSelectMarket.Parent.Vars.Toggle( 'inrange_markets')]"
					}
					tooltipwidget = { BasicFunctionalTooltip = {} }
					down = "[BuildLocationSelectMarket.Parent.Vars.Exists( 'inrange_markets')]"
				}

				text_single = {
					using = Font_Type_Headers
					using = Font_Size_Small
					align = nobaseline
					text = "INRANGE_MARKETS"
				}
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10

			datamodel = "[QuickVisibleMarkets.GetVisibleMarkets]"
			item = {
				widget = {
					size = { 485 70 }
					visible = "[Or3(GreaterThan_CFixedPoint(Market.GetCountryPopulation(Player.Self),'(CFixedPoint)0'), GreaterThan_CFixedPoint(Market.GetTotalMerchantCapacity(Player.Self),'(CFixedPoint)0'), And(BuildLocationSelectMarket.Parent.Vars.Exists( 'inrange_markets'), IsMarketInRange(Market.Self)))]"
					
					hbox = {
						using = bg_market_card
						using = bg_cabinet_card_frame

						market_card = {
							blockoverride "market_card_title_action"{
								action_tooltip = {
									click_type = left
									click_mode = single
									title = "TOGGLE_MARKET_SELECTION"
									on_action = "[BuildLocationSelectMarket.Parent.FilterByMarket(Market.Self)]"
								}
			
								action_tooltip = {
									click_type = right
									click_mode = single
			
									cursor = "market_menu"
									title = "CLICK_ACTION_MARKET_CONTEXT_MENU"
									on_action = "[PdxGuiWidget.ToggleContextMenu]"
								}
			
								onmousehierarchyenter = "[PdxGuiWidget.SetHighlightMarket(Market.Self)]"
								ondoubleclick = "[PanToLocation(Market.GetCenterLocation)]"
							}
						}
					}
				}
			}
		}
	}
}
