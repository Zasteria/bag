# Общие типы обоих окон. Объявлены один раз и здесь: тип, объявленный в любом
# `.gui` мода, виден всем остальным, а полоса выбора земли обязана быть в обоих
# окнах одинаковой -- это один и тот же выбор.
#
# **Перед любой правкой в этом файле -- `docs/pitfalls/windows.md`.** Каждая
# строка того чек-листа кем-то оплачена, и половина -- этим модом в прошлой
# жизни.

types BagWtp2SharedTypes {

	# Подвал панели выбора: его рисует сама игра под списком, когда открыт
	# пикер. Место, где видно, сколько уже набрано, не закрывая панель.
	type bag_wtp2_select_footer = widget {
		size = { 420 72 }

		vbox = {
			margin = { 8 6 }
			spacing = 2
			layoutpolicy_horizontal = expanding

			text_single = {
				layoutpolicy_horizontal = expanding
				align = left|vcenter
				text = "bag_wtp2_ground_summary"
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 404 48 }
				text = "bag_wtp2_picker_hint"
			}
		}
	}

	# **Полоса выбора земли -- одна на оба окна.**
	#
	# Четыре кнопки-действия открывают целевой пикер игры (локация, провинция,
	# область, рынок), пятая берёт всю свою землю, шестая чистит выбор. Справа
	# -- сколько локаций набрано.
	#
	# **Ширина ряда: 6 x 116 + 240 = 935**, и окно, которое его несёт, обязано
	# быть шире на 40 и больше. Запас вычитается из коробки, а не прибавляется к
	# ряду -- проверка, повёрнутая не в ту сторону, пропускала переполнение шесть
	# сборок подряд (`tools/check_script.py`).
	type bag_wtp2_ground_row = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 8

		action_button_regular = {
			size = { 116 34 }
			title = "bag_wtp2_map_pick_area"
			description = "bag_wtp2_map_pick_area_desc"
			actor = "[Player]"
			left_action = { action_name = "bag_wtp2_select_area" }
			tooltip = "bag_wtp2_map_pick_area_desc"
			text_single = {
				size = { 108 30 }
				parentanchor = center
				autoresize = no
				maximumsize = { 108 30 }
				fontsize = 14
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp2_map_pick_area"
			}
		}

		action_button_regular = {
			size = { 116 34 }
			title = "bag_wtp2_map_pick_province"
			description = "bag_wtp2_map_pick_province_desc"
			actor = "[Player]"
			left_action = { action_name = "bag_wtp2_select_province" }
			tooltip = "bag_wtp2_map_pick_province_desc"
			text_single = {
				size = { 108 30 }
				parentanchor = center
				autoresize = no
				maximumsize = { 108 30 }
				fontsize = 14
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp2_map_pick_province"
			}
		}

		action_button_regular = {
			size = { 116 34 }
			title = "bag_wtp2_map_pick_location"
			description = "bag_wtp2_map_pick_location_desc"
			actor = "[Player]"
			left_action = { action_name = "bag_wtp2_select_location" }
			tooltip = "bag_wtp2_map_pick_location_desc"
			text_single = {
				size = { 108 30 }
				parentanchor = center
				autoresize = no
				maximumsize = { 108 30 }
				fontsize = 14
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp2_map_pick_location"
			}
		}

		action_button_regular = {
			size = { 116 34 }
			title = "bag_wtp2_map_pick_market"
			description = "bag_wtp2_map_pick_market_desc"
			actor = "[Player]"
			left_action = { action_name = "bag_wtp2_select_market" }
			tooltip = "bag_wtp2_map_pick_market_desc"
			text_single = {
				size = { 108 30 }
				parentanchor = center
				autoresize = no
				maximumsize = { 108 30 }
				fontsize = 14
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp2_map_pick_market"
			}
		}

		button_regular = {
			size = { 116 34 }
			tooltip = "bag_wtp2_pick_my_land_tt"
			text_single = {
				size = { 108 30 }
				parentanchor = center
				widgetanchor = center
				autoresize = no
				maximumsize = { 108 30 }
				fontsize = 14
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp2_pick_my_land"
			}
			onclick = "[GetScriptedGui('bag_wtp2_press_my_land').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}

		button_regular = {
			size = { 116 34 }
			tooltip = "bag_wtp2_clear_tt"
			text_single = {
				size = { 108 30 }
				parentanchor = center
				widgetanchor = center
				autoresize = no
				maximumsize = { 108 30 }
				fontsize = 14
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp2_clear"
			}
			onclick = "[GetScriptedGui('bag_wtp2_press_clear').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}

		widget = { layoutpolicy_horizontal = expanding size = { -1 34 } }

		text_single = {
			size = { 240 34 }
			autoresize = no
			maximumsize = { 240 34 }
			align = right|vcenter
			fontsize = 13
			fontsize_min = 10
			elide = right
			text = "bag_wtp2_ground_summary"
			tooltip = "bag_wtp2_ground_summary_tt"
		}
	}
}
