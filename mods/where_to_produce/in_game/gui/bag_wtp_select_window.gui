# The selection window: the ticked regions' provinces, each expandable into its
# locations, each location in or out of the plan.
#
# Modelled on Advanced Auto Build's `eu5ab_template_scope_window.gui`, which is
# the only working example of this shape in the tree. One thing is deliberately
# different, and it is the whole point: that window's datamodel is
# `Player.GetProvinces`, so it can only ever offer land you already own. This one
# reads a list script builds out of the ticked regions, so it offers ground you
# are planning to take.
#
# `Region.GetAreas` and `Area.GetProvinces` do not exist as interface promotes --
# `Country.GetProvinces` is the only province list the game hands out — which is
# why the list is built in script and read back with `GetGlobalList`.

types BagWtpSelectTypes {

	# Injected into the bottom of the game's own target picker, through
	# `bottom_widget` in the action's `select_trigger`. Advanced Auto Build puts a
	# hint line there; this puts the running count, so the panel says what the
	# clicking has actually done without closing it to go and look.
	type bag_wtp_select_footer = widget {
		size = { 420 72 }

		vbox = {
			margin = { 8 6 }
			spacing = 2
			layoutpolicy_horizontal = expanding

			text_single = {
				layoutpolicy_horizontal = expanding
				align = left|vcenter
				text = "bag_wtp_select_summary"
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 404 48 }
				text = "bag_wtp_picker_hint"
			}
		}
	}

	# One location. `bag_wtp_picked` is a variable on the location itself, so the
	# tick, the map colour and the ranking walk are all reading the same fact.
	type bag_wtp_select_location_entry = hbox {
		# Lakes, sea zones and impassables come with `GetLocations` and are not
		# ground anybody builds on. The parent has `ignoreinvisible`.
		visible = "[Location.IsPossibleToOwn]"
		layoutpolicy_horizontal = expanding
		size = { -1 32 }
		spacing = 0
		using = bg_number_container_bckg

		widget = {
			size = { 40 32 }
			icon = {
				size = { 20 20 }
				parentanchor = center
				widgetanchor = center
				texture = "[Location.GetRankIcon]"
				tooltipwidget = { using = location_simple_tooltip }
			}
		}

		text_single = {
			size = { 300 32 }
			autoresize = no
			maximumsize = { 300 32 }
			align = left|vcenter
			elide = right
			text = "[Location.GetName]"
		}

		widget = { layoutpolicy_horizontal = expanding size = { -1 32 } }

		button_regular = {
			size = { 150 26 }
			visible = "[Not(Location.MakeScope.GetVariable('bag_wtp_picked').IsSet)]"
			tooltip = "bag_wtp_add_location_tt"
			text_single = {
				size = { 142 22 }
				parentanchor = center
				widgetanchor = center
				autoresize = no
				maximumsize = { 142 22 }
				fontsize = 13
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp_add_location"
			}
			onclick = "[GetScriptedGui('bag_wtp_toggle_location').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
		}

		button_regular = {
			size = { 150 26 }
			visible = "[Location.MakeScope.GetVariable('bag_wtp_picked').IsSet]"
			tooltip = "bag_wtp_remove_location_tt"
			text_single = {
				size = { 142 22 }
				parentanchor = center
				widgetanchor = center
				autoresize = no
				maximumsize = { 142 22 }
				fontsize = 13
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp_remove_location"
			}
			onclick = "[GetScriptedGui('bag_wtp_toggle_location').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
		}

		widget = { size = { 12 32 } }
	}

	# One province: a header row that takes the whole province in or out, and the
	# locations underneath once it is expanded. Expansion is a variable on the
	# province's capital location, which is the trick Advanced Auto Build uses --
	# a location certainly holds a variable and is reachable from the province on
	# both sides.
	type bag_wtp_select_province_entry = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		spacing = 2

		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 34 }
			using = bg_paper_card

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 0

				widget = {
					size = { 40 34 }
					button_square_plus = {
						size = { 26 26 }
						parentanchor = center
						widgetanchor = center
						visible = "[Not(Province.GetCapital.MakeScope.GetVariable('bag_wtp_expanded').IsSet)]"
						tooltip = "bag_wtp_expand_tt"
						onclick = "[GetScriptedGui('bag_wtp_expand_province').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Province.GetCapital.MakeScope).End)]"
					}
					button_square_minus = {
						size = { 26 26 }
						parentanchor = center
						widgetanchor = center
						visible = "[Province.GetCapital.MakeScope.GetVariable('bag_wtp_expanded').IsSet]"
						tooltip = "bag_wtp_collapse_tt"
						onclick = "[GetScriptedGui('bag_wtp_collapse_province').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Province.GetCapital.MakeScope).End)]"
					}
				}

				text_single = {
					size = { 220 34 }
					autoresize = no
					maximumsize = { 220 34 }
					align = left|vcenter
					elide = right
					text = "[Province.GetCapital.GetArea.GetNameWithNoTooltip]"
				}

				text_single = { size = { 24 34 } autoresize = no align = center raw_text = "›" }

				text_single = {
					size = { -1 34 }
					layoutpolicy_horizontal = expanding
					autoresize = no
					align = left|vcenter
					elide = right
					text = "[Province.GetName]"
				}

				button_regular = {
					size = { 150 26 }
					parentanchor = vcenter
					tooltip = "bag_wtp_toggle_province_tt"
					text_single = {
						size = { 142 22 }
						parentanchor = center
						widgetanchor = center
						autoresize = no
						maximumsize = { 142 22 }
						fontsize = 13
						fontsize_min = 10
						align = center|nobaseline
						elide = right
						text = "bag_wtp_toggle_province"
					}
					onclick = "[GetScriptedGui('bag_wtp_toggle_province').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Province.GetCapital.MakeScope).End)]"
				}

				widget = { size = { 12 34 } }
			}
		}

		vbox = {
			visible = "[Province.GetCapital.MakeScope.GetVariable('bag_wtp_expanded').IsSet]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = preferred
			ignoreinvisible = yes
			margin_left = 20
			datamodel = "[Province.GetLocations]"
			item = { bag_wtp_select_location_entry = {} }
		}
	}
}


window = {
	name = "bag_wtp_select_window"
	datacontext = "[GetPlayer]"
	allow_outside = yes
	alwaystransparent = no
	parentanchor = center
	widgetanchor = center
	position = { 0 0 }
	movable = yes
	size = { 1100 700 }

	# A Mod Menu button is a script effect, and script cannot reach
	# `GetVariableSystem`. So the window watches a variable on the player instead,
	# which the button sets and the close button clears.
	visible = "[GetPlayer.MakeScope.GetVariable('bag_wtp_open').IsSet]"
	enabled = "[GetPlayer.MakeScope.GetVariable('bag_wtp_open').IsSet]"

	widget = {
		size = { 1100 700 }
		using = bg_window_default_alt
		allow_outside = yes

		widget = {
			parentanchor = right
			position = { -5 5 }
			size = { 40 40 }
			ui_direction_button_holder_right = {}
			button_close_alt = {
				blockoverride "close_on_action" {
					on_action = "[GetScriptedGui('bag_wtp_close_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}
		}

		vbox = {
			using = window_margin_alt

			window_header_alt = {
				blockoverride "header_text" { text = "bag_wtp_select_window_title" }
				blockoverride "window_header_alt_color_texture" { using = color_production_texture }
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				using = bg_secondary_inner_alt
				margin = { 12 12 }
				spacing = 6

				# Bounded, and deliberately: `autoresize` with no `maximumsize` lays a
				# long sentence out on one line, and `allow_outside` then draws it
				# past the window frame with every row stretched to match. The
				# results window was reported broken exactly that way.
				text_multi = {
					layoutpolicy_horizontal = expanding
					autoresize = yes
					maximumsize = { 1050 80 }
					align = center
					text = "bag_wtp_select_window_desc"
				}

				# The map picker. Each of these hands the game one of this mod's generic
				# actions, and the game answers with its own target panel: a searchable
				# list, the map highlighted, and a click on the map picking the same
				# thing a row does. The actions toggle, so clicking is cumulative and
				# there is nothing to save at the end.
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 8

					action_button = {
						size = { 220 36 }
						title = "bag_wtp_map_pick_area"
						description = "bag_wtp_map_pick_area_desc"
						actor = "[Player]"
						left_action = { action_name = "bag_wtp_select_area" }
						tooltip = "bag_wtp_map_pick_area_desc"
						using = bg_button_flavor_1
						text_single = {
							size = { 212 32 }
							parentanchor = center
							autoresize = no
							maximumsize = { 212 32 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_map_pick_area"
						}
					}

					action_button = {
						size = { 220 36 }
						title = "bag_wtp_map_pick_province"
						description = "bag_wtp_map_pick_province_desc"
						actor = "[Player]"
						left_action = { action_name = "bag_wtp_select_province" }
						tooltip = "bag_wtp_map_pick_province_desc"
						using = bg_button_flavor_1
						text_single = {
							size = { 212 32 }
							parentanchor = center
							autoresize = no
							maximumsize = { 212 32 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_map_pick_province"
						}
					}

					action_button = {
						size = { 220 36 }
						title = "bag_wtp_map_pick_location"
						description = "bag_wtp_map_pick_location_desc"
						actor = "[Player]"
						left_action = { action_name = "bag_wtp_select_location" }
						tooltip = "bag_wtp_map_pick_location_desc"
						using = bg_button_flavor_1
						text_single = {
							size = { 212 32 }
							parentanchor = center
							autoresize = no
							maximumsize = { 212 32 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_map_pick_location"
						}
					}

					expand = {}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 8

					text_single = {
						size = { -1 32 }
						layoutpolicy_horizontal = expanding
						align = left|vcenter
						text = "bag_wtp_select_summary"
					}

					button_regular = {
						size = { 200 34 }
						tooltip = "bag_wtp_pick_all_tt"
						text_single = {
							size = { 192 30 }
							parentanchor = center
							autoresize = no
							maximumsize = { 192 30 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_pick_all"
						}
						onclick = "[GetScriptedGui('bag_wtp_pick_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}

					button_regular = {
						size = { 200 34 }
						tooltip = "bag_wtp_clear_all_tt"
						text_single = {
							size = { 192 30 }
							parentanchor = center
							autoresize = no
							maximumsize = { 192 30 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_clear_all"
						}
						onclick = "[GetScriptedGui('bag_wtp_clear_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}

				scrollbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					blockoverride "scrollbox_content" {
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = preferred
							margin = { 10 8 }
							margin_right = 20
							spacing = 3
							ignoreinvisible = yes
							datamodel = "[GetGlobalList('bag_wtp_browse')]"
							# The datacontext goes on the type instance itself. Wrapping it in
							# a `widget` is what collapsed every row to zero height: a widget
							# does not size itself to its child, and only the one expanded
							# province had anything pushing it open.
							item = {
								bag_wtp_select_province_entry = {
									datacontext = "[Scope.GetProvince]"
								}
							}
						}
					}
				}
			}
		}
	}
}
