# The selection window: the ticked regions' provinces, each expandable into its
# locations, each location in or out of the plan.
#
# Modelled on Advanced Auto Build's `eu5ab_template_scope_window.gui`, which is
# the only working example of this shape in the tree. One thing is deliberately
# different, and it is the whole point: that window's datamodel is
# `Player.GetProvinces`, so it can only ever offer land you already own. This one
# reads a list script builds out of the ticked regions, so it offers ground you
# are planning to take.
#
# `Region.GetAreas` and `Area.GetProvinces` do not exist as interface promotes --
# `Country.GetProvinces` is the only province list the game hands out — which is
# why the list is built in script and read back with `GetGlobalList`.

types BagWtpSelectTypes {

	# Injected into the bottom of the game's own target picker, through
	# `bottom_widget` in the action's `select_trigger`. Advanced Auto Build puts a
	# hint line there; this puts the running count, so the panel says what the
	# clicking has actually done without closing it to go and look.
	type bag_wtp_select_footer = widget {
		size = { 420 72 }

		vbox = {
			margin = { 8 6 }
			spacing = 2
			layoutpolicy_horizontal = expanding

			text_single = {
				layoutpolicy_horizontal = expanding
				align = left|vcenter
				text = "bag_wtp_select_summary"
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 404 48 }
				text = "bag_wtp_picker_hint"
			}
		}
	}

	# One location. `bag_wtp_picked` is a variable on the location itself, so the
	# tick, the map colour and the ranking walk are all reading the same fact.
	# One location, in the tree's fourth column. Narrow: the column is 252 wide,
	# where this row used to have a window to itself. The list it repeats over is
	# already filtered to ownable ground, so no lake reaches it.
	type bag_wtp_select_location_entry = hbox {
		layoutpolicy_horizontal = expanding
		size = { -1 28 }
		spacing = 0
		using = bg_number_container_bckg
		onmousehierarchyenter = "[PdxGuiWidget.SetHighlightLocation(Location.Self)]"

		widget = {
			size = { 26 28 }
			icon = {
				size = { 18 18 }
				parentanchor = center
				widgetanchor = center
				texture = "[Location.GetRankIcon]"
				tooltipwidget = { using = location_simple_tooltip }
			}
		}

		text_single = {
			size = { 104 28 }
			autoresize = no
			maximumsize = { 104 28 }
			align = left|vcenter
			elide = right
			fontsize = 13
			text = "[Location.GetName]"
		}

		widget = {
			size = { 24 28 }
			visible = "[Location.HasRawMaterial]"
			icon = {
				size = { 18 18 }
				parentanchor = center
				widgetanchor = center
				texture = "[GetGoodsIcon(Location.GetRawMaterial)]"
				tooltip = "[Location.GetRawMaterial.GetName]"
			}
		}

		widget = { layoutpolicy_horizontal = expanding size = { -1 28 } }

		button_regular = {
			size = { 76 26 }
			visible = "[Not(Location.MakeScope.GetVariable('bag_wtp_picked').IsSet)]"
			tooltip = "bag_wtp_add_location_tt"
			text_single = {
				size = { 70 22 }
				parentanchor = center
				widgetanchor = center
				autoresize = no
				maximumsize = { 70 22 }
				fontsize = 13
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp_add_location"
			}
			onclick = "[GetScriptedGui('bag_wtp_toggle_location').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
		}

		button_regular = {
			size = { 76 26 }
			visible = "[Location.MakeScope.GetVariable('bag_wtp_picked').IsSet]"
			tooltip = "bag_wtp_remove_location_tt"
			text_single = {
				size = { 70 22 }
				parentanchor = center
				widgetanchor = center
				autoresize = no
				maximumsize = { 70 22 }
				fontsize = 13
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp_remove_location"
			}
			onclick = "[GetScriptedGui('bag_wtp_toggle_location').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
		}
	}

	# One column of the tree. The header names the level, the rows are whatever
	# the column was given. A column with nothing in it stays -- an empty frame
	# says "open something on the left" better than a gap does.
	type bag_wtp_tree_column = vbox {
		layoutpolicy_vertical = expanding
		size = { 252 -1 }
		spacing = 3

		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 24 }

			text_single = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				autoresize = no
				size = { 244 24 }
				align = left|vcenter
				elide = right
				fontsize = 14
				block "tree_column_header" { text = "bag_wtp_tree_regions_head" }
			}
		}

		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			blockoverride "scrollbox_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = preferred
					margin = { 6 6 }
					margin_right = 16
					spacing = 2
					ignoreinvisible = yes
					block "tree_column_rows" {}
				}
			}
		}
	}

	# The three geography rows are one shape three times: the name opens the next
	# column, the button takes or drops everything inside, and hovering either
	# hands the map the same geography the row stands for. `SetHighlight*` lives
	# on `PdxGuiWidget`, so this is the game's own highlight, not an imitation of
	# it.
	type bag_wtp_tree_region_entry = hbox {
		layoutpolicy_horizontal = expanding
		size = { -1 28 }
		spacing = 2
		onmousehierarchyenter = "[PdxGuiWidget.SetHighlightRegion(Region.Self)]"

		button_regular = {
			layoutpolicy_horizontal = expanding
			size = { -1 26 }
			tooltip = "bag_wtp_tree_open_tt"
			text_single = {
				parentanchor = center
				widgetanchor = center
				autoresize = no
				maximumsize = { 160 22 }
				size = { 160 22 }
				fontsize = 13
				fontsize_min = 10
				align = left|nobaseline
				elide = right
				raw_text = "[Region.GetNameWithNoTooltip]"
			}
			onclick = "[GetScriptedGui('bag_wtp_tree_open_region').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_region', Region.MakeScope).End)]"
		}

		button_regular = {
			size = { 46 26 }
			tooltip = "bag_wtp_tree_take_tt"
			text_single = {
				parentanchor = center
				widgetanchor = center
				autoresize = no
				maximumsize = { 42 22 }
				fontsize = 13
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp_tree_take"
			}
			onclick = "[GetScriptedGui('bag_wtp_tree_take_region').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_region', Region.MakeScope).End)]"
		}
	}

	type bag_wtp_tree_area_entry = hbox {
		layoutpolicy_horizontal = expanding
		size = { -1 28 }
		spacing = 2
		onmousehierarchyenter = "[PdxGuiWidget.SetHighlightArea(Area.Self)]"

		button_regular = {
			layoutpolicy_horizontal = expanding
			size = { -1 26 }
			tooltip = "bag_wtp_tree_open_tt"
			text_single = {
				parentanchor = center
				widgetanchor = center
				autoresize = no
				maximumsize = { 160 22 }
				size = { 160 22 }
				fontsize = 13
				fontsize_min = 10
				align = left|nobaseline
				elide = right
				raw_text = "[Area.GetNameWithNoTooltip]"
			}
			onclick = "[GetScriptedGui('bag_wtp_tree_open_area').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_area', Area.MakeScope).End)]"
		}

		button_regular = {
			size = { 46 26 }
			tooltip = "bag_wtp_tree_take_tt"
			text_single = {
				parentanchor = center
				widgetanchor = center
				autoresize = no
				maximumsize = { 42 22 }
				fontsize = 13
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp_tree_take"
			}
			onclick = "[GetScriptedGui('bag_wtp_tree_take_area').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_area', Area.MakeScope).End)]"
		}
	}

	type bag_wtp_tree_province_entry = hbox {
		layoutpolicy_horizontal = expanding
		size = { -1 28 }
		spacing = 2
		onmousehierarchyenter = "[PdxGuiWidget.SetHighlightProvince(Province.Self)]"

		button_regular = {
			layoutpolicy_horizontal = expanding
			size = { -1 26 }
			tooltip = "bag_wtp_tree_open_province_tt"
			text_single = {
				parentanchor = center
				widgetanchor = center
				autoresize = no
				maximumsize = { 160 22 }
				size = { 160 22 }
				fontsize = 13
				fontsize_min = 10
				align = left|nobaseline
				elide = right
				raw_text = "[Province.GetNameWithNoTooltip]"
			}
			onclick = "[GetScriptedGui('bag_wtp_tree_open_province').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_province', Province.MakeScope).End)]"
		}

		button_regular = {
			size = { 46 26 }
			tooltip = "bag_wtp_tree_take_tt"
			text_single = {
				parentanchor = center
				widgetanchor = center
				autoresize = no
				maximumsize = { 42 22 }
				fontsize = 13
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp_tree_take"
			}
			onclick = "[GetScriptedGui('bag_wtp_tree_take_province').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_province', Province.MakeScope).End)]"
		}
	}
}


window = {
	name = "bag_wtp_select_window"
	datacontext = "[GetPlayer]"
	allow_outside = yes
	alwaystransparent = no
	parentanchor = center
	widgetanchor = center
	position = { 0 0 }
	movable = yes
	size = { 1100 700 }

	# A Mod Menu button is a script effect, and script cannot reach
	# `GetVariableSystem`. So the window watches a variable on the player instead,
	# which the button sets and the close button clears.
	visible = "[GetPlayer.MakeScope.GetVariable('bag_wtp_open').IsSet]"
	enabled = "[GetPlayer.MakeScope.GetVariable('bag_wtp_open').IsSet]"

	widget = {
		size = { 1100 700 }
		using = bg_window_default_alt
		allow_outside = yes

		widget = {
			parentanchor = right
			position = { -5 5 }
			size = { 40 40 }
			ui_direction_button_holder_right = {}
			button_close_alt = {
				blockoverride "close_on_action" {
					on_action = "[GetScriptedGui('bag_wtp_close_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}
		}

		vbox = {
			using = window_margin_alt

			window_header_alt = {
				blockoverride "header_text" { text = "bag_wtp_select_window_title" }
				blockoverride "window_header_alt_color_texture" { using = color_production_texture }
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				using = bg_secondary_inner_alt
				margin = { 12 12 }
				spacing = 6

				# Bounded, and deliberately: `autoresize` with no `maximumsize` lays a
				# long sentence out on one line, and `allow_outside` then draws it
				# past the window frame with every row stretched to match. The
				# results window was reported broken exactly that way.
				text_multi = {
					layoutpolicy_horizontal = expanding
					autoresize = yes
					maximumsize = { 1050 80 }
					align = center
					text = "bag_wtp_select_window_desc"
				}

				# The map picker. Each of these hands the game one of this mod's generic
				# actions, and the game answers with its own target panel: a searchable
				# list, the map highlighted, and a click on the map picking the same
				# thing a row does. The actions toggle, so clicking is cumulative and
				# there is nothing to save at the end.
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 8

					action_button = {
						size = { 220 36 }
						title = "bag_wtp_map_pick_area"
						description = "bag_wtp_map_pick_area_desc"
						actor = "[Player]"
						left_action = { action_name = "bag_wtp_select_area" }
						tooltip = "bag_wtp_map_pick_area_desc"
						using = bg_button_flavor_1
						text_single = {
							size = { 212 32 }
							parentanchor = center
							autoresize = no
							maximumsize = { 212 32 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_map_pick_area"
						}
					}

					action_button = {
						size = { 220 36 }
						title = "bag_wtp_map_pick_province"
						description = "bag_wtp_map_pick_province_desc"
						actor = "[Player]"
						left_action = { action_name = "bag_wtp_select_province" }
						tooltip = "bag_wtp_map_pick_province_desc"
						using = bg_button_flavor_1
						text_single = {
							size = { 212 32 }
							parentanchor = center
							autoresize = no
							maximumsize = { 212 32 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_map_pick_province"
						}
					}

					action_button = {
						size = { 220 36 }
						title = "bag_wtp_map_pick_location"
						description = "bag_wtp_map_pick_location_desc"
						actor = "[Player]"
						left_action = { action_name = "bag_wtp_select_location" }
						tooltip = "bag_wtp_map_pick_location_desc"
						using = bg_button_flavor_1
						text_single = {
							size = { 212 32 }
							parentanchor = center
							autoresize = no
							maximumsize = { 212 32 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_map_pick_location"
						}
					}

					expand = {}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 8

					text_single = {
						size = { -1 32 }
						layoutpolicy_horizontal = expanding
						align = left|vcenter
						text = "bag_wtp_select_summary"
					}

					button_regular = {
						size = { 200 34 }
						tooltip = "bag_wtp_pick_all_tt"
						text_single = {
							size = { 192 30 }
							parentanchor = center
							autoresize = no
							maximumsize = { 192 30 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_pick_all"
						}
						onclick = "[GetScriptedGui('bag_wtp_pick_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}

					button_regular = {
						size = { 200 34 }
						tooltip = "bag_wtp_clear_all_tt"
						text_single = {
							size = { 192 30 }
							parentanchor = center
							autoresize = no
							maximumsize = { 192 30 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_clear_all"
						}
						onclick = "[GetScriptedGui('bag_wtp_clear_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}

				# The tree: region, area, province, location, one column each, the
				# next filled by opening a row in the one before it. Any row takes
				# or drops its whole geography in one press, and hovering one shows
				# it on the map -- `SetHighlight*` is on `PdxGuiWidget`, so it is
				# the game's own highlighting rather than an imitation.
				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 6

					bag_wtp_tree_column = {
						blockoverride "tree_column_header" { text = "bag_wtp_tree_regions_head" }
						blockoverride "tree_column_rows" {
							datamodel = "[GetGlobalList('bag_wtp_tree_regions')]"
							item = { bag_wtp_tree_region_entry = { datacontext = "[Scope.GetRegion]" } }
						}
					}

					bag_wtp_tree_column = {
						blockoverride "tree_column_header" { text = "bag_wtp_tree_areas_head" }
						blockoverride "tree_column_rows" {
							datamodel = "[GetGlobalList('bag_wtp_tree_areas')]"
							item = { bag_wtp_tree_area_entry = { datacontext = "[Scope.GetArea]" } }
						}
					}

					bag_wtp_tree_column = {
						blockoverride "tree_column_header" { text = "bag_wtp_tree_provinces_head" }
						blockoverride "tree_column_rows" {
							datamodel = "[GetGlobalList('bag_wtp_tree_provinces')]"
							item = { bag_wtp_tree_province_entry = { datacontext = "[Scope.GetProvince]" } }
						}
					}

					bag_wtp_tree_column = {
						blockoverride "tree_column_header" { text = "bag_wtp_tree_locations_head" }
						blockoverride "tree_column_rows" {
							datamodel = "[GetGlobalList('bag_wtp_tree_locations')]"
							item = { bag_wtp_select_location_entry = { datacontext = "[Scope.GetLocation]" } }
						}
					}
				}
			}
		}
	}
}
