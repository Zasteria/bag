# The results window: the ranked provinces, each one saying what would be built
# there, with which method, and out of which raw materials.
#
# Why not the CMM table it stands beside: a CMM list row is one localization key
# and nothing else. It cannot hold an icon per row without a global variable per
# slot, it cannot expand, and it stops at fifty. Everything the fifth run asked
# for -- the province rather than one of its locations, which of the building's
# methods won, and what the bonus is actually made of -- is a datamodel away
# here and a rewrite of CMF away there.
#
# Every row reads its own scope. `bag_wtp_fill_rows` parks the answer on the
# location itself -- `bag_wtp_bt`, `bag_wtp_pm`, and the `bag_wtp_goods` list --
# and `bag_wtp_results` is that location per province, in rank order.
#
# Shape and idiom follow `bag_wtp_select_window.gui`, which is in game and works:
# the item type carries its own `datacontext` (a wrapping `widget` collapses the
# row to zero height), and the window watches a variable on the player because a
# Mod Menu button is a script effect and script cannot reach `GetVariableSystem`.

types BagWtpResultTypes {

	# Injected into the bottom of the game's own target picker, through
	# `bottom_widget` in each action's `select_trigger`. It carries the running
	# count, so the panel says what the clicking has done without closing it to go
	# and look. It lived in the selection window until that window was deleted;
	# the three actions still name it.
	type bag_wtp_select_footer = widget {
		size = { 420 72 }

		vbox = {
			margin = { 8 6 }
			spacing = 2
			layoutpolicy_horizontal = expanding

			text_single = {
				layoutpolicy_horizontal = expanding
				align = left|vcenter
				text = "bag_wtp_select_summary"
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				maximumsize = { 404 48 }
				text = "bag_wtp_picker_hint"
			}
		}
	}

	# One raw material the province supplies to the winning method. These are the
	# bonus, item by item: the number is `10% * what is here / what the method
	# wants`, so an input missing from this row is the whole of the difference
	# between the number and the method's ceiling.
	# One raw material the province supplies to the winning method. A text icon
	# rather than an `icon` widget, because a text hugs its glyph and a widget in
	# an hbox does not: two of these sat a column apart at every size the icon
	# was given. `[Goods.GetIcon]` is the game's own idiom for it.
	#
	# The item sets `datacontext` to the goods and the type reads `Goods.`; a
	# scope list read as `Scope.GetGoods` from inside the type drew nothing at
	# all, while the count beside it, off the same list, was right.
	type bag_wtp_result_goods_entry = text_single {
		autoresize = yes
		fontsize = 16
		raw_text = "[Goods.GetIcon]"
		tooltip = "[Goods.GetName]"
	}

	# One location of the province, under the expanded row. All of them score the
	# same -- the game credits a raw material worked anywhere in the province --
	# so what is worth saying about each is what it works now and whether it is in
	# the plan.
	type bag_wtp_result_location_entry = hbox {
		# Lakes, sea zones and impassables are in `GetLocations` and are not ground
		# anybody builds on: they arrived as a screenful of «Ничья земля» under
		# every coastal province. The parent has `ignoreinvisible`, so a hidden row
		# takes no space.
		visible = "[Location.IsPossibleToOwn]"
		layoutpolicy_horizontal = expanding
		size = { -1 30 }
		spacing = 0
		using = bg_number_container_bckg

		widget = {
			size = { 36 30 }
			icon = {
				size = { 18 18 }
				parentanchor = center
				widgetanchor = center
				texture = "[Location.GetRankIcon]"
				tooltipwidget = { using = location_simple_tooltip }
			}
		}

		text_single = {
			size = { 240 30 }
			autoresize = no
			maximumsize = { 240 30 }
			align = left|vcenter
			elide = right
			text = "[Location.GetName]"
		}

		widget = {
			size = { 28 30 }
			visible = "[Location.HasRawMaterial]"
			icon = {
				size = { 22 22 }
				parentanchor = center
				widgetanchor = center
				texture = "[GetGoodsIcon(Location.GetRawMaterial)]"
				tooltip = "[Location.GetRawMaterial.GetName]"
			}
		}

		text_single = {
			size = { 200 30 }
			autoresize = no
			maximumsize = { 200 30 }
			align = left|vcenter
			elide = right
			visible = "[Location.HasRawMaterial]"
			text = "[Location.GetRawMaterial.GetName]"
		}

		widget = { layoutpolicy_horizontal = expanding size = { -1 30 } }

		# Whose it is today. A row is the whole province, so the locations under it
		# can belong to two or three countries -- that is the split the ranking
		# deliberately ignores, and this is where it is visible.
		hbox = {
			size = { 190 30 }
			spacing = 4
			visible = "[Location.HasOwner]"

			country_flag_mini = {
				datacontext = "[Location.GetOwner]"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				autoresize = no
				maximumsize = { 150 30 }
				align = left|vcenter
				elide = right
				fontsize = 13
				raw_text = "[Location.GetOwner.GetName]"
			}
		}

		text_single = {
			size = { 190 30 }
			autoresize = no
			maximumsize = { 190 30 }
			align = left|vcenter
			elide = right
			fontsize = 13
			visible = "[Not(Location.HasOwner)]"
			text = "bag_wtp_result_unowned"
		}

		# The same two effects the selection window's rows call, so a location
		# ticked here is ticked there, painted on the map, and inside the next
		# ranking -- one fact, one pair of writers.
		button_regular = {
			size = { 140 24 }
			visible = "[Not(Location.MakeScope.GetVariable('bag_wtp_picked').IsSet)]"
			tooltip = "bag_wtp_add_location_tt"
			text_single = {
				size = { 132 20 }
				parentanchor = center
				widgetanchor = center
				autoresize = no
				maximumsize = { 132 20 }
				fontsize = 13
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp_add_location"
			}
			onclick = "[GetScriptedGui('bag_wtp_toggle_location').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
		}

		button_regular = {
			size = { 140 24 }
			visible = "[Location.MakeScope.GetVariable('bag_wtp_picked').IsSet]"
			tooltip = "bag_wtp_remove_location_tt"
			text_single = {
				size = { 132 20 }
				parentanchor = center
				widgetanchor = center
				autoresize = no
				maximumsize = { 132 20 }
				fontsize = 13
				fontsize_min = 10
				align = center|nobaseline
				elide = right
				text = "bag_wtp_remove_location"
			}
			onclick = "[GetScriptedGui('bag_wtp_toggle_location').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
		}

		widget = { size = { 12 28 } }
	}

	# One province: the answer on one line, its locations under it once expanded.
	# The scope is the location the ranking picked, because that is what carries
	# the winning method and the goods; the province is one promote away.
	#
	# The row is a province *definition*: the whole province as the map draws it,
	# not the piece of it one country owns. The game splits a province by
	# ownership and names the pieces "Moldavian province Bessarabia" -- ranking
	# those separately would answer for half a province and would move the answer
	# on the day the halves join, which is the day this mod plans for.
	#
	# Expansion is a variable on the row's own location, which is unique per row.
	# One answer line: the bonus, the building and method, and the goods the bonus
	# is made of. Two of these make a province row -- the built-up answer and the
	# village one -- and each hides itself when its side found nothing.
	#
	# Written twice rather than once with a parameter: no `.gui` in the game or in
	# CMF contains a `$` at all, so a type takes no arguments here.
	#
	# Nothing in the goods part has a size. An hbox given more width than its
	# children spreads them across it, which is what put a column between two
	# icons; a text hugs its glyphs, and a goods icon is a text icon like any
	# other -- `[Goods.GetIcon]` is what vanilla writes in its own strings.
	type bag_wtp_result_answer = hbox {
		layoutpolicy_horizontal = expanding
		size = { -1 28 }
		spacing = 0
		visible = "[Or(Location.MakeScope.GetVariable('bag_wtp_bt').IsSet, Location.MakeScope.GetVariable('bag_wtp_end_bt').IsSet)]"

		text_single = {
			size = { 64 28 }
			autoresize = no
			maximumsize = { 64 28 }
			align = left|vcenter
			visible = "[Location.MakeScope.GetVariable('bag_wtp_bt').IsSet]"
			text = "bag_wtp_result_bonus_value"
			tooltip = "bag_wtp_result_bonus_tt"
		}

		# The second age of the same line, and it is drawn only where it has
		# something to say: `bag_wtp_end_bt` is written only when the method that
		# survives every advance is not the method winning today. An empty cell
		# here is the row saying "this province does not change".
		widget = { size = { 6 28 } }

		text_single = {
			size = { 74 28 }
			autoresize = no
			maximumsize = { 74 28 }
			align = left|vcenter
			fontsize = 13
			visible = "[Location.MakeScope.GetVariable('bag_wtp_end_bt').IsSet]"
			text = "bag_wtp_result_bonus_value_end"
			tooltip = "bag_wtp_result_end_tt"
		}

		# «По пути»: the best this ground ever feeds, whatever age it belongs to,
		# and the last age it can still be built in. It is the column that
		# decides between provinces whose endgame answer is the same 0.00% --
		# ten percent until the fifth age is a plan; nothing at all is not.
		widget = { size = { 6 28 } }

		text_single = {
			size = { 82 28 }
			autoresize = no
			maximumsize = { 82 28 }
			align = left|vcenter
			fontsize = 12
			fontsize_min = 9
			visible = "[Location.MakeScope.GetVariable('bag_wtp_mid_bt').IsSet]"
			text = "bag_wtp_result_mid_value"
			tooltip = "bag_wtp_result_mid_tt"
		}

		widget = { size = { 8 28 } }

		# The method the near column won with -- or, where there is no near
		# column, the one the far column did. Two texts rather than one because a
		# localization value cannot branch; `ignoreinvisible` is what keeps the
		# hidden one from holding the width open.
		#
		# «+ улучшение» is the second half of a pair: eight buildings run a base
		# method and an improvement at once, and the row's percentage and «×»
		# already count both.
		# **Fixed, not expanding.** An expanding column is as wide as whatever is
		# left, and what is left differs between the header and a row inside a
		# scrollbox -- by the scrollbar and the content margin. So every column
		# after it landed somewhere else in the two, and «Из чего» is where you
		# see it. The slack goes to a spacer at the far right, where nothing has
		# to line up against anything.
		# **A `widget` holds the column and the `hbox` inside only lays the two
		# texts out.** It was an `hbox` carrying `size = { 394 28 }`, and **a
		# declared size does not hold an `hbox`** — this file's own rule, paid
		# for twice already. With `ignoreinvisible = yes` and only the method
		# visible, that hbox measured 262 instead of 394, and every column after
		# it — «Из чего» and «Подходит» — sat 132 pixels left of its own header.
		# He reported it twice, 2026-09-06, and both times he was right.
		widget = {
			size = { 394 28 }

			hbox = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				spacing = 0
				ignoreinvisible = yes

				# **Fixed, not expanding.** `layoutpolicy_horizontal = expanding`
				# inside an hbox that has a size of its own leaves the child at zero
				# width, and a text at zero width elides to nothing: the twenty-fourth
				# run had rows whose building had no name and no «×», with only the
				# autoresized «+ улучшение» beside it to prove the row was there.
				text_single = {
					size = { 262 28 }
					autoresize = no
					maximumsize = { 262 28 }
					align = left|vcenter
					elide = right
					visible = "[And(Not(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet), Location.MakeScope.GetVariable('bag_wtp_bt').IsSet)]"
					text = "bag_wtp_result_method_value"
					tooltip = "bag_wtp_result_method_tt"
				}

				text_single = {
					size = { 132 28 }
					autoresize = no
					maximumsize = { 132 28 }
					align = left|vcenter
					elide = right
					fontsize = 12
					visible = "[And(And(Not(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet), Location.MakeScope.GetVariable('bag_wtp_bt').IsSet), Location.MakeScope.GetVariable('bag_wtp_pm2').IsSet)]"
					text = "bag_wtp_result_method2_value"
					tooltip = "bag_wtp_result_method_tt"
				}

				text_single = {
					size = { 262 28 }
					autoresize = no
					maximumsize = { 262 28 }
					align = left|vcenter
					elide = right
					visible = "[And(Location.MakeScope.GetVariable('bag_wtp_end_bt').IsSet, Or(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet, Not(Location.MakeScope.GetVariable('bag_wtp_bt').IsSet)))]"
					text = "bag_wtp_result_method_value_end"
					tooltip = "bag_wtp_result_end_tt"
				}

				text_single = {
					size = { 132 28 }
					autoresize = no
					maximumsize = { 132 28 }
					align = left|vcenter
					elide = right
					fontsize = 12
					visible = "[And(And(Location.MakeScope.GetVariable('bag_wtp_end_bt').IsSet, Or(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet, Not(Location.MakeScope.GetVariable('bag_wtp_bt').IsSet))), Location.MakeScope.GetVariable('bag_wtp_end_pm2').IsSet)]"
					text = "bag_wtp_result_method2_value_end"
					tooltip = "bag_wtp_result_end_tt"
				}
				
				# **The slack goes here, not between the children.** A box given
				# more room than its children need spreads the difference across
				# them: the count and the icons drifted apart until the icon sat
				# between two columns — «куда-то между столбцами воткнулась иконка
				# товара», 2026-09-06. An expanding child takes it all instead.
				widget = { layoutpolicy_horizontal = expanding size = { -1 28 } }
			}
		}

		# «Из чего», pinned to the left edge of its column.
		#
		# **A plain `widget`, not an hbox.** An hbox given a width spreads its
		# children across it, and with `ignoreinvisible` only one of these two is
		# ever a child -- so the icons sat centred in the column, half of it right
		# of the header on a row with one icon and further still on a row with
		# none, which is what the twenty-fifth run's screenshots show. A `widget`
		# puts its children where their anchor says and nowhere else, and an anchor
		# is allowed here precisely because the parent is not a layout.
		widget = {
			size = { 44 28 }
			alwaystransparent = no
			tooltip = "bag_wtp_result_goods_tt"

			text_single = {
				size = { 40 28 }
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				autoresize = no
				maximumsize = { 40 28 }
				align = left|vcenter
				fontsize = 13
				visible = "[And(Not(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet), Location.MakeScope.GetVariable('bag_wtp_bt').IsSet)]"
				text = "bag_wtp_result_goods_count"
			}

			text_single = {
				size = { 40 28 }
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				autoresize = no
				maximumsize = { 40 28 }
				align = left|vcenter
				fontsize = 13
				visible = "[And(Location.MakeScope.GetVariable('bag_wtp_end_bt').IsSet, Or(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet, Not(Location.MakeScope.GetVariable('bag_wtp_bt').IsSet)))]"
				text = "bag_wtp_result_goods_count_end"
			}
		}

		widget = { size = { 4 28 } }

		widget = {
			size = { 62 28 }
			alwaystransparent = no
			tooltip = "bag_wtp_result_goods_tt"

			hbox = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				visible = "[And(Not(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet), Location.MakeScope.GetVariable('bag_wtp_bt').IsSet)]"
				spacing = 1
				datamodel = "[Location.MakeScope.GetList('bag_wtp_goods')]"
				item = {
				bag_wtp_result_goods_entry = {
				datacontext = "[Scope.GetGoods]"
				}
				}
			}

			hbox = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				visible = "[And(Location.MakeScope.GetVariable('bag_wtp_end_bt').IsSet, Or(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet, Not(Location.MakeScope.GetVariable('bag_wtp_bt').IsSet)))]"
				spacing = 1
				datamodel = "[Location.MakeScope.GetList('bag_wtp_end_goods')]"
				item = {
				bag_wtp_result_goods_entry = {
				datacontext = "[Scope.GetGoods]"
				}
				}
			}
		}

		widget = { size = { 4 28 } }

		# How many of the province's locations can actually hold this building.
		# Every location scores the same -- the bonus is the whole province's --
		# but they do not all pass the game's «can this be built here»: Sauerland
		# has seven and one of them is flat, so a quarry answers for six.
		text_single = {
			size = { 44 28 }
			autoresize = no
			align = left|vcenter
			fontsize = 13
			text = "bag_wtp_result_fit_value"
			tooltip = "bag_wtp_result_fit_tt"
		}

		widget = { layoutpolicy_horizontal = expanding size = { -1 28 } }
	}

	type bag_wtp_result_answer_rural = hbox {
		layoutpolicy_horizontal = expanding
		size = { -1 28 }
		spacing = 0
		visible = "[Or(Location.MakeScope.GetVariable('bag_wtp_bt_rural').IsSet, Location.MakeScope.GetVariable('bag_wtp_end_bt_rural').IsSet)]"

		text_single = {
			size = { 64 28 }
			autoresize = no
			maximumsize = { 64 28 }
			align = left|vcenter
			visible = "[Location.MakeScope.GetVariable('bag_wtp_bt_rural').IsSet]"
			text = "bag_wtp_result_bonus_value_rural"
			tooltip = "bag_wtp_result_bonus_tt"
		}

		# The second age of the same line, and it is drawn only where it has
		# something to say: `bag_wtp_end_bt` is written only when the method that
		# survives every advance is not the method winning today. An empty cell
		# here is the row saying "this province does not change".
		widget = { size = { 6 28 } }

		text_single = {
			size = { 74 28 }
			autoresize = no
			maximumsize = { 74 28 }
			align = left|vcenter
			fontsize = 13
			visible = "[Location.MakeScope.GetVariable('bag_wtp_end_bt_rural').IsSet]"
			text = "bag_wtp_result_bonus_value_end_rural"
			tooltip = "bag_wtp_result_end_tt_rural"
		}

		# «По пути»: the best this ground ever feeds, whatever age it belongs to,
		# and the last age it can still be built in. It is the column that
		# decides between provinces whose endgame answer is the same 0.00% --
		# ten percent until the fifth age is a plan; nothing at all is not.
		widget = { size = { 6 28 } }

		text_single = {
			size = { 82 28 }
			autoresize = no
			maximumsize = { 82 28 }
			align = left|vcenter
			fontsize = 12
			fontsize_min = 9
			visible = "[Location.MakeScope.GetVariable('bag_wtp_mid_bt_rural').IsSet]"
			text = "bag_wtp_result_mid_value_rural"
			tooltip = "bag_wtp_result_mid_tt_rural"
		}

		widget = { size = { 8 28 } }

		# The method the near column won with -- or, where there is no near
		# column, the one the far column did. Two texts rather than one because a
		# localization value cannot branch; `ignoreinvisible` is what keeps the
		# hidden one from holding the width open.
		#
		# «+ улучшение» is the second half of a pair: eight buildings run a base
		# method and an improvement at once, and the row's percentage and «×»
		# already count both.
		# **Fixed, not expanding.** An expanding column is as wide as whatever is
		# left, and what is left differs between the header and a row inside a
		# scrollbox -- by the scrollbar and the content margin. So every column
		# after it landed somewhere else in the two, and «Из чего» is where you
		# see it. The slack goes to a spacer at the far right, where nothing has
		# to line up against anything.
		# The same as above: a `widget` for the column, an `hbox` for the layout.
		widget = {
			size = { 394 28 }

			hbox = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				spacing = 0
				ignoreinvisible = yes

				# **Fixed, not expanding.** `layoutpolicy_horizontal = expanding`
				# inside an hbox that has a size of its own leaves the child at zero
				# width, and a text at zero width elides to nothing: the twenty-fourth
				# run had rows whose building had no name and no «×», with only the
				# autoresized «+ улучшение» beside it to prove the row was there.
				text_single = {
					size = { 262 28 }
					autoresize = no
					maximumsize = { 262 28 }
					align = left|vcenter
					elide = right
					visible = "[And(Not(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet), Location.MakeScope.GetVariable('bag_wtp_bt_rural').IsSet)]"
					text = "bag_wtp_result_method_value_rural"
					tooltip = "bag_wtp_result_method_tt"
				}

				text_single = {
					size = { 132 28 }
					autoresize = no
					maximumsize = { 132 28 }
					align = left|vcenter
					elide = right
					fontsize = 12
					visible = "[And(And(Not(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet), Location.MakeScope.GetVariable('bag_wtp_bt_rural').IsSet), Location.MakeScope.GetVariable('bag_wtp_pm2_rural').IsSet)]"  # check-script: never set — no two-part method may stand in a rural settlement (all eight are town and above), so this half of the row is always hidden, which is correct
					text = "bag_wtp_result_method2_value_rural"
					tooltip = "bag_wtp_result_method_tt"
				}

				text_single = {
					size = { 262 28 }
					autoresize = no
					maximumsize = { 262 28 }
					align = left|vcenter
					elide = right
					visible = "[And(Location.MakeScope.GetVariable('bag_wtp_end_bt_rural').IsSet, Or(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet, Not(Location.MakeScope.GetVariable('bag_wtp_bt_rural').IsSet)))]"
					text = "bag_wtp_result_method_value_end_rural"
					tooltip = "bag_wtp_result_end_tt_rural"
				}

				text_single = {
					size = { 132 28 }
					autoresize = no
					maximumsize = { 132 28 }
					align = left|vcenter
					elide = right
					fontsize = 12
					visible = "[And(And(Location.MakeScope.GetVariable('bag_wtp_end_bt_rural').IsSet, Or(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet, Not(Location.MakeScope.GetVariable('bag_wtp_bt_rural').IsSet))), Location.MakeScope.GetVariable('bag_wtp_end_pm2_rural').IsSet)]"  # check-script: never set — no two-part method may stand in a rural settlement (all eight are town and above), so this half of the row is always hidden, which is correct
					text = "bag_wtp_result_method2_value_end_rural"
					tooltip = "bag_wtp_result_end_tt_rural"
				}
				
				# **The slack goes here, not between the children.** A box given
				# more room than its children need spreads the difference across
				# them: the count and the icons drifted apart until the icon sat
				# between two columns — «куда-то между столбцами воткнулась иконка
				# товара», 2026-09-06. An expanding child takes it all instead.
				widget = { layoutpolicy_horizontal = expanding size = { -1 28 } }
			}
		}

		# «Из чего», pinned to the left edge of its column.
		#
		# **A plain `widget`, not an hbox.** An hbox given a width spreads its
		# children across it, and with `ignoreinvisible` only one of these two is
		# ever a child -- so the icons sat centred in the column, half of it right
		# of the header on a row with one icon and further still on a row with
		# none, which is what the twenty-fifth run's screenshots show. A `widget`
		# puts its children where their anchor says and nowhere else, and an anchor
		# is allowed here precisely because the parent is not a layout.
		widget = {
			size = { 44 28 }
			alwaystransparent = no
			tooltip = "bag_wtp_result_goods_tt"

			text_single = {
				size = { 40 28 }
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				autoresize = no
				maximumsize = { 40 28 }
				align = left|vcenter
				fontsize = 13
				visible = "[And(Not(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet), Location.MakeScope.GetVariable('bag_wtp_bt_rural').IsSet)]"
				text = "bag_wtp_result_goods_count_rural"
			}

			text_single = {
				size = { 40 28 }
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				autoresize = no
				maximumsize = { 40 28 }
				align = left|vcenter
				fontsize = 13
				visible = "[And(Location.MakeScope.GetVariable('bag_wtp_end_bt_rural').IsSet, Or(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet, Not(Location.MakeScope.GetVariable('bag_wtp_bt_rural').IsSet)))]"
				text = "bag_wtp_result_goods_count_end_rural"
			}
		}

		widget = { size = { 4 28 } }

		widget = {
			size = { 62 28 }
			alwaystransparent = no
			tooltip = "bag_wtp_result_goods_tt"

			hbox = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				visible = "[And(Not(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet), Location.MakeScope.GetVariable('bag_wtp_bt_rural').IsSet)]"
				spacing = 1
				datamodel = "[Location.MakeScope.GetList('bag_wtp_goods_rural')]"
				item = {
				bag_wtp_result_goods_entry = {
				datacontext = "[Scope.GetGoods]"
				}
				}
			}

			hbox = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				visible = "[And(Location.MakeScope.GetVariable('bag_wtp_end_bt_rural').IsSet, Or(Location.MakeScope.GetVariable('bag_wtp_row_end').IsSet, Not(Location.MakeScope.GetVariable('bag_wtp_bt_rural').IsSet)))]"
				spacing = 1
				datamodel = "[Location.MakeScope.GetList('bag_wtp_end_goods_rural')]"
				item = {
				bag_wtp_result_goods_entry = {
				datacontext = "[Scope.GetGoods]"
				}
				}
			}
		}

		widget = { size = { 4 28 } }
		widget = { layoutpolicy_horizontal = expanding size = { -1 28 } }
	}

	# One province: what would be built there, in one line or two, and its
	# locations under it once expanded.
	#
	# The scope is the location the ranking picked, because that is what carries
	# the winning methods and the goods; the province is one promote away.
	#
	# The row is a province *definition*: the whole province as the map draws it,
	# not the piece of it one country owns.
	#
	# Expansion is a variable on the row's own location, which is unique per row.
	type bag_wtp_result_province_entry = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = preferred
		spacing = 2

		# 60 tall, always: a `widget` does not size itself to its child, so the
		# card and everything in it collapsed into one another the moment the row
		# grew a second line. Two answer lines at 28 fit; one leaves a gap, which
		# is cheaper than rows that overlap.
		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 60 }
			using = bg_paper_card

			hbox = {
				layoutpolicy_horizontal = expanding
				size = { -1 60 }
				spacing = 0

				widget = {
					size = { 38 60 }
					button_square_plus = {
						size = { 26 26 }
						parentanchor = center
						widgetanchor = center
						visible = "[Not(Location.MakeScope.GetVariable('bag_wtp_res_expanded').IsSet)]"
						tooltip = "bag_wtp_result_expand_tt"
						onclick = "[GetScriptedGui('bag_wtp_result_expand').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
					}
					button_square_minus = {
						size = { 26 26 }
						parentanchor = center
						widgetanchor = center
						visible = "[Location.MakeScope.GetVariable('bag_wtp_res_expanded').IsSet]"
						tooltip = "bag_wtp_result_collapse_tt"
						onclick = "[GetScriptedGui('bag_wtp_result_collapse').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_location', Location.MakeScope).End)]"
					}
				}

				# The place the ranking gave this row, printed rather than implied.
				# The order a row sits in is the order the datamodel's list holds
				# it, and a list copied with an unordered iterator came out in map
				# order; with the number on the row, a shuffle is visible instead
				# of being mistaken for a ranking nobody understands.
				text_single = {
					size = { 34 60 }
					autoresize = no
					maximumsize = { 34 60 }
					align = left|vcenter
					fontsize = 13
					text = "bag_wtp_result_rank_value"
					tooltip = "bag_wtp_result_rank_tt"
				}

				text_single = {
					size = { 160 60 }
					autoresize = no
					maximumsize = { 160 60 }
					align = left|vcenter
					elide = right
					text = "[Location.GetProvinceDefinition.GetName]"
					tooltip = "bag_wtp_result_province_tt"
				}

				# A gap of its own after each name, because `elide` fills the
				# column to the last pixel and then abuts the next one: «Восточная
				# Мунтения» ran into «Валахия» and «Трансильвания» into the
				# percentage. Width alone cannot fix that -- there is always a
				# longer name -- so the separation is a spacer, and the header
				# carries the same two.
				widget = { size = { 8 60 } }

				text_single = {
					size = { 104 60 }
					autoresize = no
					maximumsize = { 104 60 }
					align = left|vcenter
					elide = right
					fontsize = 13
					text = "[Location.GetArea.GetNameWithNoTooltip]"
				}

				widget = { size = { 8 60 } }

				# The two answers, one under the other. The built-up one first: it
				# is what the ranking sorted on, and a village produces a fifth of
				# what a workshop does.
				vbox = {
					layoutpolicy_horizontal = expanding
					size = { -1 60 }
					spacing = 2
					ignoreinvisible = yes

					bag_wtp_result_answer = {}
					bag_wtp_result_answer_rural = {}
				}
			}
		}

		vbox = {
			visible = "[Location.MakeScope.GetVariable('bag_wtp_res_expanded').IsSet]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = preferred
			ignoreinvisible = yes
			margin_left = 20
			datamodel = "[Location.GetProvinceDefinition.GetLocations]"
			item = { bag_wtp_result_location_entry = {} }
		}
	}
}


window = {
	name = "bag_wtp_result_window"
	datacontext = "[GetPlayer]"
	allow_outside = yes
	alwaystransparent = no
	parentanchor = center
	widgetanchor = center
	position = { 0 0 }
	movable = yes
	size = { 1320 900 }

	visible = "[GetPlayer.MakeScope.GetVariable('bag_wtp_result_open').IsSet]"
	enabled = "[GetPlayer.MakeScope.GetVariable('bag_wtp_result_open').IsSet]"

	widget = {
		size = { 1320 900 }
		using = bg_window_default_alt
		allow_outside = yes

		widget = {
			parentanchor = right
			position = { -5 5 }
			size = { 40 40 }
			ui_direction_button_holder_right = {}
			button_close_alt = {
				blockoverride "close_on_action" {
					on_action = "[GetScriptedGui('bag_wtp_close_result_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}
		}

		vbox = {
			using = window_margin_alt

			window_header_alt = {
				blockoverride "header_text" { text = "bag_wtp_result_window_title" }
				blockoverride "window_header_alt_color_texture" { using = color_production_texture }
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				using = bg_secondary_inner_alt
				margin = { 12 12 }
				spacing = 6


				# The borders, picked here rather than in a window of their own. Each
				# button hands the game one of this mod's generic actions and the
				# game answers with its own target panel: a searchable list, the map
				# highlighted, and a click on the map picking the same thing a row
				# does. The actions toggle, so clicking is cumulative -- and every
				# pick re-ranks, so the table under these buttons is the answer for
				# the borders as they stand.
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 8

					action_button_regular = {
						size = { 138 34 }
						title = "bag_wtp_map_pick_area"
						description = "bag_wtp_map_pick_area_desc"
						actor = "[Player]"
						left_action = { action_name = "bag_wtp_select_area" }
						tooltip = "bag_wtp_map_pick_area_desc"
						text_single = {
							size = { 130 30 }
							parentanchor = center
							autoresize = no
							maximumsize = { 130 30 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_map_pick_area"
						}
					}

					action_button_regular = {
						size = { 138 34 }
						title = "bag_wtp_map_pick_province"
						description = "bag_wtp_map_pick_province_desc"
						actor = "[Player]"
						left_action = { action_name = "bag_wtp_select_province" }
						tooltip = "bag_wtp_map_pick_province_desc"
						text_single = {
							size = { 130 30 }
							parentanchor = center
							autoresize = no
							maximumsize = { 130 30 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_map_pick_province"
						}
					}

					action_button_regular = {
						size = { 138 34 }
						title = "bag_wtp_map_pick_location"
						description = "bag_wtp_map_pick_location_desc"
						actor = "[Player]"
						left_action = { action_name = "bag_wtp_select_location" }
						tooltip = "bag_wtp_map_pick_location_desc"
						text_single = {
							size = { 130 30 }
							parentanchor = center
							autoresize = no
							maximumsize = { 130 30 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_map_pick_location"
						}
					}

					action_button_regular = {
						size = { 138 34 }
						title = "bag_wtp_map_pick_market"
						description = "bag_wtp_map_pick_market_desc"
						actor = "[Player]"
						left_action = { action_name = "bag_wtp_select_market" }
						tooltip = "bag_wtp_map_pick_market_desc"
						text_single = {
							size = { 130 30 }
							parentanchor = center
							autoresize = no
							maximumsize = { 130 30 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_map_pick_market"
						}
					}

					# **«Выбрать мою землю» — his ask, 2026-09-06**, in the place of
					# the «только там, где здание может стоять» tick, which named
					# one thing and did another. This one says what it does: every
					# location the country owns, added to the selection. It is a
					# plain button and not a map action, because there is nothing
					# to click on the map — the answer is already known.
					button_regular = {
						size = { 138 34 }
						tooltip = "bag_wtp_pick_my_land_tt"
						text_single = {
							size = { 130 30 }
							parentanchor = center
							widgetanchor = center
							autoresize = no
							maximumsize = { 130 30 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_pick_my_land"
						}
						onclick = "[GetScriptedGui('bag_wtp_pick_my_land').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}

					widget = { layoutpolicy_horizontal = expanding size = { -1 34 } }

					# Two lines, and the lower one is a diagnostic on purpose: it
					# says how many locations the last pass walked, how many rows it
					# found, and how many times a pick has re-ranked since the game
					# loaded. A pick that does not move the third number never
					# reached the country's scope at all -- which is a failure that
					# writes nothing anywhere else.
					# 260, which is what the one line it replaces was: the four
					# buttons, this and «Очистить» fill the row to within sixteen
					# pixels, and a widget wider than the row it is in pushes the
					# rest out of the window rather than wrapping. That is why the
					# market button cost the other three 46 pixels each rather than
					# being added beside them.
					vbox = {
						size = { 260 34 }
						spacing = 0

						text_single = {
							size = { 260 17 }
							autoresize = no
							maximumsize = { 260 17 }
							align = right|vcenter
							fontsize = 13
							fontsize_min = 10
							elide = right
							text = "bag_wtp_select_summary"
						}

						text_single = {
							size = { 260 17 }
							autoresize = no
							maximumsize = { 260 17 }
							align = right|vcenter
							fontsize = 12
							fontsize_min = 9
							elide = right
							text = "bag_wtp_result_pass_summary"
							tooltip = "bag_wtp_result_pass_tt"
						}
					}

					button_regular = {
						size = { 150 30 }
						tooltip = "bag_wtp_clear_all_tt"
						text_single = {
							size = { 142 26 }
							parentanchor = center
							widgetanchor = center
							autoresize = no
							maximumsize = { 142 26 }
							fontsize = 13
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_clear_all"
						}
						onclick = "[GetScriptedGui('bag_wtp_clear_all').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}

				# ---- what to rank: one good, or one urban right ------------
				#
				# **This was the «Товар» tab of the mod's own settings page until
				# 2026-09-06**, four CMM lists of it: «просто добавишь в окно
				# расчёта иконки товаров и прав как ты это сделал в редакторе и
				# поставишь каждому кружочек для активации нужного, далее кнопку
				# искать локации, всё».
				#
				# **Both ranking windows draw the same rows**, declared once in
				# `bag_wtp_pick_cells.gui`, so the two can never come to offer
				# different goods -- and a press in either lands in the other,
				# because choosing a right is choosing the other window.
				#
				# **Each block is a `vbox` pinned to the top of a plain `widget`.**
				# An hbox centres its children on one another, so the shorter
				# block's heading sat above the taller one's and the two titles
				# were on different lines — he reported exactly that, 2026-09-06.
				# A fixed box with a top anchor holds both headings on one line
				# whatever the blocks weigh.
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 8

					widget = {
						size = { 746 236 }

						vbox = {
							parentanchor = top|left
							widgetanchor = top|left
							spacing = 2

							text_single = {
								size = { 746 20 }
								autoresize = no
								maximumsize = { 746 20 }
								align = left|vcenter
								fontsize = 13
								elide = right
								text = "bag_wtp_pick_goods_head"
								tooltip = "bag_wtp_pick_goods_tt"
							}

							bag_wtp_pick_row1 = {}
							bag_wtp_pick_row2 = {}
							bag_wtp_pick_row3 = {}
							bag_wtp_pick_row4 = {}
							bag_wtp_pick_row5 = {}

							# The slack goes here, not between the rows.
							widget = { layoutpolicy_vertical = expanding size = { 746 -1 } }
						}
					}

					widget = {
						size = { 504 236 }

						vbox = {
							parentanchor = top|left
							widgetanchor = top|left
							spacing = 2

							text_single = {
								size = { 504 20 }
								autoresize = no
								maximumsize = { 504 20 }
								align = left|vcenter
								fontsize = 13
								elide = right
								text = "bag_wtp_pick_rights_head"
								tooltip = "bag_wtp_pick_rights_tt"
							}

							# **Two columns, each packing upward and each pinned to
							# the top.** An `hbox` centres its children on one
							# another, so a column of three sat a row and a half
							# below a column of six — «во втором столбце прав
							# пропуск в 1 строке, вместо например 2 пропусков в
							# конце», 2026-09-06. A plain `widget` of a fixed
							# height with the column anchored top is what puts
							# every gap at the bottom, where he wants them.
							hbox = {
								spacing = 4

								widget = {
									size = { 250 210 }
									bag_wtp_pick_right_col1 = {
										parentanchor = top|left
										widgetanchor = top|left
									}
								}

								widget = {
									size = { 250 210 }
									bag_wtp_pick_right_col2 = {
										parentanchor = top|left
										widgetanchor = top|left
									}
								}
							}

							# The slack goes here, not between the blocks.
							widget = { layoutpolicy_vertical = expanding size = { 504 -1 } }
						}
					}

					widget = { layoutpolicy_horizontal = expanding size = { -1 20 } }
				}

				# ---- how to rank it, and the press that does ----------------
				#
				# **The switch does not re-rank by itself.** It did for one
				# build, and his verdict was that it should not: «снимаю галочку
				# — жму пересчитать — получаю результат… я считаю так и должно
				# быть». So this only decides what the next «Искать локации»
				# answers, exactly like the plan window's twin.
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 8

					widget = {
						size = { 28 34 }
						checkbutton_round_alt = {
							size = { 24 24 }
							parentanchor = center
							widgetanchor = center
							down = "[GetGlobalVariable('bag_wtp_rank_by_end').IsSet]"
							tooltip = "bag_wtp_search_by_end_tt"
							onclick = "[GetScriptedGui('bag_wtp_toggle_by_end').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}

					text_single = {
						size = { 210 34 }
						autoresize = no
						maximumsize = { 210 34 }
						align = left|vcenter
						fontsize = 13
						fontsize_min = 10
						elide = right
						text = "bag_wtp_search_by_end"
						tooltip = "bag_wtp_search_by_end_tt"
					}

					widget = { layoutpolicy_horizontal = expanding size = { -1 34 } }

					# The pass itself. It opens the answer as well, because the
					# answer may belong to the other window: a good and a right
					# draw different rows.
					button_regular = {
						size = { 220 38 }
						tooltip = "bag_wtp_search_run_tt"
						text_single = {
							size = { 206 28 }
							parentanchor = center
							widgetanchor = center
							autoresize = no
							maximumsize = { 206 28 }
							fontsize = 14
							fontsize_min = 10
							align = center|nobaseline
							elide = right
							text = "bag_wtp_search_run"
						}
						onclick = "[GetScriptedGui('bag_wtp_search_run').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}

				# Nothing computed yet, or nothing survived the filters. Without this
				# the window is an empty box and says nothing about why.
				text_multi = {
					layoutpolicy_horizontal = expanding
					autoresize = yes
					maximumsize = { 1210 60 }
					align = center
					visible = "[Not(DataModelHasItems(GetGlobalList('bag_wtp_results')))]"
					text = "bag_wtp_result_window_empty"
				}

				# 48, not 38: the rows below sit inside a scrollbox whose content
				# carries a 10px margin, and for two runs every column header was
				# ten pixels left of the column it names.
				hbox = {
					layoutpolicy_horizontal = expanding
					margin_left = 10
					spacing = 0
					visible = "[DataModelHasItems(GetGlobalList('bag_wtp_results'))]"

					# The column the +/- buttons live in. It had no heading and the
					# empty corner read as a column out of line rather than as a
					# column without a name. `margin_left` drops from 48 to 10 --
					# the scrollbox's own content margin -- and this 38 makes the
					# difference back up, so «№» has not moved a pixel.
					text_single = {
						size = { 38 24 }
						autoresize = no
						align = center|vcenter
						fontsize = 13
						text = "bag_wtp_result_head_expand"
					}
					text_single = {
						size = { 34 24 }
						autoresize = no
						align = left|vcenter
						fontsize = 13
						text = "bag_wtp_result_head_rank"
					}
					text_single = {
						size = { 160 24 }
						autoresize = no
						align = left|vcenter
						fontsize = 13
						text = "bag_wtp_result_head_province"
					}
					widget = { size = { 8 24 } }
					text_single = {
						size = { 104 24 }
						autoresize = no
						align = left|vcenter
						fontsize = 13
						text = "bag_wtp_result_head_area"
					}
					widget = { size = { 8 24 } }
					# Plain labels again. Sorting is not a property of a column any
					# more: it belongs to which of the two «Считать» buttons was
					# pressed, and those live on the mod page where the question
					# is asked. Three buttons in a header was one control too
					# many, and the twenty-first run said so.
					text_single = {
						size = { 64 24 }
						autoresize = no
						align = left|vcenter
						fontsize = 13
						text = "bag_wtp_result_head_bonus"
						tooltip = "bag_wtp_result_head_bonus_tt"
					}
					widget = { size = { 6 24 } }
					text_single = {
						size = { 74 24 }
						autoresize = no
						align = left|vcenter
						fontsize = 13
						text = "bag_wtp_result_head_end"
						tooltip = "bag_wtp_result_head_end_tt"
					}
					widget = { size = { 6 24 } }
					text_single = {
						size = { 82 24 }
						autoresize = no
						align = left|vcenter
						fontsize = 13
						text = "bag_wtp_result_head_mid"
						tooltip = "bag_wtp_result_head_mid_tt"
					}
					widget = { size = { 8 24 } }
					text_single = {
						size = { 394 24 }
						autoresize = no
						maximumsize = { 394 24 }
						align = left|vcenter
						fontsize = 13
						text = "bag_wtp_result_head_method"
					}
					# **The count has a column of its own, and that was his fix**,
					# 2026-09-06: «просто символам 1/2 нужен свой столбик и тогда
					# проблем не возникнет». Two things sharing one column is what
					# let the icon wander into the gap between columns.
					text_single = {
						size = { 44 24 }
						autoresize = no
						maximumsize = { 44 24 }
						align = left|vcenter
						fontsize = 13
						fontsize_min = 10
						elide = right
						text = "bag_wtp_result_head_supply"
						tooltip = "bag_wtp_result_goods_tt"
					}
					widget = { size = { 4 24 } }
					text_single = {
						size = { 62 24 }
						autoresize = no
						maximumsize = { 62 24 }
						align = left|vcenter
						fontsize = 13
						fontsize_min = 10
						elide = right
						text = "bag_wtp_result_head_goods"
						tooltip = "bag_wtp_result_goods_tt"
					}
					widget = { size = { 4 24 } }
					text_single = {
						size = { 44 24 }
						autoresize = no
						align = left|vcenter
						fontsize = 13
						text = "bag_wtp_result_head_fit"
						tooltip = "bag_wtp_result_fit_tt"
					}
					widget = { layoutpolicy_horizontal = expanding size = { -1 28 } }
				}

				scrollbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					blockoverride "scrollbox_content" {
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = preferred
							margin = { 10 8 }
							margin_right = 20
							spacing = 3
							ignoreinvisible = yes
							datamodel = "[GetGlobalList('bag_wtp_results')]"
							item = {
								bag_wtp_result_province_entry = {
									datacontext = "[Scope.GetLocation]"
								}
							}
						}
					}
				}
			}
		}
	}
}
