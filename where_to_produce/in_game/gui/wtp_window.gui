# The shortlist window. Opened from the action bar button CMF registers, so no
# vanilla file is touched: the button flips the wtp_window_open global and this
# widget watches it.
#
# The panel carries `using = bg_paper_card` on the widget itself. Wrapping it in
# a `background = {}` block does nothing — vanilla applies these skins directly,
# which is why the first version drew its text straight onto the map.
widget = {
	name = "wtp_window"
	layer = topbar
	size = { 100% 100% }
	alwaystransparent = yes
	datacontext = "[GetPlayer]"
	visible = "[And(Country.IsValid, GetGlobalVariable('wtp_window_open').IsSet)]"

	widget = {
		size = { 640 580 }
		parentanchor = center
		alwaystransparent = no
		using = bg_paper_card

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 14 12 }
			spacing = 8

			hbox = {
				layoutpolicy_horizontal = expanding
				text_single = {
					text = "WTP_WINDOW_TITLE"
					default_format = "@bold!"
				}
				expand = {}
				button_close_alt = {
					onclick = "[GetScriptedGui('wtp_close_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			text_single = { text = "WTP_PICK_GOOD" }

			# Only goods something can actually produce with a local bonus.
			fixedgridbox = {
				layoutpolicy_horizontal = expanding
				maximumsize = { -1 148 }
				addcolumn = 36
				addrow = 36
				datamodel = "[GetGlobalList('wtp_goods')]"

				item = {
					widget = {
						size = { 34 34 }
						datacontext = "[Scope.GetGoods]"

						button = {
							size = { 34 34 }
							using = bg_paper_card
							onclick = "[GetScriptedGui('wtp_pick_good').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_goods_pick', Goods.MakeScope).End)]"
							tooltipwidget = { using = Goods_tooltip }

							icon = {
								size = { 26 26 }
								parentanchor = center
								texture = "[GetGoodsIcon(Goods.Self)]"
							}
						}

						# Ring around the good currently being planned.
						icon = {
							size = { 34 34 }
							parentanchor = center
							texture = "gfx/interface/component_tiles/tile_frame_selected.dds"
							visible = "[GetScriptedGui('wtp_good_is_selected').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('wtp_goods_pick', Goods.MakeScope).End)]"
						}
					}
				}
			}

			text_single = {
				text = "WTP_NO_SELECTION"
				visible = "[Not(GetScriptedGui('wtp_has_selection').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4
				visible = "[GetScriptedGui('wtp_has_selection').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				text_single = { size = { 250 20 } text = "WTP_COL_PROVINCE" default_format = "@bold!" }
				text_single = { size = { 90 20 } text = "WTP_COL_OUTPUT" default_format = "@bold!" align = right }
				text_single = { size = { 110 20 } text = "WTP_COL_BONUS" default_format = "@bold!" align = right }
				text_single = { size = { 110 20 } text = "WTP_COL_CEILING" default_format = "@bold!" align = right }
			}

			# Both orderings were built in the same pass, so the Mod Menu setting
			# only picks which one to draw.
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 2

				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2
					visible = "[Not(GetGlobalVariable('wtp_sort_by_coverage').IsSet)]"
					datamodel = "[GetGlobalList('wtp_by_output')]"
					item = { wtp_shortlist_row = {} }
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2
					visible = "[GetGlobalVariable('wtp_sort_by_coverage').IsSet]"
					datamodel = "[GetGlobalList('wtp_by_coverage')]"
					item = { wtp_shortlist_row = {} }
				}

				expand = {}
			}
		}
	}
}

types WhereToProduceTypes {
	# One province of the shortlist. The three figures were computed in script
	# and parked on the province, because the interface cannot evaluate a script
	# value itself.
	type wtp_shortlist_row = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 4
		datacontext = "[Scope.GetProvince]"

		text_single = {
			size = { 250 22 }
			text = "[Province.GetName]"
		}
		text_single = {
			size = { 90 22 }
			align = right
			raw_text = "[Province.MakeScope.GetVariable('wtp_row_output').GetValue|2]"
		}
		text_single = {
			size = { 110 22 }
			align = right
			raw_text = "[Province.MakeScope.GetVariable('wtp_row_bonus').GetValue|2]%"
		}
		text_single = {
			size = { 110 22 }
			align = right
			raw_text = "[Province.MakeScope.GetVariable('wtp_row_ceiling').GetValue|2]%"
		}
	}
}
