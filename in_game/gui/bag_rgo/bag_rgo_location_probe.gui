# Records which location the buildings panel is showing, so the list filter can
# reach it — a building_type filter is handed only the building type.
#
# Registered as a scripted widget, so nothing in the vanilla interface has to be
# replaced. LocationProductionView is a global view object and stays readable
# from anywhere in the hierarchy.
#
# The inner widget takes the viewed location as its data context and guards on
# Location.IsValid, so nothing here touches the view while no buildings panel is
# open. Evaluating the location every frame without that guard logs an error
# per frame.
#
# The state re-arms itself: once the location is stored,
# bag_rgo_view_location_is_current turns true and trigger_when goes quiet until
# the panel moves to a different location.
widget = {
	name = "bag_rgo_location_probe"
	size = { 0 0 }
	datacontext = "[GetPlayer]"
	visible = "[Country.IsValid]"

	widget = {
		size = { 0 0 }
		datacontext = "[LocationProductionView.GetSelectedLocation]"
		visible = "[Location.IsValid]"

		state = {
			name = bag_rgo_capture_location
			trigger_when = "[Not(GetScriptedGui('bag_rgo_view_location_is_current').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('bag_rgo_loc', Location.MakeScope).End))]"
			on_start = "[GetScriptedGui('bag_rgo_store_view_location').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('bag_rgo_loc', Location.MakeScope).End)]"
		}
	}
}
