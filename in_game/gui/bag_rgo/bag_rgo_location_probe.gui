# Records which location the buildings panel is showing, so the list filter can
# reach it — filters get the building type and the country, never the location.
#
# Registered as a scripted widget, so nothing in the vanilla interface has to be
# replaced. LocationProductionView is a global view object and stays readable
# from anywhere in the hierarchy.
#
# The state re-arms itself: once the location is stored,
# bag_rgo_view_location_is_current turns true and trigger_when goes quiet until
# the panel moves to a different location.
widget = {
	name = "bag_rgo_location_probe"
	size = { 0 0 }
	datacontext = "[GetPlayer]"
	visible = "[Country.IsValid]"

	state = {
		name = bag_rgo_capture_location
		trigger_when = "[And(
			LocationProductionView.GetSelectedLocation.IsValid,
			Not(GetScriptedGui('bag_rgo_view_location_is_current').IsShown(
				GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('bag_rgo_loc', LocationProductionView.GetSelectedLocation.MakeScope).End
			))
		)]"
		on_start = "[GetScriptedGui('bag_rgo_store_view_location').Execute(
			GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('bag_rgo_loc', LocationProductionView.GetSelectedLocation.MakeScope).End
		)]"
	}
}
