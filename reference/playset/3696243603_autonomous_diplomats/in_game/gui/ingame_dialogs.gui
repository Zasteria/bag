basic_priority_dialog = {
	name = "confirm_diplomatic_action_popup"
	widgetid = "confirm_diplomatic_action_popup"

	blockoverride "header_text" {
		text = "[DialogConfig.GetTitle]"
	}

	blockoverride "content" {
		vbox = {
			set_parent_dimension_to_minimum = height
			layoutpolicy_horizontal = expanding
			margin = { 20 0 }

			textbox = {
				text = "[DialogConfig.GetDescription]"
				layoutpolicy_horizontal = expanding
				autoresize = yes
				multiline = yes
				text_selectable = no
				alwaystransparent = no
				margin_left = 10
				margin_right = 10
				margin_bottom = 5

				using = Font_Type_Standard
				using = Font_Size_Medium
				default_format = "#white"

				align = center
			}
		}
	}

	blockoverride "bottom_buttons" {
		# ATD MOD: auto-confirm hidden widget. When the popup opens AND the global
		# atd_pending_confirm flag is set (set by atd_clear_pending_cancel right
		# after the outliner auto-cancel fired OutlinerDiplomacyEntry.OnRightClick),
		# this widget fires DialogConfig.OnAccept to confirm the cancel without
		# the player having to click.
		#
		# Placed in bottom_buttons (sits inside an hbox that accepts multiple
		# children) rather than content (whose scrollwidget rejects more than
		# one child with "Property widgets must specify exactly one widget").
		#
		# DialogConfig here doesn't expose the target country, so the gate is a
		# single global flag. If the player happens to have another diplomatic
		# confirmation popup open at the exact moment auto-cancel fires, this
		# could hijack it. Acceptable tradeoff: at most one accidental confirm
		# per cancel, and the flag is cleared on first fire so it doesn't repeat.
		# Outer wrapper: visibility-gated. PDX gui doesn't instantiate hidden
		# widgets, so when atd_pending_confirm is unset this whole subtree is
		# absent and trigger_on_create below stays inert.
		widget = {
			size = { 0 0 }
			visible = "[GetGlobalVariable('atd_pending_confirm').IsSet]"
			# Inner widget fires its state the moment it's CREATED rather
			# than waiting for a visibility transition or a poll. The outer
			# widget's visibility check determines whether this inner gets
			# instantiated at all - so when the popup spawns with the global
			# flag already set (atd_clear_pending_cancel sets it before
			# OutlinerDiplomacyEntry.OnRightClick produces the popup), the
			# inner widget is created in the same frame and its state fires
			# DialogConfig.OnAccept before the engine renders the popup.
			# Result: the popup is dismissed in the frame it appears, so
			# nothing visible flashes.
			widget = {
				size = { 0 0 }
				state = {
					name = atd_auto_confirm_on_create
					trigger_on_create = yes
					on_start = "[DialogConfig.OnAccept]"
					on_start = "[GetScriptedGui('atd_clear_pending_confirm').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				# Fallback for when trigger_on_create didn't fire (engine
				# sometimes skips state init under nested visibility gates).
				# The auto-cancel widget fires
				# PdxGuiTriggerAllAnimations('atd_do_auto_confirm') right after
				# OnRightClick, which reaches this state.
				state = {
					name = atd_do_auto_confirm
					on_finish = "[DialogConfig.OnAccept]"
					on_finish = "[GetScriptedGui('atd_clear_pending_confirm').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}
		}

		button_regular = {
			size = {120 30}
			text = "[DialogConfig.GetDeclineText]"
			action_tooltip = {
				title = "[DialogConfig.GetDeclineText]"
				on_action = "[DialogConfig.OnDecline]"
			}
			tooltipwidget = { BasicFunctionalTooltip = {} }
			input_action = "close_window"
			use_global_input_instance = yes
			using = snd_UI_reject
		}

		button_regular = {
			size = {120 30}
			text = "[DialogConfig.GetAcceptText]"
			action_tooltip = {
				title = "[DialogConfig.GetAcceptText]"
				on_action = "[DialogConfig.OnAccept]"
			}
			tooltipwidget = { BasicFunctionalTooltip = {} }
			input_action = "confirm"
			use_global_input_instance = yes

			icon = {
				position = { -15 0 }
				framesize = { 46 46 }
				size = { 23 23 }
				parentanchor = right|vcenter

				visible = "[ConfirmDiplomaticAction.RequiresAcceptance]"
				texture = "gfx/interface/icons/diplomatic_status/ai_accept_decline_icon.dds"
				frame = "[ConfirmDiplomaticAction.GetAcceptanceFrame]"
				tooltipwidget = {
					SimpleContextualStringPairTooltipType = {

						blockoverride "title_icon_texture" {
							frame_grid = { 3 1 }
							texture = "gfx/interface/icons/diplomatic_status/ai_accept_decline_icon.dds"
							frame = "[ConfirmDiplomaticAction.GetAcceptanceFrame]"
						}
						lowpriotextcontext = "[ConfirmDiplomaticAction.GetAcceptTooltip]"
					}
				}
			}
		}
	}
}
