# Hidden window that runs the monthly improve/enforce/auto-cancel chain off atd_pending_action.
widget = {
	name = "atd_hidden_window"
	# Keeps descendant visibility gates re-evaluating each frame.
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	position = { -10000 1 }
	# Per-cycle driver, re-fired each monthly tick by the atd_should_run gate.
	# visible_at_creation=no forces an initial false state so the atd_should_run
	# cycle fires _show even when the gate is already set at creation (a save
	# loaded mid-cycle).
	widget = {
		size = { 0 0 }
		visible_at_creation = no
		visible = "[And(GetPlayer.Exists, GetScriptedGui('atd_should_run').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		# 0.5s settle: lets the outliner sync widgets fire their _show and populate atd_improving_seen before atd_gui_sync_step reads it.
		state = {
			name = _show
			duration = 0.5
			next = atd_hidden_window_sync
		}
		state = {
			name = atd_hidden_window_sync
			on_start = "[GetScriptedGui('atd_gui_sync_step').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			next = atd_hidden_window_cancel
		}
		state = {
			name = atd_hidden_window_cancel
			on_start = "[PdxGuiTriggerAllAnimations('atd_do_auto_cancel')]"
			duration = 0.5
			next = atd_hidden_window_finish
		}
		# A cancel that raised no popup leaves atd_pending_confirm set, which would
		# arm the next diplomatic confirmation the player opens. Dropping it here
		# bounds the flag to this cycle.
		state = {
			name = atd_hidden_window_finish
			on_start = "[GetScriptedGui('atd_clear_pending_confirm').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			on_start = "[GetScriptedGui('atd_close_hidden_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
	}
}
