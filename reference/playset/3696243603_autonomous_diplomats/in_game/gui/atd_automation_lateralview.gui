							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('closebuildings')]" text = "[building|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('subsidizebuildings')]" text = "[subsidization|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('expandbuildings')]" text = "[building|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('destroybuildings')]" text = "[building|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('destroyestatebuildings')]" text = "[building|e]" }
