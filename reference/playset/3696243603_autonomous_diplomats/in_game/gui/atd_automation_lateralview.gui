# AutomationSystemStandardCard: the diplomacy card's Improve Opinion row opens the Autonomous Diplomats settings.
types atd_automation_overrides {
	type AutomationSystemStandardCard = AutomationCard {
		blockoverride "header_size" {
			size = { -1 35 }
		}

		blockoverride "card_color" {
			modify_texture = {
				using = color_paper_texture
			}
		}

		blockoverride "bg_card_header_01_bg" {
			# Government
			background = {
				visible = "[AutomatedSystemsItem.IsName('laws')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_government_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('bureaucracy')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_government_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('governmentreforms')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_government_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('cabinetmembers')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_government_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('cabinet')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_government_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('parliament')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_government_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('estates')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_government_texture }
			}
			# Economy
			background = {
				visible = "[AutomatedSystemsItem.IsName('finances')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_economy_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('credit')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_economy_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('trade')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_economy_texture }
			}
			# Production
			background = {
				visible = "[AutomatedSystemsItem.IsName('buildings')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('closebuildings')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('subsidizebuildings')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('expandbuildings')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('destroybuildings')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('destroyestatebuildings')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('productionmethods')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('rgo')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('expandrgo')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_production_texture }
			}
			# Society
			background = {
				visible = "[AutomatedSystemsItem.IsName('cultureacceptance')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_society_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('religiousdoctrines')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_society_texture }
			}
			# Diplomacy
			background = {
				visible = "[AutomatedSystemsItem.IsName('diplomacy')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_diplomacy_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('rivals')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_diplomacy_texture }
			}
			# Military
			background = {
				visible = "[AutomatedSystemsItem.IsName('armybuilder')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_military_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('navybuilder')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_military_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('replacegenerals')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_military_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('replaceadmirals')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_military_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('privateers')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_military_texture }
			}
			# Expansion
			background = {
				visible = "[AutomatedSystemsItem.IsName('exploration')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_geopolitics_texture }
			}
			background = {
				visible = "[AutomatedSystemsItem.IsName('colonies')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_geopolitics_texture }
			}
			# Advances
			background = {
				visible = "[AutomatedSystemsItem.IsName('research')]"
				using = bg_card_header_01_default
				blockoverride "header_color" { using = color_advances_texture }
			}
		}

		blockoverride "header_button" {
			# ATD MOD: vanilla's two enable/disable action_tooltips split into four,
			# so the diplomacy pair can also set the mod's atd__enabled setting.
			action_tooltip = {
				click_type = left
				title = "[AutomatedSystemsItem.GetActionTooltipName]"
				visible = "[And(Not(AutomatedSystemsItem.IsEnabled), Not(AutomatedSystemsItem.IsName('diplomacy')))]"
				using = snd_UI_checkbutton_automation
				on_action = "[AutomatedSystemsItem.Toggle]"
				on_action = "[PlayAudioEffect('UI_action_automate_enable')]"
			}

			action_tooltip = {
				click_type = left
				title = "[AutomatedSystemsItem.GetActionTooltipName]"
				visible = "[And(Not(AutomatedSystemsItem.IsEnabled), AutomatedSystemsItem.IsName('diplomacy'))]"
				using = snd_UI_checkbutton_automation
				on_action = "[AutomatedSystemsItem.Toggle]"
				on_action = "[GetScriptedGui('atd_automation_enable_master').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				on_action = "[PlayAudioEffect('UI_action_automate_enable')]"
			}

			action_tooltip = {
				click_type = left
				title = "[AutomatedSystemsItem.GetActionTooltipName]"
				visible = "[And(AutomatedSystemsItem.IsEnabled, Not(AutomatedSystemsItem.IsName('diplomacy')))]"
				using = snd_UI_checkbutton_automation
				on_action = "[AutomatedSystemsItem.Toggle]"
				on_action = "[PlayAudioEffect('UI_action_automate_disable')]"
			}

			action_tooltip = {
				click_type = left
				title = "[AutomatedSystemsItem.GetActionTooltipName]"
				visible = "[And(AutomatedSystemsItem.IsEnabled, AutomatedSystemsItem.IsName('diplomacy'))]"
				using = snd_UI_checkbutton_automation
				on_action = "[AutomatedSystemsItem.Toggle]"
				on_action = "[GetScriptedGui('atd_automation_disable_master').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				on_action = "[PlayAudioEffect('UI_action_automate_disable')]"
			}

			# Right-click opens the relevant panel
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('finances')]"
				on_action = "[OpenLateralView('economy')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('credit')]"
				on_action = "[OpenLateralView('credit')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('research')]"
				on_action = "[OpenLateralView('advances')]"
			}
			action_tooltip = {
				click_type = left
				enabled = "[Not(AutomatedSystemsItem.IsEnabled)]"
				title = "AUTOMATE_ALL_MARKETS"
				conditions = "AUTOMATE_ALL_MARKETS_DISABLED"
				on_action = "[AutomatedSystemsItem.Toggle]"
				visible = "[AutomatedSystemsItem.IsName('trade')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('trade')]"
				on_action = "[OpenLateralViewWithParams('trade', 'subtab = markets')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('productionmethods')]"
				on_action = "[OpenLateralView('production')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('laws')]"
				on_action = "[OpenLateralViewWithParams('government', 'tabcontent = politics')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[And(AutomatedSystemsItem.IsName('bureaucracy'), PlayerHasBureaucracies)]"
				on_action = "[OpenLateralView('bureaucracies')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('cabinetmembers')]"
				on_action = "[OpenLateralViewWithParams('government', 'tabcontent = cabinet')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('cabinet')]"
				on_action = "[OpenLateralViewWithParams('government', 'tabcontent = cabinet')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('governmentreforms')]"
				on_action = "[OpenLateralView('government_reforms')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('parliament')]"
				on_action = "[OpenLateralViewWithParams('government', 'tabcontent = parliament')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('estates')]"
				on_action = "[OpenLateralViewWithParams('government', 'tabcontent = estates')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('exploration')]"
				on_action = "[OpenLateralViewWithParams('expansion', 'low_tab = exploration')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('colonies')]"
				on_action = "[OpenLateralViewWithParams('expansion', 'low_tab = colonisation')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('cultureacceptance')]"
				on_action = "[OpenLateralViewWithParams('country_culture', 'subtab = breakdown')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('religiousdoctrines')]"
				on_action = "[OpenLateralViewWithParams('country_religion', 'subtab = doctrine')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('buildings')]"
				on_action = "[OpenLateralView('production')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('closebuildings')]"
				on_action = "[OpenLateralView('production')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('subsidizebuildings')]"
				on_action = "[OpenLateralView('production')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('expandbuildings')]"
				on_action = "[OpenLateralView('production')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('destroybuildings')]"
				on_action = "[OpenLateralView('production')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('destroyestatebuildings')]"
				on_action = "[OpenLateralView('production')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('expandrgo')]"
				on_action = "[OpenLateralView('goods_production')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('rgo')]"
				on_action = "[OpenLateralView('goods_production')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('armybuilder')]"
				on_action = "[OpenLateralViewWithParams('unit_overview', 'subtab = army')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('navybuilder')]"
				on_action = "[OpenLateralViewWithParams('unit_overview', 'subtab = navy')]"
			}
			# ATD MOD: right-click on the diplomacy card opens the mod's settings
			# instead of the diplomacy lateral view.
			action_tooltip = {
				click_type = right
				title = "atd_automation_open_settings"
				visible = "[AutomatedSystemsItem.IsName('diplomacy')]"
				on_action = "[GetScriptedGui(Select_CString(Or(Not(GameIsMultiplayer), IsHost), 'CMM_SetHostAndRegisterCoreMod', 'CMM_RegisterCoreMod')).Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				on_action = "[GetVariableSystem.Set('cmm_window_open', 'true')]"
				on_action = "[GetVariableSystem.Set('cmm_selected_mod', 'atd')]"
				on_action = "[GetVariableSystem.Set('cmm_selected_tab', 'atd__improve_relations')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('rivals')]"
				on_action = "[OpenLateralView('diplomacy')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('replacegenerals')]"
				on_action = "[OpenLateralViewWithParams('unit_overview', 'subtab = army')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('replaceadmirals')]"
				on_action = "[OpenLateralViewWithParams('unit_overview', 'subtab = navy')]"
			}
			action_tooltip = {
				click_type = right
				title = "[AutomatedSystemsItem.GetClickAction]"
				visible = "[AutomatedSystemsItem.IsName('privateers')]"
				on_action = "[OpenLateralViewWithParams('maritime', 'low_tab = privateers')]"
			}

			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_icon" {
						widget = {
							size = { 42 42 }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('finances')]" texture = "[GetConceptTexture('budget')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('credit')]" texture = "[GetConceptTexture('loan')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('research')]" texture = "[GetConceptTexture('research')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('trade')]" texture = "[GetConceptTexture('trade')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('productionmethods')]" texture = "[GetConceptTexture('production_method')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('laws')]" texture = "[GetConceptTexture('law')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('bureaucracy')]" texture = "[GetConceptTexture('bureaucracy')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('governmentreforms')]" texture = "[GetConceptTexture('government_reform')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('cabinetmembers')]" texture = "[GetConceptTexture('cabinet_member')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('cabinet')]" texture = "[GetConceptTexture('cabinet_action')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('parliament')]" texture = "[GetConceptTexture('parliament')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('estates')]" texture = "[GetConceptTexture('estate')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('exploration')]" texture = "[GetConceptTexture('exploration')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('colonies')]" texture = "[GetConceptTexture('colonization')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('cultureacceptance')]" texture = "[GetConceptTexture('culture')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('religiousdoctrines')]" texture = "[GetConceptTexture('religious_aspect')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('buildings')]" texture = "[GetConceptTexture('building')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('closebuildings')]" texture = "gfx/interface/icons/achievements/padlock.dds" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('subsidizebuildings')]" texture = "[GetConceptTexture('subsidization')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('expandbuildings')]" texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('destroybuildings')]" texture = "gfx/interface/icons/modifier_types/estate_building_destruction_satisfaction_impact.dds" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('destroyestatebuildings')]" texture = "[GetConceptTexture('building')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('expandrgo')]" texture = "gfx/interface/icons/flat_icons/mass_upgrade.dds" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('rgo')]" texture = "[GetConceptTexture('rgo')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('armybuilder')]" texture = "[GetConceptTexture('army')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('navybuilder')]" texture = "[GetConceptTexture('navy')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('diplomacy')]" texture = "[GetConceptTexture('diplomacy')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('rivals')]" texture = "[GetConceptTexture('rival')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('replacegenerals')]" texture = "[GetConceptTexture('general')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('replaceadmirals')]" texture = "[GetConceptTexture('admiral')]" }
							ConceptIcon = { visible = "[AutomatedSystemsItem.IsName('privateers')]" texture = "[GetConceptTexture('privateer')]" }
						}
					}
					blockoverride "title_text" {
						text = "[AutomatedSystemsItem.GetName]"
					}
					blockoverride "concept_link_obj" {
						widget = {
							layoutpolicy_horizontal = expanding
							size = { -1 20 }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('finances')]" text = "[budget|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('credit')]" text = "[loan|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('research')]" text = "[research|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('trade')]" text = "[trade|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('productionmethods')]" text = "[production_method|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('laws')]" text = "[law|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('bureaucracy')]" text = "[bureaucracy|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('governmentreforms')]" text = "[government_reform|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('cabinetmembers')]" text = "[cabinet_member|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('cabinet')]" text = "[cabinet_action|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('parliament')]" text = "[parliament|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('estates')]" text = "[estate|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('exploration')]" text = "[exploration|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('colonies')]" text = "[colonization|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('cultureacceptance')]" text = "[accepted_culture|e]" }
							text_single = { size = { 100% 100% } using = Font_Type_Flavor autoresize = no align = left|nobaseline alwaystransparent = yes visible = "[AutomatedSystemsItem.IsName('religiousdoctrines')]" text = "[religious_aspect|e]" }
