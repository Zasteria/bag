		blockoverride "footer_content" {
			vbox = { # Diplomacy controls: capacity reserve + diplomat reserve + action flags
				visible = "[AutomatedSystemsItem.IsName('diplomacy')]"
				layoutpolicy_horizontal = expanding
				margin = { 10 10 }
				spacing = 5

				vbox = {
					using = bg_dynasty_header
					layoutpolicy_horizontal = expanding
					margin = { 10 10 }
					spacing = 5

					text_single = {
						layoutpolicy_horizontal = expanding
						using = Font_Type_Headers
						text = "AUTOMATE_DIPLO_CAPACITY_RESERVE_LABEL"
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						economy_slider = {
							size = { 200 10 }
							min = 0
							max = 1
							value = "[AutomatedSystemsItem.GetCapacitySlider]"
							onvaluechanged = "[AutomatedSystemsItem.OnChangedCapacitySlider]"
							onchangefinish = "[AutomatedSystemsItem.PostCapacitySlider]"
							blockoverride "economy_slider_inc_button_config"{
								enabled = "[LessThan_CFixedPoint(AutomatedSystemsItem.GetCapacitySlider, '(CFixedPoint)1')]"
							}
							blockoverride "economy_slider_dec_button_config"{
								enabled = "[GreaterThan_CFixedPoint(AutomatedSystemsItem.GetCapacitySlider, '(CFixedPoint)0')]"
							}
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							margin = { 15 0 }
							raw_text = "[AutomatedSystemsItem.GetCapacitySliderScaled|0]"
						}
					}
				}

				vbox = {
					using = bg_dynasty_header
					layoutpolicy_horizontal = expanding
					margin = { 10 10 }
					spacing = 5

					text_single = {
						layoutpolicy_horizontal = expanding
						using = Font_Type_Headers
						text = "AUTOMATE_DIPLO_DIPLOMAT_RESERVE_LABEL"
						# ATD MOD: vanilla AUTOMATE_DIPLO_DIPLOMAT_RESERVE_TOOLTIP.
						tooltip = "atd_automation_diplomat_reserve_tooltip"
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						economy_slider = {
							size = { 200 10 }
							min = 0
							max = 1
							value = "[AutomatedSystemsItem.GetDiplomatReserveSlider]"
							# ATD MOD: mincap/maxcap added. Pinned to the settings value while a
							# push is pending; the forced value commits through the callbacks below.
							mincap = "[Select_CFixedPoint(And(GetPlayer.MakeScope.GetVariable('atd_reserve_from_cmm').IsSet, Not(EqualTo_CFixedPoint(AutomatedSystemsItem.GetDiplomatReserveSliderScaled, GuiScope.AddScope('atd_country', GetPlayer.MakeScope).ScriptValue('atd_min_diplomats_value')))), GuiScope.AddScope('atd_country', GetPlayer.MakeScope).ScriptValue('atd_reserve_push_target'), '(CFixedPoint)0')]"
							maxcap = "[Select_CFixedPoint(And(GetPlayer.MakeScope.GetVariable('atd_reserve_from_cmm').IsSet, Not(EqualTo_CFixedPoint(AutomatedSystemsItem.GetDiplomatReserveSliderScaled, GuiScope.AddScope('atd_country', GetPlayer.MakeScope).ScriptValue('atd_min_diplomats_value')))), GuiScope.AddScope('atd_country', GetPlayer.MakeScope).ScriptValue('atd_reserve_push_target'), '(CFixedPoint)1')]"
							onvaluechanged = "[AutomatedSystemsItem.OnChangedDiplomatReserveSlider]"
							onchangefinish = "[AutomatedSystemsItem.PostDiplomatReserveSlider]"
							blockoverride "economy_slider_inc_button_config"{
								enabled = "[LessThan_CFixedPoint(AutomatedSystemsItem.GetDiplomatReserveSlider, '(CFixedPoint)1')]"
							}
							blockoverride "economy_slider_dec_button_config"{
								enabled = "[GreaterThan_CFixedPoint(AutomatedSystemsItem.GetDiplomatReserveSlider, '(CFixedPoint)0')]"
							}
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							margin = { 15 0 }
							raw_text = "[AutomatedSystemsItem.GetDiplomatReserveSliderScaled|1]"
						}
					}

					# ATD MOD: arms a push on every card creation: the settings value wins the open.
					widget = {
						size = { 0 0 }
						visible_at_creation = no
						visible = "[GetPlayer.Exists]"
						state = {
							name = _show
							on_start = "[GetScriptedGui('atd_automation_reserve_reconcile').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}

					# ATD MOD: pull: samples the slider into the reserve setting on a loop. A
					# visibility-gated transition goes sticky after a few changes, so the
					# state retriggers itself and the effect skips the no-op ticks.
					widget = {
						size = { 0 0 }
						state = {
							name = atd_reserve_poll
							trigger_on_create = yes
							duration = 0.25
							on_finish = "[GetScriptedGui('atd_automation_reserve_changed').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('atd_reserve', MakeScopeValue(AutomatedSystemsItem.GetDiplomatReserveSliderScaled)).End)]"
							on_finish = "[PdxGuiWidget.TriggerAnimation('atd_reserve_poll')]"
						}
					}

					# ATD MOD: slider scale cache: scaled divided by normalized while the slider is above zero.
					widget = {
						size = { 0 0 }
						visible_at_creation = no
						visible = "[And(GreaterThan_CFixedPoint(AutomatedSystemsItem.GetDiplomatReserveSlider, '(CFixedPoint)0'), Not(EqualTo_CFixedPoint(Divide_CFixedPoint(AutomatedSystemsItem.GetDiplomatReserveSliderScaled, AutomatedSystemsItem.GetDiplomatReserveSlider), GuiScope.AddScope('atd_country', GetPlayer.MakeScope).ScriptValue('atd_reserve_max_value'))))]"
						state = {
							name = _show
							on_start = "[GetScriptedGui('atd_automation_reserve_max_changed').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('atd_max', MakeScopeValue(Divide_CFixedPoint(AutomatedSystemsItem.GetDiplomatReserveSliderScaled, AutomatedSystemsItem.GetDiplomatReserveSlider))).End)]"
						}
					}

					# ATD MOD: push finalize: commits after the caps settle, then clears the pending flag.
					# The equality branch clears a flag that has nothing to push.
					widget = {
						size = { 0 0 }
						visible_at_creation = no
						visible = "[And(GetPlayer.MakeScope.GetVariable('atd_reserve_from_cmm').IsSet, Or(GreaterThan_CFixedPoint(GuiScope.AddScope('atd_country', GetPlayer.MakeScope).ScriptValue('atd_reserve_max_value'), '(CFixedPoint)0'), EqualTo_CFixedPoint(AutomatedSystemsItem.GetDiplomatReserveSliderScaled, GuiScope.AddScope('atd_country', GetPlayer.MakeScope).ScriptValue('atd_min_diplomats_value'))))]"
						state = {
							name = _show
							duration = 0.3
							on_finish = "[AutomatedSystemsItem.PostDiplomatReserveSlider]"
							on_finish = "[GetScriptedGui('atd_automation_reserve_pushed').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}
				}

				vbox = {
					using = bg_dynasty_header
					layoutpolicy_horizontal = expanding
					margin = { 10 10 }
					spacing = 3

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						checkbox_square_alt = {
							# ATD MOD: the checkbox toggles the mod's atd__improve_relations_enabled
							# setting instead of the engine's ToggleImproveOpinion sub-flag.
							action_tooltip = {
								title = "AUTOMATE_DIPLO_IMPROVE_OPINION"
								visible = "[Not(GetPlayer.MakeScope.GetVariable('atd_improve_relations_enabled').IsSet)]"
								on_action = "[GetScriptedGui('atd_automation_enable_improve').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							action_tooltip = {
								title = "AUTOMATE_DIPLO_IMPROVE_OPINION"
								visible = "[GetPlayer.MakeScope.GetVariable('atd_improve_relations_enabled').IsSet]"
								on_action = "[GetScriptedGui('atd_automation_disable_improve').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							down = "[GetPlayer.MakeScope.GetVariable('atd_improve_relations_enabled').IsSet]"
							tooltipwidget = {
								BasicFunctionalTooltip = {
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											# ATD MOD: vanilla AUTOMATE_DIPLO_IMPROVE_OPINION_TOOLTIP.
											textcontext = "atd_automation_improve_opinion_tooltip"
										}
									}
								}
							}
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							using = Font_Type_Standard
							text = "AUTOMATE_DIPLO_IMPROVE_OPINION"
						}
					}

					# ATD MOD: clears the engine improve-opinion flag.
					widget = {
						size = { 0 0 }
						visible_at_creation = no
						visible = "[And(AutomatedSystemsItem.IsImproveOpinionEnabled, Not(GetPlayer.MakeScope.GetVariable('atd_engine_improve_opinion_cleared').IsSet))]"
						state = {
							name = _show
							on_start = "[AutomatedSystemsItem.ToggleImproveOpinion]"
							on_start = "[GetScriptedGui('atd_automation_engine_improve_cleared').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						checkbox_square_alt = {
							action_tooltip = {
								title = "AUTOMATE_DIPLO_SEND_GIFTS"
								on_action = "[AutomatedSystemsItem.ToggleSendGifts]"
							}
							down = "[AutomatedSystemsItem.IsSendGiftsEnabled]"
							tooltipwidget = {
								BasicFunctionalTooltip = {
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											textcontext = "AUTOMATE_DIPLO_SEND_GIFTS_TOOLTIP"
										}
									}
								}
							}
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							using = Font_Type_Standard
							text = "AUTOMATE_DIPLO_SEND_GIFTS"
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						checkbox_square_alt = {
							action_tooltip = {
								title = "AUTOMATE_DIPLO_CURRY_FAVORS"
								on_action = "[AutomatedSystemsItem.ToggleCurryFavors]"
							}
							down = "[AutomatedSystemsItem.IsCurryFavorsEnabled]"
							tooltipwidget = {
								BasicFunctionalTooltip = {
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											textcontext = "AUTOMATE_DIPLO_CURRY_FAVORS_TOOLTIP"
										}
									}
								}
							}
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							using = Font_Type_Standard
							text = "AUTOMATE_DIPLO_CURRY_FAVORS"
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						checkbox_square_alt = {
							action_tooltip = {
								title = "AUTOMATE_DIPLO_ROYAL_MARRIAGES"
								on_action = "[AutomatedSystemsItem.ToggleRoyalMarriages]"
							}
							down = "[AutomatedSystemsItem.IsRoyalMarriagesEnabled]"
							tooltipwidget = {
								BasicFunctionalTooltip = {
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											textcontext = "AUTOMATE_DIPLO_ROYAL_MARRIAGES_TOOLTIP"
										}
									}
								}
							}
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							using = Font_Type_Standard
							text = "AUTOMATE_DIPLO_ROYAL_MARRIAGES"
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						checkbox_square_alt = {
							action_tooltip = {
								title = "AUTOMATE_DIPLO_ALLIANCES"
								on_action = "[AutomatedSystemsItem.ToggleAlliancesAndPacts]"
							}
							down = "[AutomatedSystemsItem.IsAlliancesAndPactsEnabled]"
							tooltipwidget = {
								BasicFunctionalTooltip = {
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											textcontext = "AUTOMATE_DIPLO_ALLIANCES_TOOLTIP"
										}
									}
								}
							}
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							using = Font_Type_Standard
							text = "AUTOMATE_DIPLO_ALLIANCES"
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						checkbox_square_alt = {
							action_tooltip = {
								title = "AUTOMATE_DIPLO_SUBJECTS"
								on_action = "[AutomatedSystemsItem.ToggleManageSubjects]"
							}
							down = "[AutomatedSystemsItem.IsManageSubjectsEnabled]"
							tooltipwidget = {
								BasicFunctionalTooltip = {
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											textcontext = "AUTOMATE_DIPLO_SUBJECTS_TOOLTIP"
										}
									}
								}
							}
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							using = Font_Type_Standard
							text = "AUTOMATE_DIPLO_SUBJECTS"
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						checkbox_square_alt = {
							action_tooltip = {
								title = "AUTOMATE_DIPLO_ORGANIZATIONS"
								on_action = "[AutomatedSystemsItem.ToggleInternationalOrganizations]"
							}
							down = "[AutomatedSystemsItem.IsInternationalOrganizationsEnabled]"
							tooltipwidget = {
								BasicFunctionalTooltip = {
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											textcontext = "AUTOMATE_DIPLO_ORGANIZATIONS_TOOLTIP"
										}
									}
								}
							}
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							using = Font_Type_Standard
							text = "AUTOMATE_DIPLO_ORGANIZATIONS"
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						checkbox_square_alt = {
							action_tooltip = {
								title = "AUTOMATE_DIPLO_DECLARE_WAR"
								on_action = "[AutomatedSystemsItem.ToggleDeclareWar]"
							}
							down = "[AutomatedSystemsItem.IsDeclareWarEnabled]"
							tooltipwidget = {
								BasicFunctionalTooltip = {
									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											textcontext = "AUTOMATE_DIPLO_DECLARE_WAR_TOOLTIP"
										}
									}
								}
							}
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							using = Font_Type_Standard
							text = "AUTOMATE_DIPLO_DECLARE_WAR"
						}
					}
				}
			}
			vbox = { # Gold slider.
				visible = "[AutomatedSystemsItem.IsName('buildings')]"
				layoutpolicy_horizontal = expanding
				margin = { 10 10 }
				spacing = 5

				hbox = {
					using = bg_dynasty_header
					using = allow_special_currency_spend_tt
					layoutpolicy_horizontal = expanding
					margin = { 10 10 }
					spacing = 10

					checkbox_square_alt = {
						action_tooltip = {
							title = "ALLOW_SPECIAL_CURRENCY_SPEND"
							on_action = "[AutomatedSystemsItem.ToggleAllowingSpecialCurrencySpend]"
						}
						down = "[AutomatedSystemsItem.IsAllowingSpecialCurrencySpend]"
						using = allow_special_currency_spend_tt
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						
						multiline = yes
						using = Font_Type_Standard
						text = "ALLOW_SPECIAL_CURRENCY_SPEND"
					}
				}
				vbox = {
					using = bg_dynasty_header
					using = minimum_gold_tt
					layoutpolicy_horizontal = expanding
					margin = { 10 10 }
					spacing = 5

					text_single = {
						layoutpolicy_horizontal = expanding
						using = Font_Type_Headers
						text = "MINIMUM_GOLD"
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						economy_slider = {
							size = { 200 10 }
							min = 0
							max = 1
							# using = minimum_gold_tt # please displace TT so it doesn't cover slider if you want it!!!
							value = "[AutomatedSystemsItem.GetGoldSlider]"
							onvaluechanged = "[AutomatedSystemsItem.OnChangedGoldSlider]"
							onchangefinish = "[AutomatedSystemsItem.PostGoldSlider]"
							blockoverride "economy_slider_inc_button_config"{
								enabled = "[LessThan_CFixedPoint(AutomatedSystemsItem.GetGoldSlider, '(CFixedPoint)1')]"
							}
							blockoverride "economy_slider_dec_button_config"{
								enabled = "[GreaterThan_CFixedPoint(AutomatedSystemsItem.GetGoldSlider, '(CFixedPoint)0')]"
							}
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							using = minimum_gold_tt
							margin = { 15 0 }
							raw_text = "[AutomatedSystemsItem.GetGoldSliderScaled|0Y]@gold!"
						}
					}
				}
			}
		}
	}
}
