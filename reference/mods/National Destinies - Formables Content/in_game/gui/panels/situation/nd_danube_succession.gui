						visible = "[Or( Or( EqualTo_CFixedPoint(GetSituationByKey('nd_danube_succession').MakeScope.GetVariable('nd_dnb_shared_hab_hun').GetValue, '(CFixedPoint)1'), EqualTo_CFixedPoint(GetSituationByKey('nd_danube_succession').MakeScope.GetVariable('nd_dnb_shared_hab_boh').GetValue, '(CFixedPoint)1') ), Or( EqualTo_CFixedPoint(GetSituationByKey('nd_danube_succession').MakeScope.GetVariable('nd_dnb_shared_hun_boh').GetValue, '(CFixedPoint)1'), Or( EqualTo_CFixedPoint(GetSituationByKey('nd_danube_succession').MakeScope.GetVariable('nd_dnb_outside_house_hab').GetValue, '(CFixedPoint)1'), Or( EqualTo_CFixedPoint(GetSituationByKey('nd_danube_succession').MakeScope.GetVariable('nd_dnb_outside_house_hun').GetValue, '(CFixedPoint)1'), EqualTo_CFixedPoint(GetSituationByKey('nd_danube_succession').MakeScope.GetVariable('nd_dnb_outside_house_boh').GetValue, '(CFixedPoint)1') ) ) ) )]"
