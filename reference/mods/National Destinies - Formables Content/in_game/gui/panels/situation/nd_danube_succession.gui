			blockoverride "header_text" {
				text = "nd_dnb_panel_standings_header"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/situations/nd_danube_succession.dds"
			}
			blockoverride "bottom_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 15 10 }
					spacing = 8

					text_single = {
						layoutpolicy_horizontal = expanding
						fontsize = 15
						text = "nd_dnb_sec_candidacies"
						default_format = "#T"
					}
				hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						visible = "[GetCountry('HAB').IsValid]"
						country_flag_small = {
							datacontext = "[GetCountry('HAB')]"
						}
						dynasty_shield_mid = {
							visible = "[GetCountry('HAB').GetGovernment.GetRuler.HasDynasty]"
