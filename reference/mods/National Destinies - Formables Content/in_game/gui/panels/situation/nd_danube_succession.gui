		# CARD 4: The Levers (always visible): what a crown can DO.
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'levers_toggled' )]"
			}
			blockoverride "header_text" {
				text = "nd_dnb_panel_levers_header"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/situations/nd_danube_succession.dds"
			}
			blockoverride "bottom_content" {
				text_multi = {
					margin = { 15 0 }
					layoutpolicy_horizontal = expanding
					max_width = 500
					autoresize = yes
					text = "nd_dnb_panel_levers_body"
				}
