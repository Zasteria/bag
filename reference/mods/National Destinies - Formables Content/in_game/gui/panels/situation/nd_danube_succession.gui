# Situation panel for nd_danube_succession (PLAN.md section 13).
#
# Visible to the three crowns and the watching Catholic world, so every
# card is informational for all perspectives; the levers card doubles as
# the how-to (user ruling 4: the player must always see what is
# happening and why). Patterns: nd_dnm_reaction_of_the_reich.gui (card
# stack, hint links), iw_tension_explain_tt convention (documented
# score sources), GetSituationByKey MakeScope variable reads
# (situations_l_english.yml:834).
situation_panel = {

	##################################### TOP HEADER #####################################
	# Left counter: Menace at the Gates (0..3). Right counter: Diets held.

	blockoverride "situation_header_left" {
		icon = {
			size = { 32 32 }
			texture = "gfx/interface/icons/situations/nd_danube_succession.dds"
		}
		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				fontsize = 15
				text = "nd_dnb_menace_header"
				default_format = "#subtle_name"
			}
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 3
				tooltip = "nd_dnb_menace_meter_tt"
				icon = {
					size = { 14 14 }
					parentanchor = vcenter
					texture = "gfx/interface/progressbars/orange_circle_bg.dds"
					visible = "[GreaterThan_CFixedPoint(GetSituationByKey('nd_danube_succession').MakeScope.GetVariable('nd_dnb_menace').GetValue, '(CFixedPoint)0')]"
				}
				icon = {
					size = { 14 14 }
					parentanchor = vcenter
					texture = "gfx/interface/progressbars/empty_circle_bg.dds"
					visible = "[Not(GreaterThan_CFixedPoint(GetSituationByKey('nd_danube_succession').MakeScope.GetVariable('nd_dnb_menace').GetValue, '(CFixedPoint)0'))]"
				}
				icon = {
					size = { 14 14 }
					parentanchor = vcenter
					texture = "gfx/interface/progressbars/orange_circle_bg.dds"
					visible = "[GreaterThan_CFixedPoint(GetSituationByKey('nd_danube_succession').MakeScope.GetVariable('nd_dnb_menace').GetValue, '(CFixedPoint)1')]"
				}
				icon = {
					size = { 14 14 }
					parentanchor = vcenter
					texture = "gfx/interface/progressbars/empty_circle_bg.dds"
					visible = "[Not(GreaterThan_CFixedPoint(GetSituationByKey('nd_danube_succession').MakeScope.GetVariable('nd_dnb_menace').GetValue, '(CFixedPoint)1'))]"
				}
				icon = {
					size = { 14 14 }
					parentanchor = vcenter
					texture = "gfx/interface/progressbars/orange_circle_bg.dds"
					visible = "[GreaterThan_CFixedPoint(GetSituationByKey('nd_danube_succession').MakeScope.GetVariable('nd_dnb_menace').GetValue, '(CFixedPoint)2')]"
				}
				icon = {
					size = { 14 14 }
					parentanchor = vcenter
					texture = "gfx/interface/progressbars/empty_circle_bg.dds"
					visible = "[Not(GreaterThan_CFixedPoint(GetSituationByKey('nd_danube_succession').MakeScope.GetVariable('nd_dnb_menace').GetValue, '(CFixedPoint)2'))]"
				}
				text_single = {
					fontsize = 13
					margin_left = 4
					raw_text = "[GetSituationByKey('nd_danube_succession').MakeScope.GetVariable('nd_dnb_menace').GetValue|0] / 3"
				}
				expand = {}
			}
		}
		expand = {}
	}

	blockoverride "situation_header_right" {
		expand = {}
		vbox = {
			layoutpolicy_horizontal = expanding
			text_single = {
				fontsize = 15
				align = right|nobaseline
				text = "nd_dnb_diets_header"
				default_format = "#subtle_name"
			}
			text_single = {
				layoutpolicy_horizontal = expanding
				fontsize = 13
				align = right|nobaseline
				raw_text = "[GetSituationByKey('nd_danube_succession').MakeScope.GetVariable('nd_dnb_diets_held').GetValue|0]"
			}
		}
		icon = {
			size = { 32 32 }
			texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
		}
	}

	##################################### SUBHEADER #####################################

	blockoverride "situation_subheader_content" {}

	##################################### MAIN CONTENT #####################################

	blockoverride "situation_panel_main_content" {

		# CARD 1: Description (always visible).
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'situation_toggled' )]"
			}
			blockoverride "header_text" {
				text = "nd_danube_succession_situation_header"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/situations/nd_danube_succession.dds"
			}
			blockoverride "bottom_content" {
				text_multi = {
					margin = { 15 0 }
					layoutpolicy_horizontal = expanding
					max_width = 500
					autoresize = yes
					text = "nd_danube_succession_situation_body"
				}
			}
			blockoverride "visible_hint" {}
			blockoverride "onaction_hint" {
				action_tooltip = {
					title = "OPEN_HINT"
					on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_nd_danube_succession')]"
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'situation_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'situation_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'situation_toggled' ))]"
			}
		}

		# CARD 2: End Requirements (always visible).
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'requirements_toggled' )]"
			}
			blockoverride "header_text" {
				text = "END_REQUIREMENTS"
			}
			blockoverride "header_icon" {
				texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
			}
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]"
				}
			}
			blockoverride "visible_hint" {}
			blockoverride "onaction_hint" {
				action_tooltip = {
					title = "OPEN_HINT"
					on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_nd_danube_succession')]"
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'requirements_toggled' ))]"
			}
		}

		# CARD 3: The Standings (always visible): the live scoreboard.
		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'standings_toggled' )]"
