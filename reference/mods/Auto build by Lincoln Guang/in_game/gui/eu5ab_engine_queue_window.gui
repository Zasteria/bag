# Hidden engine-value bridge. Every candidate is routed to exactly one
# emergency/feature phase before GUI-only actual values are queried.
widget = {
	name = "eu5ab_engine_queue_window"
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	position = { -10000 1 }
	widget = {
		widget = {
			size = { 0 0 }
			visible = "[And(GetPlayer.Exists, GetScriptedGui('eu5ab_gui_queue_phase_1_should_validate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			state = { name = _show duration = 0.1 next = eu5ab_q_validate_round_1 }
			state = {
				name = eu5ab_q_validate_round_1
				duration = 0.15
				on_finish = "[PdxGuiTriggerAllAnimations('eu5ab_q_validate_candidate_1')]"
				on_finish = "[PdxGuiTriggerAllAnimations('eu5ab_q_validate_rgo_1')]"
				on_finish = "[PdxGuiTriggerAllAnimations('eu5ab_q_probe_approved')]"
				next = eu5ab_q_validate_check_1
			}
			state = {
				name = eu5ab_q_validate_check_1
				duration = 0.15
				on_finish = "[GetScriptedGui('eu5ab_gui_queue_sync_check').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				next = eu5ab_q_validate_round_1
			}
		}
		widget = {
			datamodel = "[GetPlayer.MakeScope.GetList('eu5ab_q_phase_1_rgo_locations')]"
			item = { widget = { datacontext = "[Scope.GetLocation]" state = { name = eu5ab_q_validate_rgo_1 on_finish = "[GetScriptedGui('eu5ab_gui_queue_try_rgo').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('eu5ab_engine_country', GetPlayer.MakeScope).End)]" } } }
		}
		widget = {
			datamodel = "[GetPlayer.MakeScope.GetList('eu5ab_q_phase_1_locations')]"
			item = {
				widget = {
					datacontext = "[Scope.GetLocation]"
					datamodel = "[Location.MakeScope.GetList('eu5ab_q_phase_1_types')]"
					item = { widget = { datacontext = "[Scope.GetBuildingType]" state = { name = eu5ab_q_validate_candidate_1 on_finish = "[GetScriptedGui('eu5ab_gui_queue_try_candidate').Execute(GuiScope.SetRoot(Location.MakeScope).AddScope('eu5ab_candidate_building', BuildingType.MakeScope).AddScope('eu5ab_engine_country', GetPlayer.MakeScope).AddScope('eu5ab_engine_cost', MakeScopeValue(GetBuildOrExpandBuildingCost(BuildingType.Self, Location.Self))).AddScope('eu5ab_engine_income', MakeScopeValue(GetBuildingTypeIncomeToOwnerInLocation(BuildingType.Self, Location.Self))).AddScope('eu5ab_engine_profit', MakeScopeValue(GetBuildingTypeProfitInLocation(BuildingType.Self, Location.Self))).AddScope('eu5ab_engine_can_build', MakeScopeBool(CanBuildOrExpandBuilding(BuildingType.Self, Location.Self))).End)]" } } }
				}
			}
		}
		widget = {
			size = { 0 0 }
			visible = "[And(GetPlayer.Exists, GetScriptedGui('eu5ab_gui_queue_phase_2_should_validate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
