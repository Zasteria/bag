types SakuyaCultureSelectorTypes
{
	type sakuya_culture_selector_window = window {
		name = "sakuya_culture_selector_window"
		block "window_position" {
			parentanchor = center
			position = { 0 0 }
		}
		size = { 1280 720 }
		movable = yes
		allow_outside = yes
		visible = "[GetVariableSystem.Exists('sakuya_culture_selector_visible')]"
		enabled = "[GetVariableSystem.Exists('sakuya_culture_selector_visible')]"

		widget = {
			size = { 100% 100% }
			using = bg_window_default_alt

			widget = {
				parentanchor = right
				position = { -5 5 }
				size = { 40 40 }
				ui_direction_button_holder_right = {}
				button_close_alt = {
					blockoverride "close_on_action" {
						on_action = "[GetVariableSystem.Clear('sakuya_culture_selector_visible')]"
					}
				}
			}

			text_single = {
				position = { 30 26 }
				size = { 1280 40 }
				text = "SAKUYA_SELECTOR_CULTURE_TITLE"
				fontsize = 30
				fontsize_min = 18
				align = center|nobaseline
				default_format = "#yellow_titles"
			}

			widget = {
				position = { 34 78 }
				size = { 870 610 }
