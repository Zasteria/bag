types SakuyaChangeNameTypes
{
    type sakuya_change_name_window = window {
        name = "sakuya_change_name_window"
        parentanchor = center
        allow_outside = yes
        size = { 400 300 }
        position = { 0 0 }
        visible = "[GetVariableSystem.Exists('sakuya_show_rename_window')]"

        vbox = {
            block "msg_size" {
                minimumsize = { 600 300 }
                maximumsize = { 600 300 }
            }
            set_parent_size_to_minimum = yes
            using = snd_UI_popup_show

            vbox = {
                using = layoutpolicy_expanding
                bottomtotop = yes

                vbox = {
                    margin = {5 15}
                    spacing = 10
                    using = layoutpolicy_expanding
                    using = bg_age_event_inner
                    using = bg_age_event_frame

                    widget = {
                        allow_outside = yes

                        block "desc_spacing" {
                            size = { 1 1 }
                        }
                    }

                    vbox = {
                        layoutpolicy_horizontal = expanding
                        margin = {30 0}
                        block "message_template_content" {
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                margin = {5 0}
                                using = message_text_box_background
                                visible = yes

                                editbox_single = {
                                    size = { 300 30 }

                                    blockoverride "editbox_label" {
                                        text = "[Localize('RENAME')] [GetPlayer.MakeScope.GetVariable('sakuya_rename_target_country').GetCountry.GetName]"
                                    }

                                    blockoverride "editbox_properties" {
                                        name = "new_name"
                                        tooltipwidget = {
                                            LeftClickButtonTooltip = {
                                                blockoverride "onclick_text" { text = "SAKUYA_CHANGE_NAME_GUI_RDIT_COUNTRY_NAME_TT" }
                                            }
                                        }
                                        ontextchanged = "[GetVariableSystem.Set('renaming_new_name', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
                                        maxcharacters = 42
                                    }
                                }
                            }
                        }
                    }

                    hbox = {
                        margin = { 0 10 }
                        spacing = 50

                        block "message_template_buttons" {
                            button_regular_diamond = {
                                name = "decline_button"
                                tooltip_enabled = no
                                text = "MESSAGEPOPUP_DECLINE"
                                using = button_resize_to_fit_text
                                using = snd_UI_close

                                block "decline_title" {
                                    text = "CANCEL_BUTTON"
                                }

                                onclick = "[GetVariableSystem.Clear('sakuya_show_rename_window')]"
                                onclick = "[GetVariableSystem.Clear('renaming_new_name')]"
                                onclick = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
                                onclick = "[ExecuteConsoleCommand( Concatenate( 'effect c:', Concatenate( GetPlayer.GetTag, ' = { remove_variable = sakuya_rename_target_country }' ) ) )]"
                            }
                            button_regular_diamond = {
                                enabled = "[GetPlayer.MakeScope.GetVariable('sakuya_rename_target_country').IsSet]"
                                name = "accept_button"
                                #tooltip_enabled = no
                                tooltip = "SAKUYA_CHANGE_NAME_GUI_CHANGE_THE_NAME_ACCEPT_TT"
                                text = "CHANGE_THE_NAME"
                                using = button_resize_to_fit_text
                                using = snd_UI_popup_confirm

                                onclick = "[ExecuteConsoleCommand( Concatenate( 'effect c:', Concatenate( GetPlayer.MakeScope.GetVariable('sakuya_rename_target_country').GetCountry.GetTag, Concatenate( ' = { change_country_name = \"', Concatenate( GetVariableSystem.Get('renaming_new_name'), '\" }' ) ) ) ) )]"
                                onclick = "[GetVariableSystem.Clear('sakuya_show_rename_window')]"
                                onclick = "[GetVariableSystem.Clear('renaming_new_name')]"
                                onclick = "[ExecuteConsoleCommand( Concatenate( 'effect c:', Concatenate( GetPlayer.GetTag, ' = { remove_variable = sakuya_rename_target_country }' ) ) )]"

                                input_action = "confirm"
                                use_global_input_instance = yes
                            }
                        }
                    }
                }

                hbox = {
                    using = bg_age_event_title
                    layoutpolicy_horizontal = expanding

                    blockoverride "bg_event_title_texture" {
                        texture = "gfx/interface/component_tiles/bg_big_round_corners_up.dds"
                        texture_density = 2
                        spriteType = corneredstretched
                        spriteBorder = { 40 40 }
                        margin = {3 0}
                        margin_bottom = -2
                    }

                    widget = {
                        layoutpolicy_vertical = expanding
                        size = {5 -1}

                        AgeEventDecorationTop = {
                            size = {64 52}
                            position = { -10 -2 }
                            parentanchor = left|top
                            widgetanchor = top
                        }

                        AgeEventDecorationTop2 = {
                            parentanchor = left|bottom
                            position = {-4 15}
                            mirror = horizontal
                        }
                    }

                    hbox = {
                        layoutpolicy_horizontal = expanding
                        margin = { 40 20 }
                        spacing = 15

                        block "message_decoration_left" {}

                        block "message_title_content" {
                            hbox = {
                                vbox = {
                                    textbox = {
                                        using = text_multi_template
                                        name = "subtitle"
                                        autoresize = yes
                                        fontsize = 19
                                        default_format = "#subtle_name"
                                        align = center
                                        text = "SAKUYA_CHANGE_NAME_GUI_TITLE"
                                    }

                                    textbox = {
                                        using = text_multi_template
                                        autoresize = yes
                                        default_format = "#yellow_titles"
                                        fontsize = 22
                                        align = center|nobaseline
                                        raw_text = "[Select_CString(GetPlayer.MakeScope.GetVariable('sakuya_rename_target_country').IsSet, GetPlayer.MakeScope.GetVariable('sakuya_rename_target_country').GetCountry.GetNameWithFlag, Localize('RENAME'))]"
                                    }
                                }
                            }
                        }

                        block "message_decoration_right" {}
                    }

                    widget = {
                        layoutpolicy_vertical = expanding
                        size = {5 -1}

                        AgeEventDecorationTop = {
                            size = {64 52}
                            position = { -10 -2 }
                            parentanchor = left|top
                            widgetanchor = top
                        }

                        AgeEventDecorationTop2 = {
                            parentanchor = left|bottom
                            position = {-4 15}
                            mirror = horizontal
                        }
                    }
                }
            }
        }
        widget = { #sakuya_watching 装饰图标 鼠标穿透
            parentanchor = center|top
            position = { -200 -90 }
            size = { 103 120 }
            alwaystransparent = yes
            filter_mouse = none
            allow_outside = yes

            icon = {
                size = { 103 120 }
                texture = "gfx/interface/sakuya/sakuya_watching.png"
                alwaystransparent = yes
            }
        }
    }
}

sakuya_change_name_window = {
    datacontext = "[GetPlayer]"
}
