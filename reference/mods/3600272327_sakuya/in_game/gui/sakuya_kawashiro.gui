types SakuyaKawashiroTypes
{
	type sakuya_kawashiro_window = window {
		name = "sakuya_kawashiro_window"
		parentanchor = center
        position = { 0 0 }
		size = { 1920 1080 }
		allow_outside = yes
		visible = "[GetVariableSystem.Exists('sakuya_kawashiro_visible')]"
		enabled = "[GetVariableSystem.Exists('sakuya_kawashiro_visible')]"

		widget = {
			size = { 100% 100% }
			using = bg_window_default_alt
			allow_outside = yes

			widget = {
				parentanchor = right
				position = { -5 5 }
				size = { 40 40 }
				ui_direction_button_holder_right = {}

				button_close_alt = {
                    size = { 40 40 }
					blockoverride "close_on_action" {
						on_action = "[GetVariableSystem.Clear('sakuya_kawashiro_visible')]"
						on_action = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
					}
				}
			}

			vbox = {
				using = window_margin_alt
				window_header_alt = {
					blockoverride "header_text" {
						text = "CHEAT_MENU_SAKUYA_KAWASHIRO_TITLE"
					}
				}

				vbox = {
					using = layoutpolicy_expanding
					using = bg_main_inner_alt

					widget = {
						name = "sakuya_kawashiro_content"
						using = layoutpolicy_expanding

						widget = {
							parentanchor = left|center
							position = { 20 0 }
							size = { 665 963 }
							scissor = yes
							icon = {
								size = { 100% 100% }
								texture = "gfx/interface/sakuya/news_sakuya.dds"
							}
						}

						widget = {
							size = { 800 80}
							position = { 750 100 }

							text_single = {
                                maximumsize = { 800 80 }
								fontsize = 40
								raw_text = "CHEAT_MENU_SAKUYA_KAWASHIRO_NEWS_TITLE"
								position = { 0 0 }
							}
						}

						widget = {
							size = { 1100 800 }
							position = { 750 180 }

							text_multi = {
								autoresize = yes
								maximumsize = { 1100 800 }
								align = left
                                fontsize = 25
								raw_text = "CHEAT_MENU_SAKUYA_KAWASHIRO_NEWS_CONTENT"
								position = { 0 0 }
							}
						}
					}
				}
			}
		}
	}
}

sakuya_kawashiro_window = {
    datacontext = "[GetPlayer]"
}
