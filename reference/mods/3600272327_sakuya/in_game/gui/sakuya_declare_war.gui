types SakuyaDeclareWarTypes
{
    type sakuya_declare_war_window = window {
        name = "sakuya_declare_war_window"
        block "window_position" {
            parentanchor = center
            position = { 0 0 }
        }
        size = { 900 620 }
        movable = yes
        allow_outside = yes
        visible = "[GetVariableSystem.Exists('sakuya_show_declare_war_window')]"
        enabled = "[GetVariableSystem.Exists('sakuya_show_declare_war_window')]"

        widget = {
            size = { 100% 100% }
            using = bg_window_default_alt
            allow_outside = yes

            widget = {
                parentanchor = right
                position = { -5 5 }
                size = { 40 40 }
                ui_direction_button_holder_right = {}
                button_close_alt = {
                    blockoverride "close_on_action" {
                        on_action = "[GetVariableSystem.Set('sakuya_main_visible', 'yes')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_show_declare_war_window')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_selected_declare_war_cb')]"
                    }
                }
            }

            vbox = {
                using = window_margin_alt

                window_header_alt = {
                    blockoverride "header_text" {
                        text = "SAKUYA_DECLARE_WAR_TITLE"
                    }
                }

                widget = {
                    size = { 820 30 }
                    text_single = { visible = "[Not(GetVariableSystem.Exists('sakuya_selected_declare_war_cb'))]" size = { 820 30 } autoresize = no maximumsize = { 820 30 } fontsize = 16 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_DECLARE_WAR_SELECTED_NONE" }
                    text_single = { visible = "[GetVariableSystem.HasValue('sakuya_selected_declare_war_cb', 'cb_none')]" size = { 820 30 } autoresize = no maximumsize = { 820 30 } fontsize = 16 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_DECLARE_WAR_SELECTED_cb_none" }
                    text_single = { visible = "[GetVariableSystem.HasValue('sakuya_selected_declare_war_cb', 'cb_war_from_event')]" size = { 820 30 } autoresize = no maximumsize = { 820 30 } fontsize = 16 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_DECLARE_WAR_SELECTED_cb_war_from_event" }
                    text_single = { visible = "[GetVariableSystem.HasValue('sakuya_selected_declare_war_cb', 'cb_insulted_us')]" size = { 820 30 } autoresize = no maximumsize = { 820 30 } fontsize = 16 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_DECLARE_WAR_SELECTED_cb_insulted_us" }
                    text_single = { visible = "[GetVariableSystem.HasValue('sakuya_selected_declare_war_cb', 'cb_rebel_support')]" size = { 820 30 } autoresize = no maximumsize = { 820 30 } fontsize = 16 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_DECLARE_WAR_SELECTED_cb_rebel_support" }
                    text_single = { visible = "[GetVariableSystem.HasValue('sakuya_selected_declare_war_cb', 'cb_declined_call_to_arms')]" size = { 820 30 } autoresize = no maximumsize = { 820 30 } fontsize = 16 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_DECLARE_WAR_SELECTED_cb_declined_call_to_arms" }
                    text_single = { visible = "[GetVariableSystem.HasValue('sakuya_selected_declare_war_cb', 'cb_denied_military_access')]" size = { 820 30 } autoresize = no maximumsize = { 820 30 } fontsize = 16 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_DECLARE_WAR_SELECTED_cb_denied_military_access" }
                    text_single = { visible = "[GetVariableSystem.HasValue('sakuya_selected_declare_war_cb', 'cb_following_through_on_threat')]" size = { 820 30 } autoresize = no maximumsize = { 820 30 } fontsize = 16 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_DECLARE_WAR_SELECTED_cb_following_through_on_threat" }
