types SakuyaBetaTypes
{
    type sakuya_beta_window = window {
        name = "sakuya_beta_window"
        parentanchor = center
        position = { 0 0 }
        size = { 850 780 }
        movable = yes
        allow_outside = yes

        visible = "[GetVariableSystem.Exists('sakuya_beta_visible')]"

        widget = {
            size = { 100% 100% }
            using = bg_window_default_alt

            widget = {
                parentanchor = right
                position = { -5 5 }
                size = { 40 40 }
                ui_direction_button_holder_right = {}

                button_close_alt = {
                    blockoverride "close_on_action" {
                        on_action = "[GetVariableSystem.Clear('sakuya_beta_visible')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_beta_prov_visible')]"
                        on_action = "[GetVariableSystem.Toggle('sakuya_location_visible')]"
                        # 清理展开状态
                        on_action = "[GetVariableSystem.Clear('sakuya_exp_prov')]"
                    }
                }
            }

            vbox = {
                using = window_margin_alt

                window_header_alt = {
                    blockoverride "header_text" {
                        text = "SAKUYA_BETA_TITLE"
                    }
                }

                # 标题和统计
                hbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 5 }
                    spacing = 10

                    text_single = {
                        autoresize = yes
                        text = "SAKUYA_BETA_PROVINCE_LIST_TITLE"
                        using = Font_Size_Medium
                    }

                    expand = {}

                    # 全部展开按钮
                    button_regular = {
                        size = { 100 28 }
                        onclick = "[GetVariableSystem.Set('sakuya_expand_all', 'yes')]"
                        tooltip = "SAKUYA_BETA_EXPAND_ALL_TT"

                        text_single = {
                            parentanchor = center
                            autoresize = yes
                            text = "SAKUYA_BETA_EXPAND_ALL"
                            using = Font_Size_Small
                        }
                    }

                    # 全部折叠按钮
                    button_regular = {
                        size = { 100 28 }
                        onclick = "[GetVariableSystem.Clear('sakuya_expand_all')]"
                        onclick = "[GetVariableSystem.Clear('sakuya_exp_prov')]"
                        tooltip = "SAKUYA_BETA_COLLAPSE_ALL_TT"

                        text_single = {
                            parentanchor = center
                            autoresize = yes
                            text = "SAKUYA_BETA_COLLAPSE_ALL"
                            using = Font_Size_Small
                        }
                    }
                }

                #divider_flavor_01 = {}

                # 主内容区 - 可滚动的省份列表
                scrollbox = {
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding

                    blockoverride "scrollbox_content" {
                        vbox = {
                            layoutpolicy_horizontal = expanding
                            spacing = 2
                            margin = { 5 5 }

                            datamodel = "[Player.GetProvinces]"

                            item = {
                                sakuya_beta_province_entry = {}
                            }
                        }
                    }
                }

                # 底部操作栏
                hbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 8 }
                    spacing = 10

                    button_regular = {
                        size = { 150 35 }
                        onclick = "[GetScriptedGui('sakuya_beta_mark_all_locations').Execute(GuiScope.SetRoot(Player.MakeScope).End)]"
                        tooltip = "SAKUYA_BETA_MARK_ALL_TT"

                        text_single = {
                            parentanchor = center
                            autoresize = yes
                            text = "SAKUYA_BETA_MARK_ALL_GLOBAL"
                            using = Font_Size_Small
                        }
                    }

                    button_regular = {
                        size = { 150 35 }
                        onclick = "[GetScriptedGui('sakuya_beta_unmark_all_locations').Execute(GuiScope.SetRoot(Player.MakeScope).End)]"
                        tooltip = "SAKUYA_BETA_UNMARK_ALL_TT"

                        text_single = {
                            parentanchor = center
                            autoresize = yes
                            text = "SAKUYA_BETA_UNMARK_ALL_GLOBAL"
                            using = Font_Size_Small
                        }
                    }

                    expand = {}
                }
            }
        }
    }

    # ========================================
    # 省份条目 - 带折叠功能
    # ========================================
    type sakuya_beta_province_entry = vbox {
        layoutpolicy_horizontal = expanding
        spacing = 0

        # 省份头部 - 可点击展开/折叠
        widget = {
            layoutpolicy_horizontal = expanding
            size = { -1 38 }

            using = bg_paper_card

            # 点击整行切换展开状态
            button = {
                size = { 100% 100% }
                onclick = "[GetVariableSystem.Set('sakuya_exp_prov', Province.GetName)]"
                # 如果已经展开，点击则折叠
                visible = "[Not(EqualTo_string(GetVariableSystem.Get('sakuya_exp_prov'), Province.GetName))]"
            }
            button = {
                size = { 100% 100% }
                onclick = "[GetVariableSystem.Clear('sakuya_exp_prov')]"
                visible = "[EqualTo_string(GetVariableSystem.Get('sakuya_exp_prov'), Province.GetName)]"
            }

            hbox = {
                layoutpolicy_horizontal = expanding
                margin = { 8 0 }
                spacing = 8

                # 折叠/展开按钮 - 点击可切换状态
                button_square_plus = {
                    size = { 20 20 }
                    parentanchor = vcenter
                    visible = "[And(Not(EqualTo_string(GetVariableSystem.Get('sakuya_exp_prov'), Province.GetName)), Not(GetVariableSystem.Exists('sakuya_expand_all')))]"
                    onclick = "[GetVariableSystem.Set('sakuya_exp_prov', Province.GetName)]"
                }
                button_square_minus = {
                    size = { 20 20 }
                    parentanchor = vcenter
                    visible = "[Or(EqualTo_string(GetVariableSystem.Get('sakuya_exp_prov'), Province.GetName), GetVariableSystem.Exists('sakuya_expand_all'))]"
                    onclick = "[GetVariableSystem.Clear('sakuya_exp_prov')]"
                }

                # 省份名称
                text_single = {
                    autoresize = yes
                    text = "[Province.GetName]"
                    using = Font_Size_Small
                    default_format = "#bold"
                    parentanchor = vcenter
                }

                # 地点数量
                text_single = {
                    autoresize = yes
                    text = "SAKUYA_BETA_PROVINCE_LOCATION_COUNT"
                    using = Font_Size_Small
                    default_format = "#weak"
                    parentanchor = vcenter
                }

                expand = {}

                # 标记该省份所有地点
                button_regular = {
                    size = { 90 28 }
                    parentanchor = vcenter
                    enabled = "[GetScriptedGui('sakuya_beta_mark_province_all').IsValid(GuiScope.SetRoot(Province.MakeScope).End)]"
                    onclick = "[GetScriptedGui('sakuya_beta_mark_province_all').Execute(GuiScope.SetRoot(Province.MakeScope).End)]"
                    tooltip = "SAKUYA_BETA_MARK_PROVINCE_ALL_TT"

                    text_single = {
                        parentanchor = center
                        autoresize = yes
                        text = "SAKUYA_BETA_MARK_ALL_BUTTON"
                        using = Font_Size_Small
                    }
                }

                # 取消标记该省份所有地点
                button_regular = {
                    size = { 90 28 }
                    parentanchor = vcenter
                    enabled = "[GetScriptedGui('sakuya_beta_unmark_province_all').IsValid(GuiScope.SetRoot(Province.MakeScope).End)]"
                    onclick = "[GetScriptedGui('sakuya_beta_unmark_province_all').Execute(GuiScope.SetRoot(Province.MakeScope).End)]"
                    tooltip = "SAKUYA_BETA_UNMARK_PROVINCE_ALL_TT"

                    text_single = {
                        parentanchor = center
                        autoresize = yes
                        text = "SAKUYA_BETA_UNMARK_ALL_BUTTON"
                        using = Font_Size_Small
                    }
                }
            }
        }

        # ========================================
        # 地点列表 - 折叠内容
        # ========================================
        vbox = {
            layoutpolicy_horizontal = expanding
            spacing = 1
            margin_left = 25
            margin_top = 2
            margin_bottom = 4

            # 条件显示：当前省份展开 OR 全部展开模式
            visible = "[Or(EqualTo_string(GetVariableSystem.Get('sakuya_exp_prov'), Province.GetName), GetVariableSystem.Exists('sakuya_expand_all'))]"

            datamodel = "[Province.GetLocations]"
            item = {
                sakuya_beta_location_entry = {}
            }
        }
    }

    # ========================================
    # 地点条目
    # ========================================
    type sakuya_beta_location_entry = hbox {
        layoutpolicy_horizontal = expanding
        spacing = 5
        margin = { 5 2 }

        using = bg_number_container_bckg

        # 地点图标
        icon = {
            size = { 22 22 }
            texture = "[Location.GetRankIcon]"
            parentanchor = vcenter
            tooltipwidget = {
                using = location_simple_tooltip
            }
        }

        # 地点名称
        text_single = {
            layoutpolicy_horizontal = expanding
            autoresize = no
            text = "[Location.GetName]"
            using = Font_Size_Small
            align = left|nobaseline
            parentanchor = vcenter
        }

        # 人口信息
        text_single = {
            size = { 70 22 }
            autoresize = no
            raw_text = "[Location.GetTotalPopulation] @population!"
            using = Font_Size_Small
            parentanchor = vcenter
        }

        # 标记按钮
        button_regular = {
            size = { 80 26 }
            parentanchor = vcenter
            enabled = "[GetScriptedGui('sakuya_beta_mark_location').IsValid(GuiScope.SetRoot(Location.MakeScope).End)]"
            onclick = "[GetScriptedGui('sakuya_beta_mark_location').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
            tooltip = "SAKUYA_BETA_MARK_BUTTON_TT"

            text_single = {
                parentanchor = center
                autoresize = yes
                text = "SAKUYA_BETA_MARK_BUTTON"
                using = Font_Size_Small
            }
        }

        # 取消标记按钮
        button_regular = {
            size = { 80 26 }
            parentanchor = vcenter
            enabled = "[GetScriptedGui('sakuya_beta_unmark_location').IsValid(GuiScope.SetRoot(Location.MakeScope).End)]"
            onclick = "[GetScriptedGui('sakuya_beta_unmark_location').Execute(GuiScope.SetRoot(Location.MakeScope).End)]"
            tooltip = "SAKUYA_BETA_UNMARK_BUTTON_TT"

            text_single = {
                parentanchor = center
                autoresize = yes
                text = "SAKUYA_BETA_UNMARK_BUTTON"
                using = Font_Size_Small
            }
        }
    }
}

sakuya_beta_window = {
    datacontext = "[GetPlayer]"
}
