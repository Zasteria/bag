types SakuyaAIPersonalityTypes
{
    type sakuya_ai_personality_window = window {
        name = "sakuya_ai_personality_window"
        block "window_position" {
            parentanchor = center
            position = { 0 0 }
        }
        size = { 420 300 }
        movable = yes
        allow_outside = yes

        visible = "[GetVariableSystem.Exists('sakuya_show_ai_personality_window')]"
        enabled = "[GetVariableSystem.Exists('sakuya_show_ai_personality_window')]"

        widget = {
            size = { 100% 100% }
            using = bg_window_default_alt
            allow_outside = yes

            widget = {
                parentanchor = right
                position = { -5 5 }
                size = { 40 40 }
                ui_direction_button_holder_right = {}

                button_close_alt = {
                    blockoverride "close_on_action" {
                        on_action = "[GetVariableSystem.Set('sakuya_main_visible', 'yes')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_show_ai_personality_window')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_selected_ai_personality')]"
                    }
                }
            }

            vbox = {
                using = window_margin_alt

                window_header_alt = {
                    blockoverride "header_text" {
                        text = "SAKUYA_AI_PERSONALITY_TITLE"
                    }
                }

                hbox = {
                    spacing = 5
                    widget = { size = { 64 99 } vbox = { spacing = 5 widget = { size = { 64 64 } allow_outside = yes icon = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'aggressive')]" size = { 130% 130% } parentanchor = center texture = "gfx/interface/animation/rotate_glow2.dds" color = { 0.8 0.5 1 0.8 } alwaystransparent = yes modify_texture = { texture = "gfx/interface/animation/rotate_glow_mask3.dds" blend_mode = alphamultiply } } button = { size = { 64 64 } tooltip = "ai_aggressive_desc" texture = "gfx/interface/icons/traits/glory_seeker.dds" alpha = "[Select_float(GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'aggressive'), '(float)1.0', '(float)0.7')]" onclick = "[GetVariableSystem.Set('sakuya_selected_ai_personality', 'aggressive')]" } } text_single = { size = { 64 30 } autoresize = no maximumsize = { 64 30 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "ai_aggressive" } } }
                    widget = { size = { 64 99 } vbox = { spacing = 5 widget = { size = { 64 64 } allow_outside = yes icon = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'expansionist')]" size = { 130% 130% } parentanchor = center texture = "gfx/interface/animation/rotate_glow2.dds" color = { 0.8 0.5 1 0.8 } alwaystransparent = yes modify_texture = { texture = "gfx/interface/animation/rotate_glow_mask3.dds" blend_mode = alphamultiply } } button = { size = { 64 64 } tooltip = "ai_expansionist_desc" texture = "gfx/interface/icons/traits/goal_oriented.dds" alpha = "[Select_float(GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'expansionist'), '(float)1.0', '(float)0.7')]" onclick = "[GetVariableSystem.Set('sakuya_selected_ai_personality', 'expansionist')]" } } text_single = { size = { 64 30 } autoresize = no maximumsize = { 64 30 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "ai_expansionist" } } }
                    widget = { size = { 64 99 } vbox = { spacing = 5 widget = { size = { 64 64 } allow_outside = yes icon = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'defensive')]" size = { 130% 130% } parentanchor = center texture = "gfx/interface/animation/rotate_glow2.dds" color = { 0.8 0.5 1 0.8 } alwaystransparent = yes modify_texture = { texture = "gfx/interface/animation/rotate_glow_mask3.dds" blend_mode = alphamultiply } } button = { size = { 64 64 } tooltip = "ai_defensive_desc" texture = "gfx/interface/icons/traits/hardy_warrior.dds" alpha = "[Select_float(GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'defensive'), '(float)1.0', '(float)0.7')]" onclick = "[GetVariableSystem.Set('sakuya_selected_ai_personality', 'defensive')]" } } text_single = { size = { 64 30 } autoresize = no maximumsize = { 64 30 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "ai_defensive" } } }
                    widget = { size = { 64 99 } vbox = { spacing = 5 widget = { size = { 64 64 } allow_outside = yes icon = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'cautious')]" size = { 130% 130% } parentanchor = center texture = "gfx/interface/animation/rotate_glow2.dds" color = { 0.8 0.5 1 0.8 } alwaystransparent = yes modify_texture = { texture = "gfx/interface/animation/rotate_glow_mask3.dds" blend_mode = alphamultiply } } button = { size = { 64 64 } tooltip = "ai_cautious_desc" texture = "gfx/interface/icons/traits/level_headed.dds" alpha = "[Select_float(GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'cautious'), '(float)1.0', '(float)0.7')]" onclick = "[GetVariableSystem.Set('sakuya_selected_ai_personality', 'cautious')]" } } text_single = { size = { 64 30 } autoresize = no maximumsize = { 64 30 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "ai_cautious" } } }
                    widget = { size = { 64 99 } vbox = { spacing = 5 widget = { size = { 64 64 } allow_outside = yes icon = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'opportunistic')]" size = { 130% 130% } parentanchor = center texture = "gfx/interface/animation/rotate_glow2.dds" color = { 0.8 0.5 1 0.8 } alwaystransparent = yes modify_texture = { texture = "gfx/interface/animation/rotate_glow_mask3.dds" blend_mode = alphamultiply } } button = { size = { 64 64 } tooltip = "ai_opportunistic_desc" texture = "gfx/interface/icons/traits/schemer.dds" alpha = "[Select_float(GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'opportunistic'), '(float)1.0', '(float)0.7')]" onclick = "[GetVariableSystem.Set('sakuya_selected_ai_personality', 'opportunistic')]" } } text_single = { size = { 64 30 } autoresize = no maximumsize = { 64 30 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "ai_opportunistic" } } }
                }

                hbox = {
                    spacing = 5
                    widget = { size = { 64 99 } vbox = { spacing = 5 widget = { size = { 64 64 } allow_outside = yes icon = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'isolationist')]" size = { 130% 130% } parentanchor = center texture = "gfx/interface/animation/rotate_glow2.dds" color = { 0.8 0.5 1 0.8 } alwaystransparent = yes modify_texture = { texture = "gfx/interface/animation/rotate_glow_mask3.dds" blend_mode = alphamultiply } } button = { size = { 64 64 } tooltip = "ai_isolationist_desc" texture = "gfx/interface/icons/traits/hermit.dds" alpha = "[Select_float(GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'isolationist'), '(float)1.0', '(float)0.7')]" onclick = "[GetVariableSystem.Set('sakuya_selected_ai_personality', 'isolationist')]" } } text_single = { size = { 64 30 } autoresize = no maximumsize = { 64 30 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "ai_isolationist" } } }
                    widget = { size = { 64 99 } vbox = { spacing = 5 widget = { size = { 64 64 } allow_outside = yes icon = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'friendly')]" size = { 130% 130% } parentanchor = center texture = "gfx/interface/animation/rotate_glow2.dds" color = { 0.8 0.5 1 0.8 } alwaystransparent = yes modify_texture = { texture = "gfx/interface/animation/rotate_glow_mask3.dds" blend_mode = alphamultiply } } button = { size = { 64 64 } tooltip = "ai_friendly_desc" texture = "gfx/interface/icons/traits/kind_hearted.dds" alpha = "[Select_float(GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'friendly'), '(float)1.0', '(float)0.7')]" onclick = "[GetVariableSystem.Set('sakuya_selected_ai_personality', 'friendly')]" } } text_single = { size = { 64 30 } autoresize = no maximumsize = { 64 30 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "ai_friendly" } } }
                    widget = { size = { 64 99 } alwaystransparent = yes }
                    widget = { size = { 64 99 } alwaystransparent = yes }
                    widget = { size = { 64 99 } alwaystransparent = yes }
                }

                hbox = {
                    spacing = 5
                    button_regular = { visible = "[Not(GetVariableSystem.Exists('sakuya_selected_ai_personality'))]" size = { 168 40 } enabled = no tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 160 34 } parentanchor = center autoresize = no maximumsize = { 160 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_SELF" } }
                    button_regular = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'aggressive')]" size = { 168 40 } tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 160 34 } parentanchor = center autoresize = no maximumsize = { 160 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_SELF" } onclick = "[GetScriptedGui('sakuya_ai_personality_self_aggressive').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                    button_regular = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'expansionist')]" size = { 168 40 } tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 160 34 } parentanchor = center autoresize = no maximumsize = { 160 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_SELF" } onclick = "[GetScriptedGui('sakuya_ai_personality_self_expansionist').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                    button_regular = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'defensive')]" size = { 168 40 } tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 160 34 } parentanchor = center autoresize = no maximumsize = { 160 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_SELF" } onclick = "[GetScriptedGui('sakuya_ai_personality_self_defensive').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                    button_regular = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'cautious')]" size = { 168 40 } tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 160 34 } parentanchor = center autoresize = no maximumsize = { 160 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_SELF" } onclick = "[GetScriptedGui('sakuya_ai_personality_self_cautious').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                    button_regular = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'opportunistic')]" size = { 168 40 } tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 160 34 } parentanchor = center autoresize = no maximumsize = { 160 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_SELF" } onclick = "[GetScriptedGui('sakuya_ai_personality_self_opportunistic').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                    button_regular = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'isolationist')]" size = { 168 40 } tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 160 34 } parentanchor = center autoresize = no maximumsize = { 160 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_SELF" } onclick = "[GetScriptedGui('sakuya_ai_personality_self_isolationist').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                    button_regular = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'friendly')]" size = { 168 40 } tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 160 34 } parentanchor = center autoresize = no maximumsize = { 160 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_SELF" } onclick = "[GetScriptedGui('sakuya_ai_personality_self_friendly').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                    button_regular = { visible = "[Not(GetVariableSystem.Exists('sakuya_selected_ai_personality'))]" size = { 167 40 } enabled = no tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 159 34 } parentanchor = center autoresize = no maximumsize = { 159 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_TARGET" } }
                    button_regular = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'aggressive')]" size = { 167 40 } enabled = "[GetScriptedGui('sakuya_check_country_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 159 34 } parentanchor = center autoresize = no maximumsize = { 159 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_TARGET" } onclick = "[GetScriptedGui('sakuya_ai_personality_target_aggressive').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                    button_regular = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'expansionist')]" size = { 167 40 } enabled = "[GetScriptedGui('sakuya_check_country_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 159 34 } parentanchor = center autoresize = no maximumsize = { 159 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_TARGET" } onclick = "[GetScriptedGui('sakuya_ai_personality_target_expansionist').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                    button_regular = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'defensive')]" size = { 167 40 } enabled = "[GetScriptedGui('sakuya_check_country_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 159 34 } parentanchor = center autoresize = no maximumsize = { 159 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_TARGET" } onclick = "[GetScriptedGui('sakuya_ai_personality_target_defensive').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                    button_regular = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'cautious')]" size = { 167 40 } enabled = "[GetScriptedGui('sakuya_check_country_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 159 34 } parentanchor = center autoresize = no maximumsize = { 159 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_TARGET" } onclick = "[GetScriptedGui('sakuya_ai_personality_target_cautious').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                    button_regular = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'opportunistic')]" size = { 167 40 } enabled = "[GetScriptedGui('sakuya_check_country_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 159 34 } parentanchor = center autoresize = no maximumsize = { 159 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_TARGET" } onclick = "[GetScriptedGui('sakuya_ai_personality_target_opportunistic').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                    button_regular = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'isolationist')]" size = { 167 40 } enabled = "[GetScriptedGui('sakuya_check_country_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 159 34 } parentanchor = center autoresize = no maximumsize = { 159 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_TARGET" } onclick = "[GetScriptedGui('sakuya_ai_personality_target_isolationist').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                    button_regular = { visible = "[GetVariableSystem.HasValue('sakuya_selected_ai_personality', 'friendly')]" size = { 167 40 } enabled = "[GetScriptedGui('sakuya_check_country_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = "SAKUYA_AI_PERSONALITY_APPLY_TT" text_single = { size = { 159 34 } parentanchor = center autoresize = no maximumsize = { 159 34 } fontsize = 14 fontsize_min = 10 align = center|nobaseline elide = right text = "SAKUYA_AI_PERSONALITY_APPLY_TARGET" } onclick = "[GetScriptedGui('sakuya_ai_personality_target_friendly').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
                }
            }
        }
    }
}

sakuya_ai_personality_window = {
    datacontext = "[GetPlayer]"
}
