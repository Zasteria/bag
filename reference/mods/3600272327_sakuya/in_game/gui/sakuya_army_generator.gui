types SakuyaArmyGeneratorTypes
{
    type sakuya_army_generator_window = window {
        name = "sakuya_army_generator_window"
        block "window_position" {
            parentanchor = center
            position = { 0 0 }
        }
        size = { 1200 720 }
        movable = yes
        allow_outside = yes
        visible = "[GetVariableSystem.Exists('sakuya_show_army_generator_window')]"
        enabled = "[GetVariableSystem.Exists('sakuya_show_army_generator_window')]"

        widget = {
            size = { 100% 100% }
            using = bg_window_default_alt
            allow_outside = yes

            widget = {
                parentanchor = right
                position = { -5 5 }
                size = { 40 40 }
                ui_direction_button_holder_right = {}
                button_close_alt = {
                    blockoverride "close_on_action" {
                        on_action = "[GetVariableSystem.Set('sakuya_main_visible', 'yes')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_show_army_generator_window')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_army_generator_domain')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_army_generator_category')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_army_generator_unit')]"
                    }
                }
            }

            vbox = {
                using = window_margin_alt
                spacing = 5

                window_header_alt = {
                    blockoverride "header_text" {
                        text = "SAKUYA_ARMY_GENERATOR_TITLE"
                    }
                }

                header_main_tabs = {
                    blockoverride "content" {
                        button_main_tab_alt = {
                            using = layoutpolicy_expanding
                            text = "SAKUYA_ARMY_GENERATOR_LAND"
                            onclick = "[GetVariableSystem.Set('sakuya_army_generator_domain', 'land')]"
                            onclick = "[GetVariableSystem.Set('sakuya_army_generator_category', 'army_light_infantry')]"
                            onclick = "[GetVariableSystem.Clear('sakuya_army_generator_unit')]"
                            down = "[GetVariableSystem.HasValue('sakuya_army_generator_domain', 'land')]"
                        }
                        button_main_tab_alt = {
                            using = layoutpolicy_expanding
                            text = "SAKUYA_ARMY_GENERATOR_NAVY"
                            onclick = "[GetVariableSystem.Set('sakuya_army_generator_domain', 'navy')]"
                            onclick = "[GetVariableSystem.Set('sakuya_army_generator_category', 'navy_galley')]"
                            onclick = "[GetVariableSystem.Clear('sakuya_army_generator_unit')]"
                            down = "[GetVariableSystem.HasValue('sakuya_army_generator_domain', 'navy')]"
                        }
                    }
                }

                widget = {
                    size = { 1140 390 }
                    using = bg_main_inner_alt

