types SakuyaRenameDynastyTypes
{
	type sakuya_change_dynasty_name_window = window {
		name = "sakuya_change_dynasty_name_window"
		parentanchor = center
		allow_outside = yes
		size = { 400 300 }
		position = { 0 0 }
		visible = "[GetVariableSystem.Exists('sakuya_show_rename_dynasty_window')]"

		vbox = {
			block "msg_size" {
				minimumsize = { 600 300 }
				maximumsize = { 600 300 }
			}
			set_parent_size_to_minimum = yes
			using = snd_UI_popup_show

			vbox = {
				using = layoutpolicy_expanding
				bottomtotop = yes

				vbox = {
					margin = { 5 15 }
					spacing = 10
					using = layoutpolicy_expanding
					using = bg_age_event_inner
					using = bg_age_event_frame

					widget = {
						allow_outside = yes

						block "desc_spacing" {
							size = { 1 1 }
						}
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 30 0 }
						spacing = 10

						block "message_template_content" {
							hbox = {
								layoutpolicy_horizontal = expanding
								margin = { 5 0 }
								using = message_text_box_background
								visible = yes

								editbox_single = {
									size = { 300 30 }

									blockoverride "editbox_label" {
										text = "SAKUYA_CHANGE_DYNASTY_NAME_INPUT"
									}

									blockoverride "editbox_properties" {
										name = "new_dynasty_name"
										tooltipwidget = {
											LeftClickButtonTooltip = {
												blockoverride "onclick_text" {
													text = "SAKUYA_CHANGE_DYNASTY_NAME_INPUT_TT"
												}
											}
										}
										ontextchanged = "[GetVariableSystem.Set('sakuya_dynasty_name_input', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
										ontextchanged = "[GetVariableSystem.Set('sakuya_new_dynasty_name_1', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
										ontextchanged = "[GetVariableSystem.Set('sakuya_new_dynasty_name_2', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
										ontextchanged = "[GetVariableSystem.Set('sakuya_new_dynasty_name_3', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
										ontextchanged = "[GetVariableSystem.Set('sakuya_new_dynasty_name_4', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
										ontextchanged = "[GetVariableSystem.Set('sakuya_new_dynasty_name_5', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
										ontextchanged = "[GetVariableSystem.Set('sakuya_new_dynasty_name_6', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
										ontextchanged = "[GetVariableSystem.Set('sakuya_new_dynasty_name_7', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
										ontextchanged = "[GetVariableSystem.Set('sakuya_new_dynasty_name_8', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
										ontextchanged = "[GetVariableSystem.Set('sakuya_new_dynasty_name_9', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
										ontextchanged = "[GetVariableSystem.Set('sakuya_new_dynasty_name_10', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
										maxcharacters = 42
									}
								}
							}
						}

						textbox = {
							using = text_multi_template
							margin = { 35 0 }
							fontsize = 16
							fontsize_min = 10
							align = center
							default_format = "#low"
							text = "SAKUYA_CHANGE_DYNASTY_NAME_SUBTITLE"
						}

						textbox = {
							using = text_multi_template
							margin = { 35 0 }
							fontsize = 14
							fontsize_min = 10
							align = center
							default_format = "#n"
							visible = "[Not(GetScriptedGui('sakuya_dynasty_rename_any_slot_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
							text = "SAKUYA_CHANGE_DYNASTY_NAME_UNAVAILABLE"
						}
					}

					hbox = {
						margin = { 0 10 }
						spacing = 50

						block "message_template_buttons" {
							button_regular_diamond = {
								name = "decline_dynasty_button"
								tooltip = "SAKUYA_CHANGE_DYNASTY_NAME_DECLINE_TT"
								text = "MESSAGEPOPUP_DECLINE"
								using = button_resize_to_fit_text
								using = snd_UI_close

								block "decline_title" {
									text = "CANCEL_BUTTON"
								}

								onclick = "[GetScriptedGui('sakuya_clear_dynasty_rename_window_state').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('sakuya_show_rename_dynasty_window')]"
								onclick = "[GetVariableSystem.Clear('sakuya_dynasty_name_input')]"
								onclick = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
							}

							button_regular_diamond = {
								visible = "[GetScriptedGui('sakuya_dynasty_rename_slot_1_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								enabled = "[And(GetVariableSystem.Exists('sakuya_dynasty_name_input'), GetScriptedGui('sakuya_dynasty_rename_slot_1_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
								name = "accept_dynasty_button_1"
								tooltip = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT_TT"
								text = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT"
								using = button_resize_to_fit_text
								using = snd_UI_popup_confirm
								onclick = "[GetScriptedGui('sakuya_apply_dynasty_rename').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('sakuya_clear_dynasty_rename_window_state').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('sakuya_show_rename_dynasty_window')]"
								onclick = "[GetVariableSystem.Clear('sakuya_dynasty_name_input')]"
								onclick = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
								input_action = "confirm"
								use_global_input_instance = yes
							}

							button_regular_diamond = {
								visible = "[GetScriptedGui('sakuya_dynasty_rename_slot_2_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								enabled = "[And(GetVariableSystem.Exists('sakuya_dynasty_name_input'), GetScriptedGui('sakuya_dynasty_rename_slot_2_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
								name = "accept_dynasty_button_2"
								tooltip = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT_TT"
								text = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT"
								using = button_resize_to_fit_text
								using = snd_UI_popup_confirm
								onclick = "[GetScriptedGui('sakuya_apply_dynasty_rename').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('sakuya_clear_dynasty_rename_window_state').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('sakuya_show_rename_dynasty_window')]"
								onclick = "[GetVariableSystem.Clear('sakuya_dynasty_name_input')]"
								onclick = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
								input_action = "confirm"
								use_global_input_instance = yes
							}

							button_regular_diamond = {
								visible = "[GetScriptedGui('sakuya_dynasty_rename_slot_3_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								enabled = "[And(GetVariableSystem.Exists('sakuya_dynasty_name_input'), GetScriptedGui('sakuya_dynasty_rename_slot_3_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
								name = "accept_dynasty_button_3"
								tooltip = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT_TT"
								text = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT"
								using = button_resize_to_fit_text
								using = snd_UI_popup_confirm
								onclick = "[GetScriptedGui('sakuya_apply_dynasty_rename').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('sakuya_clear_dynasty_rename_window_state').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('sakuya_show_rename_dynasty_window')]"
								onclick = "[GetVariableSystem.Clear('sakuya_dynasty_name_input')]"
								onclick = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
								input_action = "confirm"
								use_global_input_instance = yes
							}

							button_regular_diamond = {
								visible = "[GetScriptedGui('sakuya_dynasty_rename_slot_4_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								enabled = "[And(GetVariableSystem.Exists('sakuya_dynasty_name_input'), GetScriptedGui('sakuya_dynasty_rename_slot_4_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
								name = "accept_dynasty_button_4"
								tooltip = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT_TT"
								text = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT"
								using = button_resize_to_fit_text
								using = snd_UI_popup_confirm
								onclick = "[GetScriptedGui('sakuya_apply_dynasty_rename').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('sakuya_clear_dynasty_rename_window_state').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('sakuya_show_rename_dynasty_window')]"
								onclick = "[GetVariableSystem.Clear('sakuya_dynasty_name_input')]"
								onclick = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
								input_action = "confirm"
								use_global_input_instance = yes
							}

							button_regular_diamond = {
								visible = "[GetScriptedGui('sakuya_dynasty_rename_slot_5_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								enabled = "[And(GetVariableSystem.Exists('sakuya_dynasty_name_input'), GetScriptedGui('sakuya_dynasty_rename_slot_5_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
								name = "accept_dynasty_button_5"
								tooltip = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT_TT"
								text = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT"
								using = button_resize_to_fit_text
								using = snd_UI_popup_confirm
								onclick = "[GetScriptedGui('sakuya_apply_dynasty_rename').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('sakuya_clear_dynasty_rename_window_state').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('sakuya_show_rename_dynasty_window')]"
								onclick = "[GetVariableSystem.Clear('sakuya_dynasty_name_input')]"
								onclick = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
								input_action = "confirm"
								use_global_input_instance = yes
							}

							button_regular_diamond = {
								visible = "[GetScriptedGui('sakuya_dynasty_rename_slot_6_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								enabled = "[And(GetVariableSystem.Exists('sakuya_dynasty_name_input'), GetScriptedGui('sakuya_dynasty_rename_slot_6_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
								name = "accept_dynasty_button_6"
								tooltip = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT_TT"
								text = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT"
								using = button_resize_to_fit_text
								using = snd_UI_popup_confirm
								onclick = "[GetScriptedGui('sakuya_apply_dynasty_rename').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('sakuya_clear_dynasty_rename_window_state').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('sakuya_show_rename_dynasty_window')]"
								onclick = "[GetVariableSystem.Clear('sakuya_dynasty_name_input')]"
								onclick = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
								input_action = "confirm"
								use_global_input_instance = yes
							}

							button_regular_diamond = {
								visible = "[GetScriptedGui('sakuya_dynasty_rename_slot_7_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								enabled = "[And(GetVariableSystem.Exists('sakuya_dynasty_name_input'), GetScriptedGui('sakuya_dynasty_rename_slot_7_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
								name = "accept_dynasty_button_7"
								tooltip = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT_TT"
								text = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT"
								using = button_resize_to_fit_text
								using = snd_UI_popup_confirm
								onclick = "[GetScriptedGui('sakuya_apply_dynasty_rename').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('sakuya_clear_dynasty_rename_window_state').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('sakuya_show_rename_dynasty_window')]"
								onclick = "[GetVariableSystem.Clear('sakuya_dynasty_name_input')]"
								onclick = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
								input_action = "confirm"
								use_global_input_instance = yes
							}

