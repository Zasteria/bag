								enabled = "[And(GetVariableSystem.Exists('sakuya_dynasty_name_input'), GetScriptedGui('sakuya_dynasty_rename_slot_10_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
								name = "accept_dynasty_button_10"
