								enabled = "[And(GetVariableSystem.Exists('sakuya_dynasty_name_input'), GetScriptedGui('sakuya_dynasty_rename_slot_8_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
								name = "accept_dynasty_button_8"
								tooltip = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT_TT"
								text = "SAKUYA_CHANGE_DYNASTY_NAME_ACCEPT"
								using = button_resize_to_fit_text
								using = snd_UI_popup_confirm
