								onclick = "[GetScriptedGui('sakuya_clear_dynasty_rename_window_state').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetVariableSystem.Clear('sakuya_show_rename_dynasty_window')]"
