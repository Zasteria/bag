types SakuyaChangeNameCharTypes
{
    type sakuya_change_name_char_window = window {
        name = "sakuya_change_name_char_window"
        parentanchor = center
        allow_outside = yes
        size = { 400 300 }
        position = { 0 0 }
        visible = "[GetVariableSystem.Exists('sakuya_show_rename_char_window')]"
        vbox = {
            block "msg_size" {
                minimumsize = { 600 300 }
                maximumsize = { 600 300 }
            }
            set_parent_size_to_minimum = yes
            using = snd_UI_popup_show

            vbox = {
                using = layoutpolicy_expanding
                bottomtotop = yes

                vbox = {
                    margin = {5 15}
                    spacing = 10
                    using = layoutpolicy_expanding
                    using = bg_age_event_inner
                    using = bg_age_event_frame

                    widget = {
                        allow_outside = yes

                        block "desc_spacing" {
                            size = { 1 1 }
                        }
                    }

                    vbox = {
                        layoutpolicy_horizontal = expanding
                        margin = {30 0}
                        spacing = 10

                        # 单一输入框
                        block "message_template_content" {
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                margin = {5 0}
                                using = message_text_box_background
                                visible = yes

                                editbox_single = {
                                    size = { 300 30 }

                                    blockoverride "editbox_label" {
                                        text = "SAKUYA_CHANGE_CHAR_NAME_INPUT"
                                    }

                                    blockoverride "editbox_properties" {
                                        name = "new_char_name"
                                        tooltipwidget = {
                                            LeftClickButtonTooltip = {
                                                blockoverride "onclick_text" { text = "SAKUYA_CHANGE_CHAR_NAME_INPUT_TT" }
                                            }
                                        }
                                        ontextchanged = "[GetVariableSystem.Set('sakuya_char_new_name', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self))]"
                                        maxcharacters = 32
                                    }
                                }
                            }
                        }
                    }

                    hbox = {
                        margin = { 0 10 }
                        spacing = 20

                        block "message_template_buttons" {
                            # 取消按钮
                            button_regular_diamond = {
                                name = "decline_button"
                                tooltip = "SAKUYA_CHANGE_CHAR_NAME_MESSAGEPOPUP_DECLINE_TT"
                                text = "MESSAGEPOPUP_DECLINE"
                                using = button_resize_to_fit_text
                                using = snd_UI_close

                                block "decline_title" {
                                    text = "CANCEL_BUTTON"
                                }
                                onclick = "[GetVariableSystem.Clear('sakuya_show_rename_char_window')]"
                                onclick = "[GetVariableSystem.Clear('sakuya_char_new_name')]"
                                onclick = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
                            }

                            # 改名字按钮
                            button_regular_diamond = {
                                enabled = "[GetVariableSystem.Exists('sakuya_char_new_name')]"
                                name = "set_first_name_button"
                                tooltip = "SAKUYA_CHANGE_CHAR_NAME_FIRST_NAME_TT"
                                text = "SAKUYA_CHANGE_CHAR_SET_FIRST_NAME"
                                using = button_resize_to_fit_text
                                using = snd_UI_popup_confirm
                                onclick = "[ExecuteConsoleCommand( Concatenate( 'effect every_country = { every_character = { limit = { has_variable = sakuya_the_chosen_one } set_first_name = \"', Concatenate( GetVariableSystem.Get('sakuya_char_new_name'), '\" } }' ) ) )]"
                                onclick = "[GetVariableSystem.Clear('sakuya_show_rename_char_window')]"
                                onclick = "[GetVariableSystem.Clear('sakuya_char_new_name')]"
                                onclick = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
                                use_global_input_instance = yes
                            }

                            # 改绰号按钮
                            button_regular_diamond = {
                                enabled = "[GetVariableSystem.Exists('sakuya_char_new_name')]"
                                name = "set_nickname_button"
                                tooltip = "SAKUYA_CHANGE_CHAR_NAME_NICKNAME_TT"
                                text = "SAKUYA_CHANGE_CHAR_SET_NICKNAME"
                                using = button_resize_to_fit_text
                                using = snd_UI_popup_confirm
                                input_action = "confirm"
                                onclick = "[ExecuteConsoleCommand( Concatenate( 'effect every_country = { every_character = { limit = { has_variable = sakuya_the_chosen_one } set_nickname = \"', Concatenate( GetVariableSystem.Get('sakuya_char_new_name'), '\" } }' ) ) )]"
                                onclick = "[GetVariableSystem.Clear('sakuya_show_rename_char_window')]"
                                onclick = "[GetVariableSystem.Clear('sakuya_char_new_name')]"
                                onclick = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
                            }

                        }
                    }
                }

                hbox = {
                    using = bg_age_event_title
                    layoutpolicy_horizontal = expanding

                    blockoverride "bg_event_title_texture" {
                        texture = "gfx/interface/component_tiles/bg_big_round_corners_up.dds"
                        texture_density = 2
                        spriteType = corneredstretched
                        spriteBorder = { 40 40 }
                        margin = {3 0}
                        margin_bottom = -2
                    }

                    widget = {
                        layoutpolicy_vertical = expanding
                        size = {5 -1}

                        AgeEventDecorationTop = {
                            size = {64 52}
                            position = { -10 -2 }
                            parentanchor = left|top
                            widgetanchor = top
                        }

                        AgeEventDecorationTop2 = {
                            parentanchor = left|bottom
                            position = {-4 15}
                            mirror = horizontal
                        }
                    }

                    hbox = {
                        layoutpolicy_horizontal = expanding
                        margin = { 40 20 }
                        spacing = 15

                        block "message_decoration_left" {}

                        block "message_title_content" {
                            hbox = {
                                vbox = {
                                    textbox = {
                                        using = text_multi_template
                                        name = "subtitle"
                                        autoresize = yes
                                        fontsize = 19
                                        default_format = "#subtle_name"
                                        align = center
                                        text = "SAKUYA_CHANGE_CHAR_NAME_TITLE"
                                    }

                                    textbox = {
                                        using = text_multi_template
                                        autoresize = yes
                                        default_format = "#yellow_titles"
                                        fontsize = 22
                                        align = center|nobaseline
                                        text = "SAKUYA_CHANGE_CHAR_NAME_SUBTITLE"
                                    }
                                }
                            }
                        }

                        block "message_decoration_right" {}
                    }
        
                    widget = {
                        layoutpolicy_vertical = expanding
                        size = {5 -1}

                        AgeEventDecorationTop = {
                            size = {64 52}
                            position = { -10 -2 }
                            parentanchor = left|top
                            widgetanchor = top
                        }

                        AgeEventDecorationTop2 = {
                            parentanchor = left|bottom
                            position = {-4 15}
                            mirror = horizontal
                        }
                    }
                }
            }
        }
        widget = { #sakuya_watching 装饰图标 鼠标穿透
            parentanchor = center|top
            position = { -200 -90 }
            size = { 103 120 }
            alwaystransparent = yes
            filter_mouse = none
            allow_outside = yes

            icon = {
                size = { 103 120 }
                texture = "gfx/interface/sakuya/sakuya_watching.png"
                alwaystransparent = yes
            }
        }
    }
}

sakuya_change_name_char_window = {
    datacontext = "[GetPlayer]"
}
