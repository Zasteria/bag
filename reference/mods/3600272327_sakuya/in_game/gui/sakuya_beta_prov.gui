types Sakuyabeta_provTypes
{
    # ========================================
    # beta_prov - 地区模式（地区 → 省份）
    # 结构：地区作为折叠头部，展开显示该地区的省份
    # ========================================
    type sakuya_beta_prov_window = window {
        name = "sakuya_beta_prov_window"
        parentanchor = center
        position = { 0 0 }
        size = { 800 780 }
        movable = yes
        allow_outside = yes

        visible = "[GetVariableSystem.Exists('sakuya_beta_prov_visible')]"

        widget = {
            size = { 100% 100% }
            using = bg_window_default_alt

            widget = {
                parentanchor = right
                position = { -5 5 }
                size = { 40 40 }
                ui_direction_button_holder_right = {}

                button_close_alt = {
                    blockoverride "close_on_action" {
                        on_action = "[GetVariableSystem.Clear('sakuya_beta_visible')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_beta_prov_visible')]"
                        on_action = "[GetVariableSystem.Toggle('sakuya_location_visible')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_exp_area')]"
                    }
                }
            }

            vbox = {
                using = window_margin_alt

                window_header_alt = {
                    blockoverride "header_text" {
                        text = "SAKUYA_BETA_PROV_TITLE"
                    }
                }

                # 标题
                hbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 5 }
                    spacing = 10

                    text_single = {
                        autoresize = yes
                        text = "SAKUYA_BETA_AREA_MODE"
                        using = Font_Size_Medium
                    }

                    expand = {}

                    # 全部展开
                    button_regular = {
                        size = { 100 28 }
                        onclick = "[GetVariableSystem.Set('sakuya_expand_all_area', 'yes')]"
                        tooltip = "SAKUYA_BETA_EXPAND_ALL_TT"

                        text_single = {
                            parentanchor = center
                            autoresize = yes
                            text = "SAKUYA_BETA_EXPAND_ALL"
                            using = Font_Size_Small
                        }
                    }

                    # 全部折叠
                    button_regular = {
                        size = { 100 28 }
                        onclick = "[GetVariableSystem.Clear('sakuya_expand_all_area')]"
                        onclick = "[GetVariableSystem.Clear('sakuya_exp_area')]"
                        tooltip = "SAKUYA_BETA_COLLAPSE_ALL_TT"

                        text_single = {
                            parentanchor = center
                            autoresize = yes
                            text = "SAKUYA_BETA_COLLAPSE_ALL"
                            using = Font_Size_Small
                        }
                    }
                }

                #divider_flavor_01 = {}

                # 主内容区
                scrollbox = {
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding

                    blockoverride "scrollbox_content" {
                        vbox = {
                            layoutpolicy_horizontal = expanding
                            spacing = 2
                            margin = { 5 5 }

                            datamodel = "[Player.GetProvinces]"

                            item = {
                                sakuya_beta_area_entry = {}
                            }
                        }
                    }
                }

                # 底部操作栏
                hbox = {
                    layoutpolicy_horizontal = expanding
                    margin = { 10 8 }
                    spacing = 10

                    button_regular = {
                        size = { 150 35 }
                        onclick = "[GetScriptedGui('sakuya_beta_mark_all_locations').Execute(GuiScope.SetRoot(Player.MakeScope).End)]"
                        tooltip = "SAKUYA_BETA_MARK_ALL_TT"

                        text_single = {
                            parentanchor = center
                            autoresize = yes
                            text = "SAKUYA_BETA_MARK_ALL_GLOBAL"
                            using = Font_Size_Small
                        }
                    }

                    button_regular = {
                        size = { 150 35 }
                        onclick = "[GetScriptedGui('sakuya_beta_unmark_all_locations').Execute(GuiScope.SetRoot(Player.MakeScope).End)]"
                        tooltip = "SAKUYA_BETA_UNMARK_ALL_TT"

                        text_single = {
                            parentanchor = center
                            autoresize = yes
                            text = "SAKUYA_BETA_UNMARK_ALL_GLOBAL"
                            using = Font_Size_Small
                        }
                    }

                    expand = {}
                }
            }
        }
    }

    # ========================================
    # 地区条目 - 扁平化列表，每行显示 地区 › 省份
    # 点击展开同地区所有省份的操作按钮
    # ========================================
    type sakuya_beta_area_entry = widget {
        layoutpolicy_horizontal = expanding
        size = { -1 36 }

        using = bg_paper_card

        # 点击整行切换展开状态
        button = {
            size = { 100% 100% }
            onclick = "[GetVariableSystem.Set('sakuya_exp_area', Province.GetCapital.GetArea.GetNameWithNoTooltip)]"
            visible = "[And(Not(EqualTo_string(GetVariableSystem.Get('sakuya_exp_area'), Province.GetCapital.GetArea.GetNameWithNoTooltip)), Not(GetVariableSystem.Exists('sakuya_expand_all_area')))]"
        }
        button = {
            size = { 100% 100% }
            onclick = "[GetVariableSystem.Clear('sakuya_exp_area')]"
            visible = "[Or(EqualTo_string(GetVariableSystem.Get('sakuya_exp_area'), Province.GetCapital.GetArea.GetNameWithNoTooltip), GetVariableSystem.Exists('sakuya_expand_all_area'))]"
        }

        hbox = {
            layoutpolicy_horizontal = expanding
            margin = { 10 0 }
            spacing = 8

            # 折叠/展开按钮
            button_square_plus = {
                size = { 22 22 }
                parentanchor = vcenter
                visible = "[And(Not(EqualTo_string(GetVariableSystem.Get('sakuya_exp_area'), Province.GetCapital.GetArea.GetNameWithNoTooltip)), Not(GetVariableSystem.Exists('sakuya_expand_all_area')))]"
                onclick = "[GetVariableSystem.Set('sakuya_exp_area', Province.GetCapital.GetArea.GetNameWithNoTooltip)]"
            }
            button_square_minus = {
                size = { 22 22 }
                parentanchor = vcenter
                visible = "[Or(EqualTo_string(GetVariableSystem.Get('sakuya_exp_area'), Province.GetCapital.GetArea.GetNameWithNoTooltip), GetVariableSystem.Exists('sakuya_expand_all_area'))]"
                onclick = "[GetVariableSystem.Clear('sakuya_exp_area')]"
            }

            # 地区名称
            text_single = {
                autoresize = yes
                text = "[Province.GetCapital.GetArea.GetNameWithNoTooltip]"
                using = Font_Size_Small
                default_format = "#bold"
                parentanchor = vcenter
            }

            # 分隔符
            text_single = {
                autoresize = yes
                raw_text = "›"
                using = Font_Size_Small
                default_format = "#weak"
                parentanchor = vcenter
            }

            # 省份名称
            text_single = {
                autoresize = yes
                text = "[Province.GetName]"
                using = Font_Size_Small
                parentanchor = vcenter
            }

            # 地点数量（展开时显示）
            text_single = {
                autoresize = yes
                text = "SAKUYA_BETA_PROVINCE_LOCATION_COUNT"
                using = Font_Size_Small
                default_format = "#weak"
                parentanchor = vcenter
                visible = "[Or(EqualTo_string(GetVariableSystem.Get('sakuya_exp_area'), Province.GetCapital.GetArea.GetNameWithNoTooltip), GetVariableSystem.Exists('sakuya_expand_all_area'))]"
            }

            expand = {}

            # 标记该省份所有地点（展开时显示）
            button_regular = {
                size = { 90 26 }
                parentanchor = vcenter
                visible = "[Or(EqualTo_string(GetVariableSystem.Get('sakuya_exp_area'), Province.GetCapital.GetArea.GetNameWithNoTooltip), GetVariableSystem.Exists('sakuya_expand_all_area'))]"
                enabled = "[GetScriptedGui('sakuya_beta_mark_province_all').IsValid(GuiScope.SetRoot(Province.MakeScope).End)]"
                onclick = "[GetScriptedGui('sakuya_beta_mark_province_all').Execute(GuiScope.SetRoot(Province.MakeScope).End)]"
                tooltip = "SAKUYA_BETA_MARK_PROVINCE_ALL_TT"

                text_single = {
                    parentanchor = center
                    autoresize = yes
                    text = "SAKUYA_BETA_MARK_ALL_BUTTON"
                    using = Font_Size_Small
                }
            }

            # 取消标记（展开时显示）
            button_regular = {
                size = { 90 26 }
                parentanchor = vcenter
                visible = "[Or(EqualTo_string(GetVariableSystem.Get('sakuya_exp_area'), Province.GetCapital.GetArea.GetNameWithNoTooltip), GetVariableSystem.Exists('sakuya_expand_all_area'))]"
                enabled = "[GetScriptedGui('sakuya_beta_unmark_province_all').IsValid(GuiScope.SetRoot(Province.MakeScope).End)]"
                onclick = "[GetScriptedGui('sakuya_beta_unmark_province_all').Execute(GuiScope.SetRoot(Province.MakeScope).End)]"
                tooltip = "SAKUYA_BETA_UNMARK_PROVINCE_ALL_TT"

                text_single = {
                    parentanchor = center
                    autoresize = yes
                    text = "SAKUYA_BETA_UNMARK_ALL_BUTTON"
                    using = Font_Size_Small
                }
            }
        }
    }
}

sakuya_beta_prov_window = {
    datacontext = "[GetPlayer]"
}
