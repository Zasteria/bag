types SakuyaBetaTypes
{
    type sakuya_location_window = window {
        name = "sakuya_location_window"
        datacontext = "[Player]"
        parentanchor = center
        position = { 0 0 }
        size = { 1600 900 }
        movable = yes
        allow_outside = yes
        visible = "[GetVariableSystem.Exists('sakuya_location_visible')]"
        widget = {
            size = { 100% 100% }
            using = bg_window_default_alt
            widget = {
                parentanchor = right
                position = { -5 5 }
                size = { 40 40 }
                ui_direction_button_holder_right = {}

                button_close_alt = {
                    blockoverride "close_on_action" {
                        on_action = "[GetVariableSystem.Clear('sakuya_location_visible')]"
                        on_action = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
                    }
                }
            }

            vbox = {
                using = window_margin_alt
                window_header_alt = {
                    blockoverride "header_text" {
                        text = "SAKUYA_LOC_TITLE"
                    }
                }
                widget = {
                    using = layoutpolicy_expanding

                    # 背景图片
                    icon = {
                        size = { 100% 100% }
                        texture = "gfx/interface/sakuya/l/wood.png"
                        alpha = 0.7
                    }

                    widget = {
                        size = { 1000 65 }
                        position = { 30 6 }
                        text_single = {
                            using = Font_Type_Headers
                            fontsize = 56
                            text = "SAKUYA_LOC_1_TITLE"
                            position = { 0 0 }
                        }
                    }

                    widget = { #标识背景
                        size = { 537 727 }
                        position = { 1050 115 }
                        block "trait_background" {
                            icon = {
                                parentanchor = center
                                size = { 80% 97% }
                                texture = "gfx/interface/sakuya/l/b1.png"
                                texture_density = 2
                            }
                        }
                    }
                    widget = { #分页选项卡
                        position = { 920 10 }
                        size = { 640 120 }
                        hbox = {
                            spacing = 2

                            # Tab 1: 首页
                            widget = {
                                size = { 160 80 }
                                button = {
                                    texture = "gfx/interface/sakuya/l/card.png"
                                    size = { 100% 100% }
                                    onclick = "[GetVariableSystem.Set('sakuya_loc_tab', 'home')]"
                                    tooltip = "SAKUYA_LOC_TAB_HOME_TT"

                                    text_single = {
                                        parentanchor = center
                                        autoresize = yes
                                        using = Font_Type_Headers
                                        text = "SAKUYA_LOC_TAB_HOME"
                                        fontsize = 20
                                    }
                                }
                            }

                            # Tab 2: 人口
                            widget = {
                                size = { 160 80 }
                                button = {
                                    texture = "gfx/interface/sakuya/l/card.png"
                                    size = { 100% 100% }
                                    onclick = "[GetVariableSystem.Set('sakuya_loc_tab', 'population')]"
                                    tooltip = "SAKUYA_LOC_TAB_POP_TT"

                                    text_single = {
                                        parentanchor = center
                                        autoresize = yes
                                        using = Font_Type_Headers
                                        text = "SAKUYA_LOC_TAB_POP"
                                        fontsize = 20
                                    }
                                }
                            }

                            # Tab 3: 修正
                            widget = {
                                size = { 160 80 }
                                button = {
                                    texture = "gfx/interface/sakuya/l/card.png"
                                    size = { 100% 100% }
                                    onclick = "[GetVariableSystem.Set('sakuya_loc_tab', 'modifiers')]"
                                    tooltip = "SAKUYA_LOC_TAB_MOD_TT"

                                    text_single = {
                                        parentanchor = center
                                        autoresize = yes
                                        using = Font_Type_Headers
                                        text = "SAKUYA_LOC_TAB_MOD"
                                        fontsize = 20
                                    }
                                }
                            }

                            # Tab 4: 建筑
                            widget = {
                                size = { 160 80 }
                                button = {
                                    texture = "gfx/interface/sakuya/l/card.png"
                                    size = { 100% 100% }
                                    onclick = "[GetVariableSystem.Set('sakuya_loc_tab', 'buildings')]"
                                    tooltip = "SAKUYA_1_6_LOC_TAB_BUILDINGS_TT"

                                    text_single = {
                                        parentanchor = center
                                        autoresize = yes
                                        using = Font_Type_Headers
                                        text = "SAKUYA_1_6_LOC_TAB_BUILDINGS"
                                        fontsize = 20
                                    }
                                }
                            }
                        }
                    }
                    widget = { #分类器 #顶部装饰
                        size = { 100% 40 }
                        position = { 00 88 }
                        icon = {
                            texture = "gfx/interface/sakuya/l/t1.png"
                            size = { 101% 100% }
                            parentanchor = center
                            #position = { 0 4 }
                        }
                    }
                    widget = { #默认展示
                        position = { 1087 528 }
                        size = { 460 300 }
                        icon = {
                            texture = "gfx/interface/sakuya/l/null_mode.png"
                            size = { 100% 100% }
                            parentanchor = center
                            #position = { 0 4 }
                        }
                    }
                    widget = {
                        position = { 1057 200 }
                        size = { 520 150 }
                        vbox = {
                            spacing = 5 # Space between the buttons
                            hbox = {
                                spacing = 6
                                button_wax = {
                                    name = "sakuya_location_all_mode_button"
                                    size = { 196 45 }
                                    onclick = "[GetScriptedGui('sakuya_beta_mark_all_locations').Execute(GuiScope.SetRoot(Player.MakeScope).End)]"
                                    onmousehierarchyenter = "[PdxGuiWidget.FindChild('sakuya_location_all_mode_hover').InterruptThenTriggerAnimation('hide_hover','show_hover')]"
                                    onmousehierarchyleave = "[PdxGuiWidget.FindChild('sakuya_location_all_mode_hover').InterruptThenTriggerAnimation('show_hover','hide_hover')]"
                                    blockoverride "button_texture" {
                                        texture = "gfx/interface/buttons/button_wax_yellow.dds"
                                    }
                                    tooltip = "SAKUYA_LOC_LOCATION_ALL_MODE_BUTTON_TT"
                                    text_single = {
                                        fontsize = 17
                                        parentanchor = center
                                        autoresize = yes
                                        text = "SAKUYA_LOC_LOCATION_ALL_MODE_BUTTON"
                                    }
                                    widget = {
                                        name = "sakuya_location_all_mode_hover"
                                        size = { 100% 100% }
                                        alpha = 0
                                        allow_outside = yes
                                        state = {
                                            name = show_hover
                                            duration = 0.15
                                            alpha = 1
                                            using = Animation_Curve_Default
                                        }

                                        state = {
                                            name = hide_hover
                                            duration = 0.15
                                            alpha = 0
                                            using = Animation_Curve_Default
                                        }
                                        icon = {
                                            parentanchor = center
                                            position = { 101 454 }
                                            size = { 460 300 }
                                            texture = "gfx/interface/sakuya/l/all_mode.png"
                                        }
                                    }
                                }
                                button_wax = {
                                    name = "sakuya_location_remove_all_mode_button"
                                    size = { 196 45 }
                                    onclick = "[GetScriptedGui('sakuya_beta_unmark_all_locations').Execute(GuiScope.SetRoot(Player.MakeScope).End)]"
                                    onmousehierarchyenter = "[PdxGuiWidget.FindChild('sakuya_location_remove_all_mode_hover').InterruptThenTriggerAnimation('hide_hover','show_hover')]"
                                    onmousehierarchyleave = "[PdxGuiWidget.FindChild('sakuya_location_remove_all_mode_hover').InterruptThenTriggerAnimation('show_hover','hide_hover')]"
                                    blockoverride "button_texture" {
                                        texture = "gfx/interface/buttons/button_wax_yellow.dds"
                                    }
                                    tooltip = "SAKUYA_LOC_LOCATION_REMOVE_ALL_MODE_BUTTON_TT"
                                    text_single = {
                                        fontsize = 17
                                        parentanchor = center
                                        autoresize = yes
                                        text = "SAKUYA_LOC_LOCATION_REMOVE_ALL_MODE_BUTTON"
                                    }
                                    widget = {
                                        name = "sakuya_location_remove_all_mode_hover"
                                        size = { 100% 100% }
                                        alpha = 0
                                        allow_outside = yes
                                        state = {
                                            name = show_hover
                                            duration = 0.15
                                            alpha = 1
                                            using = Animation_Curve_Default
                                        }

                                        state = {
                                            name = hide_hover
                                            duration = 0.15
                                            alpha = 0
                                            using = Animation_Curve_Default
                                        }
                                        icon = {
                                            parentanchor = center
                                            position = { -101 454 }
                                            size = { 460 300 }
                                            texture = "gfx/interface/sakuya/l/remove_all.png"
                                        }
                                    }
                                }
                            }
                            button_wax = {
                                blockoverride "button_texture" {
                                    texture = "gfx/interface/buttons/button_wax_yellow.dds"
                                }
                                onclick = "[GetVariableSystem.Toggle('sakuya_beta_visible')]"
                                onclick = "[GetVariableSystem.Clear('sakuya_beta_prov_visible')]"
                                onclick = "[GetVariableSystem.Clear('sakuya_location_visible')]"
