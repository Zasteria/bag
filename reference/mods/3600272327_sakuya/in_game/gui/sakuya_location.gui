                                    }
                                    icon = {
                                        parentanchor = center
                                        position = { 0 402 }
                                        size = { 460 300 }
                                        texture = "gfx/interface/sakuya/l/location_mode.png"
                                    }
                                    text_multi = {
                                        parentanchor = center
                                        position = { 0 155 }
