                                onmousehierarchyleave = "[PdxGuiWidget.FindChild('sakuya_location_location_mode_hover').InterruptThenTriggerAnimation('show_hover','hide_hover')]"
                                size = { 400 45 }
                                widget = {
                                    name = "sakuya_location_location_mode_hover"
                                    size = { 100% 100% }
                                    alpha = 0
                                    allow_outside = yes
                                    state = {
                                        name = show_hover
                                        duration = 0.15
                                        alpha = 1
                                        using = Animation_Curve_Default
                                    }

                                    state = {
                                        name = hide_hover
