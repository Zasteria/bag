types SakuyaAlphaTypes
{
    type sakuya_alpha_window = window {
        name = "sakuya_alpha_window"
        parentanchor = center
        position = { 0 0 }
        size = { 1600 900 }
        movable = yes
        allow_outside = yes

        visible = "[GetVariableSystem.Exists('sakuya_alpha_visible')]"
        enabled = "[GetVariableSystem.Exists('sakuya_alpha_visible')]"

        widget = {
            size = { 100% 100% }
            using = bg_window_default_alt

            widget = {
                parentanchor = right
                position = { -5 5 }
                size = { 40 40 }
                ui_direction_button_holder_right = {}

                button_close_alt = {
                    blockoverride "close_on_action" {
                        on_action = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_alpha_visible')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_god_choice')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_god_immortal')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_god_conqueror')]"
                        on_action = "[GetVariableSystem.Clear('sakuya_god_reaper')]"
                    }
                }
            }

            vbox = {
                using = window_margin_alt

                window_header_alt = {
                    alpha = 0.4
                    blockoverride "header_text" {
                        text = "SAKUYA_ALPHA_TITLE" #致敬 巫师3
                    }
                }

                widget = {
                    using = layoutpolicy_expanding

                    icon = { #背景
                        visible = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        size = { 100% 100% }
                        texture = "gfx/interface/sakuya/s/BK.png"
                    }
                    icon = { #背景
                        visible = "[Not(GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
                        size = { 100% 100% }
                        color = { 0.3 0.3 0.3 1 }
                        texture = "gfx/interface/sakuya/s/BK.png"
                    }

                    widget = {
                        visible = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" #talk图标
                        parentanchor = center
                        position = { 100 -120 }
                        size = { 1015 430 }
                        icon = {
                            size = { 100% 100% }
                            texture = "gfx/interface/sakuya/s/talk.png"
                        }
                    }
                    widget = {
                         #默认文本框 
						parentanchor = center
						position = { 200 -110 }
						size = { 600 300 }
						#visible = "[Not(GetVariableSystem.Exists('sakuya_god_choice'))]"
						text_multi = {
                            visible = "[Not(GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
                            parentanchor = center
                            position = { 0 0 }
                            size = { 100% 100% }
                            margin = { 20 20 }
                            autoresize = yes
                            max_width = 600
                            fontsize = 33
                            align = center|nobaseline
                            text = "Sakuya_god_no_character"
                        }
                    }
					widget = {
                        visible = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" #默认文本框 
						parentanchor = center
						position = { 200 -110 }
						size = { 600 300 }
						text_multi = {
                            visible = "[Not(GetVariableSystem.Exists('sakuya_god_choice'))]"
                            parentanchor = center
                            position = { 0 0 }
                            size = { 100% 100% }
                            margin = { 20 20 }
                            autoresize = yes
                            max_width = 600
                            fontsize = 33
                            align = center|nobaseline
                            text = "Sakuya_god_greeting"
                        }
                    }
					widget = { #按钮1 永生
						parentanchor = center
						position = { 200 -110 }
						size = { 600 300 }
						visible = "[EqualTo_string(GetVariableSystem.Get('sakuya_god_choice'),'immortal')]"
                        
                        text_multi = {
                            visible = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                            parentanchor = center
                            position = { 0 0 }
                            size = { 100% 100% }
                            margin = { 20 20 }
                            autoresize = yes
                            max_width = 600
                            fontsize = 33
                            align = center|nobaseline
                            text = "Sakuya_god_immortal_choice"
                        }
                    }
					widget = { #按钮2 战狂
						parentanchor = center
						position = { 200 -110 }
						size = { 600 300 }
						visible = "[EqualTo_string(GetVariableSystem.Get('sakuya_god_choice'),'conqueror')]"
                        
                        text_multi = {
                            visible = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                            parentanchor = center
                            position = { 0 0 }
                            size = { 100% 100% }
                            margin = { 20 20 }
                            autoresize = yes
                            max_width = 600
                            fontsize = 33
                            align = center|nobaseline
                            text = "Sakuya_god_conqueror_choice"
                        }
                    }
					widget = { #按钮3 死了
						parentanchor = center
						position = { 200 -110 }
						size = { 600 300 }
						visible = "[EqualTo_string(GetVariableSystem.Get('sakuya_god_choice'),'reaper')]"
                        
                        text_multi = {
                            visible = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                            parentanchor = center
                            position = { 0 0 }
                            size = { 100% 100% }
                            margin = { 20 20 }
                            autoresize = yes
                            max_width = 600
                            fontsize = 33
                            align = center|nobaseline
                            text = "Sakuya_god_reaper_choice"
                        }
                    }
                    widget = {
                        position = { 100 50 }
                        button = {  #神之背景
                            name = sakuya_battle_of_cats_icon
                            size = { 610 500 }
                            #position = { 500 -100 }
                            texture = "gfx/interface/sakuya/s/god_of_sakuya_alpha.png"
                            alpha = 0.1
                            modify_texture = {
                                name = rotating_layer
                                texture = "gfx/interface/sakuya/s/god_of_sakuya.png"
                                alpha = 100
                                spriteborder = { 0 0 }
                                alwaystransparent = yes
                            }
                            state = {
                                trigger_on_create = yes
                                name = rotate_start
                                next = rotate_end
                                duration = 0.0

                                modify_texture = {
                                    name = rotating_layer
                                    rotate_uv = 0
                                }
                            }
                            state = {
                                name = rotate_end
                                next = rotate_start
                                duration = 12.0

                                modify_texture = {
                                    name = rotating_layer
                                    rotate_uv = 360
                                }
                            }
                        }
                    }
                }
            }
            widget = {
                using = layoutpolicy_expanding

                icon = { #背景
                    size = { 100% 100% }
                    texture = "gfx/interface/sakuya/s/BK.png"
                }
            }

            widget = {
                visible = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                position = { 100 100 }
                icon = {  #神之样子
                    name = sakuya_battle_of_cats_icon2
                    size = { 610 500 }
                    texture = "gfx/interface/sakuya/s/god_of_sakuya.png"
                    
                    state = {
                        trigger_on_create = yes
                        name = 1
                        next = 2

                        duration = 1
                        using = Animation_Curve_Default
                        position = { -10 0 }
                    }
                    state = {
                        name = 2
                        next = 1

                        duration = 1
                        using = Animation_Curve_Default
                        position = { 30 0 }
                    }
                }
            }
        


        widget = { #按钮-中
            parentanchor = center
            size = { 200 200 }
            position = { 0 300 }
            enabled = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" #仅标记角色可见，避免出错和闪退
            icon = {
                size = { 100% 100% }
                texture = "gfx/interface/sakuya/s/current_situation_button_frame.dds"
            }

            button = {
                name = "sakuya_alpha_button_center"
                size = { 100% 100% }
                texture = "gfx/interface/sakuya/s/current_situation_button.dds"
                effectname = "NoHighlight"
                onclick = "[GetVariableSystem.Set('sakuya_god_immortal','yes')]"
                onclick = "[GetVariableSystem.Clear('sakuya_god_conqueror')]"
                onclick = "[GetVariableSystem.Clear('sakuya_god_reaper')]"
                onclick = "[GetVariableSystem.Set('sakuya_god_choice','immortal')]"
                onclick = "[GetScriptedGui('sakuya_alpha_add_immortal').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onrightclick = "[GetVariableSystem.Clear('sakuya_god_immortal')]"
                onrightclick = "[GetVariableSystem.Clear('sakuya_god_choice')]" 
                onrightclick = "[GetScriptedGui('sakuya_alpha_remove_immortal').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onmousehierarchyenter = "[PdxGuiWidget.FindChild('sakuya_alpha_button_center_hover').InterruptThenTriggerAnimation('hide_hover','show_hover')]"
                onmousehierarchyleave = "[PdxGuiWidget.FindChild('sakuya_alpha_button_center_hover').InterruptThenTriggerAnimation('show_hover','hide_hover')]"

                widget = {
                    visible = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                    name = "sakuya_alpha_button_center_hover"
                    size = { 100% 100% }
                    alpha = 0
                    allow_outside = yes

                    state = {
                        name = show_hover
                        duration = 0.15
                        alpha = 1
                        using = Animation_Curve_Default
                    }

                    state = {
                        name = hide_hover
                        duration = 0.15
                        alpha = 0
                        using = Animation_Curve_Default
                    }

                    icon = {
                        size = { 100% 100% }
                        texture = "gfx/interface/sakuya/s/current_situation_button_unread.dds"
                        alwaystransparent = yes
                    }
                    icon = {
                        size = { 170% 170% }
                        parentanchor = center
                        texture = "gfx/interface/sakuya/s/light.png"
                        alwaystransparent = yes
                        color = { 0.6 0.8 1.0 0.25 }
                    }
                    icon = {
                        parentanchor = center
                        size = { 55% 55% }
                        texture = "gfx/interface/icons/character_roles/immortality.dds"
                        alwaystransparent = yes
                    }
                    icon = {
                        parentanchor = center
                        position = { 100 -400 }
                        size = { 1015 430 }
                        texture = "gfx/interface/sakuya/s/talk.png"
                    }
                    text_multi = {
                        parentanchor = center
                        position = { 200 -390 }
                        size = { 100% 100% }
                        margin = { 20 20 }
                        autoresize = yes
                        max_width = 600
                        fontsize = 33
                        align = center|nobaseline
                        text = "Sakuya_god_immortal"
                    }
                }
            }
        }

        widget = { #按钮-左
            parentanchor = center
            size = { 200 200 }
            position = { -350 300 }
            enabled = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" #仅标记角色可见，避免出错和闪退
            icon = {
                size = { 100% 100% }
                texture = "gfx/interface/sakuya/s/current_situation_button_frame.dds"
            }

            button = {
                name = "sakuya_alpha_button_left"
                size = { 100% 100% }
                texture = "gfx/interface/sakuya/s/current_situation_button.dds"
                effectname = "NoHighlight"
                onclick = "[GetVariableSystem.Set('sakuya_god_conqueror','yes')]"
                onclick = "[GetVariableSystem.Clear('sakuya_god_immortal')]"
                onclick = "[GetVariableSystem.Clear('sakuya_god_reaper')]"
                onclick = "[GetVariableSystem.Set('sakuya_god_choice','conqueror')]"
                onclick = "[GetScriptedGui('sakuya_alpha_add_conqueror').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onrightclick = "[GetVariableSystem.Clear('sakuya_god_conqueror')]"
                onrightclick = "[GetVariableSystem.Clear('sakuya_god_choice')]"
                onrightclick = "[GetScriptedGui('sakuya_alpha_remove_conqueror').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onmousehierarchyenter = "[PdxGuiWidget.FindChild('sakuya_alpha_button_left_hover').InterruptThenTriggerAnimation('hide_hover','show_hover')]"
                onmousehierarchyleave = "[PdxGuiWidget.FindChild('sakuya_alpha_button_left_hover').InterruptThenTriggerAnimation('show_hover','hide_hover')]"

                widget = {
                    visible = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                    name = "sakuya_alpha_button_left_hover"
                    size = { 100% 100% }
                    alpha = 0
                    allow_outside = yes

                    state = {
                        name = show_hover
                        duration = 0.15
                        alpha = 1
                        using = Animation_Curve_Default
                    }

                    state = {
                        name = hide_hover
                        duration = 0.15
                        alpha = 0
                        using = Animation_Curve_Default
                    }

                    icon = {
                        size = { 100% 100% }
                        texture = "gfx/interface/sakuya/s/current_situation_button_unread.dds"
                        alwaystransparent = yes
                    }
                    icon = {
                        size = { 170% 170% }
                        parentanchor = center
                        texture = "gfx/interface/sakuya/s/light.png"
                        alwaystransparent = yes
                        color = { 1.0 0.7 0.4 0.28 }
                    }
                    icon = {
                        parentanchor = center
                        size = { 55% 55% }
                        texture = "gfx/interface/icons/control_groups/_default.dds"
                        alwaystransparent = yes
                    }
                    icon = {
                        parentanchor = center
                        position = { 450 -400 }
                        size = { 1015 430 }
                        texture = "gfx/interface/sakuya/s/talk.png"
                    }
                    text_multi = {
                        parentanchor = center
                        position = { 550 -390 }
                        size = { 100% 100% }
                        margin = { 20 20 }
                        autoresize = yes
                        max_width = 600
                        fontsize = 33
                        align = center|nobaseline
                        text = "Sakuya_god_conqueror"
                    }
                }
            }
        }

        widget = { #按钮-右
            parentanchor = center
            size = { 200 200 }
            position = { 350 300 }
            enabled = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" #仅标记角色可见，避免出错和闪退
            icon = {
                size = { 100% 100% }
                texture = "gfx/interface/sakuya/s/current_situation_button_frame.dds"
            }

            button = {
                name = "sakuya_alpha_button_right"
                size = { 100% 100% }
                texture = "gfx/interface/sakuya/s/current_situation_button.dds"
                effectname = "NoHighlight"
                onclick = "[GetVariableSystem.Set('sakuya_god_reaper','yes')]"
                onclick = "[GetVariableSystem.Clear('sakuya_god_immortal')]"
                onclick = "[GetVariableSystem.Clear('sakuya_god_conqueror')]"
                onclick = "[GetVariableSystem.Set('sakuya_god_choice','reaper')]"
                onclick = "[GetScriptedGui('sakuya_alpha_kill_marked').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onrightclick = "[GetVariableSystem.Clear('sakuya_god_reaper')]"
                onrightclick = "[GetVariableSystem.Clear('sakuya_god_choice')]"
                onmousehierarchyenter = "[PdxGuiWidget.FindChild('sakuya_alpha_button_right_hover').InterruptThenTriggerAnimation('hide_hover','show_hover');PdxGuiWidget.FindChild('sakuya_alpha_button_right_light').InterruptThenTriggerAnimation('hide_light','show_light')]"
                onmousehierarchyleave = "[PdxGuiWidget.FindChild('sakuya_alpha_button_right_hover').InterruptThenTriggerAnimation('show_hover','hide_hover');PdxGuiWidget.FindChild('sakuya_alpha_button_right_light').InterruptThenTriggerAnimation('show_light','hide_light')]"

                widget = {
                    visible = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                    name = "sakuya_alpha_button_right_hover"
                    size = { 100% 100% }
                    alpha = 0
                    allow_outside = yes

                    state = {
                        name = show_hover
                        duration = 0.15
                        alpha = 1
                        using = Animation_Curve_Default
                    }

                    state = {
                        name = hide_hover
                        duration = 0.15
                        alpha = 0
                        using = Animation_Curve_Default
                    }

                    icon = {
                        size = { 100% 100% }
                        texture = "gfx/interface/sakuya/s/current_situation_button_unread.dds"
                        alwaystransparent = yes
                    }
                    icon = {
                        size = { 170% 170% }
                        parentanchor = center
                        texture = "gfx/interface/sakuya/s/light.png"
                        alwaystransparent = yes
                        color = { 1 0.5 0.3 0.23 }
                    }
                    icon = {
                        parentanchor = center
                        size = { 50% 50% }
                        texture = "gfx/interface/icons/character_roles/death.dds"
                        alwaystransparent = yes
                    }
                    icon = {
                            parentanchor = center
                            position = { -250 -400 }
                            size = { 1015 430 }
                            texture = "gfx/interface/sakuya/s/talk.png"
                        }
                    text_multi = {
                            parentanchor = center
                            position = { -150 -390 }
                            size = { 100% 100% }
                            margin = { 20 20 }
                            autoresize = yes
                            max_width = 600
                            fontsize = 33
                            align = center|nobaseline
                            text = "Sakuya_god_reaper"
                        }
                }
            }
        }
        widget = { #按钮隐藏块2 #很有创意是不是？
            parentanchor = center
            size = { 90 70 }
            position = { -440 0 }
            visible = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            button = {
                name = "sakuya_alpha_button_test"
                size = { 100% 100% }
                alpha = 0.01
                text = "Sakuya_god_hidden"
                onmousehierarchyenter = "[PdxGuiWidget.FindChild('sakuya_alpha_button_test_hover').InterruptThenTriggerAnimation('hide_hover','show_hover')]"
                onmousehierarchyleave = "[PdxGuiWidget.FindChild('sakuya_alpha_button_test_hover').InterruptThenTriggerAnimation('show_hover','hide_hover')]"

                widget = {
                    visible = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                    name = "sakuya_alpha_button_test_hover"
                    size = { 100% 100% }
                    alpha = 0
                    allow_outside = yes

                    state = {
                        name = show_hover
                        duration = 0.15
                        alpha = 100
                        using = Animation_Curve_Default
                    }

                    state = {
                        name = hide_hover
                        duration = 0.15
                        alpha = 0
                        using = Animation_Curve_Default
                    }

                    icon = {
                        alpha = 100
                        parentanchor = center
                        position = { 540 -100 }
                        size = { 1015 430 }
                        texture = "gfx/interface/sakuya/s/talk.png"
                    }
                    text_multi = {
                        alpha = 100
                        parentanchor = center
                        position = { 640 -90 }
                        size = { 100% 100% }
                        margin = { 20 20 }
                        autoresize = yes
                        max_width = 600
                        fontsize = 33
                        align = center|nobaseline
                        text = "Sakuya_god_hidden_text_2"
                    }
                }
            }
        }

        widget = { #按钮隐藏块1
            parentanchor = center
            size = { 250 40 }
            position = { -550 -105 }
            visible = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            button = {
                name = "sakuya_alpha_button_test"
                size = { 100% 100% }
                alpha = 0.01
                text = "Sakuya_god_hidden"
                onmousehierarchyenter = "[PdxGuiWidget.FindChild('sakuya_alpha_button_test_hover').InterruptThenTriggerAnimation('hide_hover','show_hover')]"
                onmousehierarchyleave = "[PdxGuiWidget.FindChild('sakuya_alpha_button_test_hover').InterruptThenTriggerAnimation('show_hover','hide_hover')]"

                widget = {
                    visible = "[GetScriptedGui('sakuya_check_character_marked').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                    name = "sakuya_alpha_button_test_hover"
                    size = { 100% 100% }
                    alpha = 0
                    allow_outside = yes

                    state = {
                        name = show_hover
                        duration = 0.15
                        alpha = 100
                        using = Animation_Curve_Default
                    }
 
                    state = {
                        name = hide_hover
                        duration = 0.15
                        alpha = 0
                        using = Animation_Curve_Default
                    }

                    icon = {
                        alpha = 100
                        parentanchor = center
                        position = { 650 5 }
                        size = { 1015 430 }
                        texture = "gfx/interface/sakuya/s/talk.png"
                    }
                    text_multi = {
                        alpha = 100
                        parentanchor = center
                        position = { 750 15 }
                        size = { 100% 100% }
                        margin = { 20 20 }
                        autoresize = yes
                        max_width = 600
                        fontsize = 33
                        align = center|nobaseline
                        text = "Sakuya_god_hidden_text"
                    }
                }
            }
        }
    }
}
}

sakuya_alpha_window = {
    datacontext = "[GetPlayer]"
}
