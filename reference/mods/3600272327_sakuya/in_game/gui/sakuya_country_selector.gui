							maximumsize = { 126 34 }
							fontsize = 14
							fontsize_min = 9
							align = center|nobaseline
							elide = right
							text = "SAKUYA_SELECTOR_MODE_EN"
						}
					}
					button_regular = {
						name = "sakuya_country_selector_mode_en_selected"
