window = {
	name = "sakuya_button_window"
	layer = topbar
	parentanchor = right|bottom
	widgetanchor = left|bottom
	position = { -480 0 }
	size = { 50 94 }
	allow_outside = yes
	movable = yes
	datacontext = "[GetPlayer]"
	visible = "[GetPlayer.IsValid]"

	# Transparent drag handle above the round button, following the stable V3 layout.
	widget = {
		parentanchor = top
		size = { 50 42 }
		alpha = 0
		alwaystransparent = no
		tooltip = "SAKUYA_INDEPENDENT_MOVE_TT"
		onmousehierarchyenter = "[GetVariableSystem.Set('sakuya_button_move_hover', 'yes')]"
		onmousehierarchyleave = "[GetVariableSystem.Clear('sakuya_button_move_hover')]"
	}

	widget = {
		parentanchor = top
		position = { 4 0 }
		size = { 42 42 }
		visible = "[GetVariableSystem.Exists('sakuya_button_move_hover')]"
		alwaystransparent = yes
		tooltip = "SAKUYA_INDEPENDENT_MOVE_TT"
		icon = {
			size = { 42 42 }
			texture = "gfx/interface/sakuya/move.dds"
			alpha = 0.85
			alwaystransparent = yes
		}
	}

	button = {
		name = "sakuya_independent_open_button"
		parentanchor = bottom
		size = { 52 52 }
		tooltip = "SAKUYA_OPEN_TT"
		down = "[GetVariableSystem.Exists('sakuya_main_visible')]"

		action_tooltip = {
			click_type = left
			click_mode = single
			click_modifier = default
			title = "SAKUYA_OPEN_TT"
			on_action = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
			on_action = "[GetVariableSystem.Set( 'sakuya_tabs', 'windows' )]"
		}

		block "button_texture" {
			texture = "gfx/interface/buttons/round_button_texture_alt.dds"
			texture_density = 2
		}

		modify_texture = {
			using = color_new_gold_texture
			blend_mode = overlay
			alpha = 1
		}

		modify_texture = {
			using = overlay_stone_texture
			blend_mode = overlay
			alpha = 1
		}

		block "navigational_bg" {
			background = {
				texture = "gfx/interface/buttons/bg_button_light.dds"
				texture_density = 2
				modify_texture = {
					using = color_intense_brown_texture
					blend_mode = add
				}
				modify_texture = {
					using = color_super_dark_brown_texture
					blend_mode = multiply
					alpha = 0.6
				}
			}
		}

		icon = {
			visible = "[Not(GetVariableSystem.Exists('sakuya_main_visible'))]"
			size = { 100% 100% }
			parentanchor = center
			texture = "gfx/interface/sakuya/skybutton_on.dds"
			alpha = 0.72
		}

		icon = {
			visible = "[GetVariableSystem.Exists('sakuya_main_visible')]"
			size = { 100% 100% }
			parentanchor = center
			texture = "gfx/interface/sakuya/skybutton_on.dds"
			using = button_panel_tab_icon_effect
			blockoverride "icon_effect_visible" {
				visible = yes
			}
		}
	}
}
