template sakuya_wallpaper_blur_layer
{
    screen_grab = {
        visible = "[Not(IsScreenGrabWorking)]"
        id = "sakuya_wallpaper_blur"
        texture_ref = "ScreenGrabTexture0"
        constant_buffer_ref = "ScreenGrabConstants0"
        fullscreen = no
        margin = { 0 0 }
        post_effect = Blur
    }

    background = {
        visible = "[IsScreenGrabWorking]"
        texture = "gfx/interface/gui_blur/flat_blur_low.dds"
        shaderfile = "gfx/FX/gui_screen_blur.shader"
        spriteType = CorneredStretched
        spriteborder = { 5 5 }
        margin = { 0 0 }
    }
}

#以咲夜之名 献予诸位
types SakuyaCheatTypes
{
    type sakuya_trait_button_glow = widget {
        size = { 64 64 }

        widget = {
            name = "trait_background"
            size = { 100% 100% }
            block "trait_background" {
                icon = {
                    size = { 100% 100% }
                    texture = "gfx/interface/icons/traits/background/ruler_background.dds"
                    texture_density = 2
                }
            }
        }

        button = {
            size = { 100% 100% }
            effectname = "NoHighlight"

            block "button_content" { }
            block "button_extra" {
                modify_texture = {
                    blend_mode = overlay
                    alpha = 0.5
                }
            }

            onmousehierarchyenter = "[PdxGuiWidget.FindChild('golden_glow_effect').InterruptThenTriggerAnimation('hide_glow','show_glow')]"
            onmousehierarchyleave = "[PdxGuiWidget.FindChild('golden_glow_effect').InterruptThenTriggerAnimation('glow_loop','hide_glow')]"

            widget = {
                name = "golden_glow_effect"
                size = { 130% 130% }
                parentanchor = center
                allow_outside = yes
                alpha = 0

                state = {
                    name = show_glow
                    duration = 0.2
                    alpha = 0.85
                    using = Animation_Curve_Default
                    next = glow_loop
                    modify_texture = {
                        name = "glow_mask"
                        rotate_uv = 90
                    }
                }

                state = {
                    name = glow_loop
                    duration = 1.5
                    alpha = 0.85
                    using = Animation_Curve_Default
                    next = glow_loop
                    modify_texture = {
                        name = "glow_mask"
                        rotate_uv = 450
                    }
                }

                state = {
                    name = hide_glow
                    duration = 0.15
                    alpha = 0
                    using = Animation_Curve_Default
                    modify_texture = {
                        name = "glow_mask"
                        rotate_uv = 0
                    }
                }

                icon = {
                    texture = "gfx/interface/animation/rotate_glow2.dds"
                    size = { 100% 100% }
                    alwaystransparent = yes
                    modify_texture = {
                        name = "glow_mask"
                        texture = "gfx/interface/animation/rotate_glow_mask3.dds"
                        blend_mode = alphamultiply
                    }
                }
            }

            widget = {
                name = "trait_icon_fg"
                size = { 100% 100% }
                block "trait_icon" {
                    icon = {
                        size = { 100% 100% }
                        alpha = 0
                    }
                }
            }
        }
    }
}

window = {
        name = "sakuya_window"
        allow_outside = yes
        alwaystransparent = no
        block "window_position" {
            parentanchor = center
            position = { 0 0 }
        }
        movable = yes
        datacontext = "[GetPlayer]"
        size = { 1200 720 }

        visible = "[GetVariableSystem.Exists('sakuya_main_visible')]"
        enabled = "[GetVariableSystem.Exists('sakuya_main_visible')]"

        widget = {
            size = { 1200 720 }
            using = bg_window_default_alt
            allow_outside = yes
            widget = {
                parentanchor = right
                position = { -5 5 }
                size = { 40 40 }
                ui_direction_button_holder_right = {}
                button_close_alt = {
                    onrightclick = "[ExecuteConsoleCommand('Log.ClearErrorLog')]"
                    blockoverride "close_on_action" {
                        on_action = "[GetVariableSystem.Toggle('sakuya_main_visible')]"
                        #on_action = "[ExecuteConsoleCommand('gui.clearwidgets')]"
                    }
                }
            }

            vbox = {
                using = window_margin_alt
                window_header_alt = {
                    tooltip = "CHEAT_MENU_VERSION"
                    blockoverride "header_text" {
                        text = "CHEAT_MENU_TITLE"
                    }
                }

                header_main_tabs = {
                    blockoverride "content" {
                        button_main_tab_alt = {
                            using = layoutpolicy_expanding
                            text = "CHEAT_MENU_TAB_MAIN"
                            onclick = "[GetVariableSystem.Set( 'sakuya_tabs', 'windows' )]"
                            down = "[GetVariableSystem.HasValue( 'sakuya_tabs', 'windows' )]"
                        }

                        button_main_tab_alt = {
                            using = layoutpolicy_expanding
                            text = "SAKUYA_MENU_TAB_DIPLOMACY"
                            onclick = "[GetVariableSystem.Set( 'sakuya_tabs', 'dip_window' )]"
                            down = "[GetVariableSystem.HasValue( 'sakuya_tabs', 'dip_window' )]"
                        }

                        button_main_tab_alt = {
                            using = layoutpolicy_expanding
                            text = "SAKUYA_MENU_TAB_MILITARY"
                            onclick = "[GetVariableSystem.Set( 'sakuya_tabs', 'mil_window' )]"
                            down = "[GetVariableSystem.HasValue( 'sakuya_tabs', 'mil_window' )]"
                        }

                        button_main_tab_alt = {
                            using = layoutpolicy_expanding
                            text = "SAKUYA_MENU_TAB_CHARACTER"
                            onclick = "[GetScriptedGui('sakuya_refresh_character_mark_cache').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                            onclick = "[GetVariableSystem.Set( 'sakuya_tabs', 'char_window' )]"
                            down = "[GetVariableSystem.HasValue( 'sakuya_tabs', 'char_window' )]"
                        }

                        button_main_tab_alt = { #控制台相关
                            using = layoutpolicy_expanding
                            text = "CHEAT_MENU_TAB_COMMAND_BUTTON_TITLE"
                            onclick = "[GetVariableSystem.Set( 'sakuya_tabs', 'command_set' )]"
                            down = "[GetVariableSystem.HasValue( 'sakuya_tabs', 'command_set' )]"
                        }
                    }
                }

                vbox = {
                    using = layoutpolicy_expanding
                    using = bg_main_inner_alt

                    scrollbox = {
                        using = layoutpolicy_expanding
                        blockoverride "scrollbox_content" {
                            widget = {
                                visible = "[GetVariableSystem.HasValue( 'sakuya_tabs', 'windows' )]"
