template sakuya_16_frames_loop_2
{
    state = { trigger_on_create = yes name = 1 frame = 1 next = 2 duration = 0.125 }
    state = { name = 2 frame = 2 next = 3 duration = 0.125 }
    state = { name = 3 frame = 3 next = 4 duration = 0.125 }
    state = { name = 4 frame = 4 next = 5 duration = 0.125 }
    state = { name = 5 frame = 5 next = 6 duration = 0.125 }
    state = { name = 6 frame = 6 next = 7 duration = 0.125 }
    state = { name = 7 frame = 7 next = 8 duration = 0.125 }
    state = { name = 8 frame = 8 next = 9 duration = 0.125 }
    state = { name = 9 frame = 9 next = 10 duration = 0.125 }
    state = { name = 10 frame = 10 next = 11 duration = 0.125 }
    state = { name = 11 frame = 11 next = 12 duration = 0.125 }
    state = { name = 12 frame = 12 next = 13 duration = 0.125 }
    state = { name = 13 frame = 13 next = 14 duration = 0.125 }
    state = { name = 14 frame = 14 next = 15 duration = 0.125 }
    state = { name = 15 frame = 15 next = 16 duration = 0.125 }
    state = { name = 16 frame = 16 next = 1 duration = 0.125 }
}

